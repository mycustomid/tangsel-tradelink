+import fs from 'node:fs';
+import path from 'node:path';
+import crypto from 'node:crypto';
+import { spawnSync } from 'node:child_process';
+
+const root=process.cwd();
+const destination=path.resolve(root,'../tangsel-tradelink-awwwards-final-rc.zip');
+const stage=path.resolve(root,'../tangsel-tradelink-rc-package');
+if(fs.existsSync(stage) && !process.argv.includes('--refresh')) throw new Error(`Use --refresh to rebuild the known staging directory: ${stage}`);
+fs.mkdirSync(stage,{recursive:true});
+const items=['src','public','tests','.github','.gitignore','.nvmrc','package.json','package-lock.json','astro.config.mjs','serve_local.cjs','apply-patch.sh','apply-patch.ps1','ASSET-SOURCES.md','PATCH-MANIFEST.md','VERIFICATION-REPORT.md','PATCH-INFO.txt','audit_46_status.json','docs/OSINT-SOURCE-LEDGER.md'];
+for(const item of items){fs.mkdirSync(path.dirname(path.join(stage,item)),{recursive:true});fs.cpSync(path.join(root,item),path.join(stage,item),{recursive:true});}
+const scripts=['validate-permalinks.mjs','validate-tenants.mjs','validate-output.mjs','verify-package.mjs','browser-qa.mjs','accessibility-qa.mjs','package-release.mjs','static-server.cjs','download-md-assets.mjs','visual_audit_mobile.cjs','scrape_kenyess_media.cjs','scrape_zyvas_media.cjs'];
+fs.mkdirSync(path.join(stage,'scripts'),{recursive:true});
+for(const file of scripts)fs.copyFileSync(path.join(root,'scripts',file),path.join(stage,'scripts',file));
+fs.mkdirSync(path.join(stage,'reports/browser'),{recursive:true});
+for(const file of ['TENANT-ART-DIRECTION-AUDIT.md','SECURITY-REVIEW.md','CHANGE-PROOF.diff','semgrep.json','npm-audit.json'])fs.copyFileSync(path.join(root,'reports',file),path.join(stage,'reports',file));
+for(const file of ['results.json','accessibility.json','performance-lab.json','lighthouse-home.json'])fs.copyFileSync(path.join(root,'reports/browser',file),path.join(stage,'reports/browser',file));
+const walk=dir=>fs.readdirSync(dir,{withFileTypes:true}).flatMap(e=>e.isDirectory()?walk(path.join(dir,e.name)):[path.join(dir,e.name)]);
+const files=walk(stage).filter(p=>path.basename(p)!=='PATCH-SHA256SUMS.txt').sort();
+const hash=p=>crypto.createHash('sha256').update(fs.readFileSync(p)).digest('hex');
+fs.writeFileSync(path.join(stage,'PATCH-SHA256SUMS.txt'),files.map(p=>`${hash(p)}  ${path.relative(stage,p).replaceAll('\\','/')}`).join('\n')+'\n');
+const verify=spawnSync(process.execPath,[path.join(stage,'scripts/verify-package.mjs'),stage],{stdio:'inherit'});
+if(verify.status!==0)throw new Error('Package verification failed');
+if(process.argv.includes('--stage-only')) { console.log(`Verified staging: ${stage}`); process.exit(0); }
+const py='import pathlib,zipfile,sys\nroot=pathlib.Path(sys.argv[1])\nwith zipfile.ZipFile(sys.argv[2],"w",zipfile.ZIP_DEFLATED,compresslevel=6) as z:\n for p in sorted(root.rglob("*")):\n  if p.is_file(): z.write(p,p.relative_to(root).as_posix())\nwith zipfile.ZipFile(sys.argv[2]) as z:\n assert z.testzip() is None\n print("ZIP integrity OK:",len(z.namelist()),"entries")';
+const zipped=spawnSync(process.env.PYTHON || 'python',['-c',py,stage,destination],{stdio:'inherit'});
+if(zipped.status!==0)throw new Error('ZIP creation failed');
+const sha=hash(destination);
+fs.writeFileSync(destination+'.sha256',`${sha}  ${path.basename(destination)}\n`);
+console.log(destination+'\nSHA256 '+sha);
diff --git a/scripts/static-server.cjs b/scripts/static-server.cjs
new file mode 100644
index 0000000..9f0c4b5
--- /dev/null
+++ b/scripts/static-server.cjs
@@ -0,0 +1,28 @@
+const http = require('node:http');
+const fs = require('node:fs');
+const path = require('node:path');
+const mime = {'.html':'text/html; charset=utf-8','.css':'text/css','.js':'text/javascript','.mjs':'text/javascript','.json':'application/json','.svg':'image/svg+xml','.png':'image/png','.jpg':'image/jpeg','.jpeg':'image/jpeg','.webp':'image/webp','.ico':'image/x-icon','.pdf':'application/pdf','.woff2':'font/woff2'};
+exports.createStaticServer = (directory) => {
+  const root=path.resolve(directory);
+  // nosemgrep: problem-based-packs.insecure-transport.js-node.using-http-server.using-http-server
+  // Local loopback QA server only. Production HTTPS is supplied by GitHub Pages.
+  return http.createServer((req,res) => {
+    let pathname;
+    try { pathname=decodeURIComponent(new URL(req.url,'http://localhost').pathname); }
+    catch { res.writeHead(400);res.end();return; }
+    if(pathname.includes('\0')||pathname.split(/[\\/]/).includes('..')){res.writeHead(400);res.end();return;}
+    if(pathname==='/tangsel-tradelink')pathname='/';
+    else if(pathname.startsWith('/tangsel-tradelink/'))pathname=pathname.slice('/tangsel-tradelink'.length);
+    const relative=pathname.replace(/^[/\\]+/,'');
+    const target=path.resolve(root,relative); // nosemgrep: javascript.lang.security.audit.path-traversal.path-join-resolve-traversal.path-join-resolve-traversal
+    // Enforce the root boundary before any file-system reads, including symlinks.
+    if(!target.startsWith(root+path.sep)&&target!==root){res.writeHead(403);res.end();return;}
+    const candidates=[target,target+'.html',path.join(target,'index.html')];
+    const file=candidates.find(p=>fs.existsSync(p)&&fs.statSync(p).isFile());
+    if(!file){res.writeHead(404);res.end('Not found');return;}
+    const real=fs.realpathSync(file);
+    if(!real.startsWith(fs.realpathSync(root)+path.sep)){res.writeHead(403);res.end();return;}
+    res.writeHead(200,{'Content-Type':mime[path.extname(file)]||'application/octet-stream','X-Content-Type-Options':'nosniff'});
+    fs.createReadStream(real).pipe(res);
+  });
+};
diff --git a/scripts/validate-output.mjs b/scripts/validate-output.mjs
new file mode 100644
index 0000000..4adb2dc
--- /dev/null
+++ b/scripts/validate-output.mjs
@@ -0,0 +1,48 @@
+import fs from 'node:fs';
+import path from 'node:path';
+import crypto from 'node:crypto';
+import assert from 'node:assert/strict';
+import { fileURLToPath } from 'node:url';
+
+const root = fileURLToPath(new URL('../', import.meta.url));
+const baseline = JSON.parse(fs.readFileSync(path.join(root, 'src/data/routes-baseline.lock.json')));
+const lock = JSON.parse(fs.readFileSync(path.join(root, 'src/data/tenant-permalinks.lock.json')));
+const dist = path.join(root, 'dist');
+const origin = 'https://mycustomid.github.io';
+const decode = (value) => value.replace(/&#x([0-9a-f]+);/gi, (_, n) => String.fromCodePoint(parseInt(n,16))).replace(/&#(\d+);/g, (_, n) => String.fromCodePoint(Number(n))).replace(/&amp;/g, '&').replace(/&quot;/g, '"');
+const attrs = (tag) => Object.fromEntries([...tag.matchAll(/([\w:-]+)\s*=\s*"([^"]*)"/g)].map(([, key, value]) => [key, decode(value)]));
+const walk = (dir) => fs.readdirSync(dir, {withFileTypes:true}).flatMap((item) => item.isDirectory() ? walk(path.join(dir,item.name)) : [path.join(dir,item.name)]);
+const pages = walk(dist).filter((file) => file.endsWith('.html'));
+const outputRoutes = pages.map((file) => '/' + path.relative(dist,file).replaceAll('\\','/').replace(/index\.html$/, '')).sort();
+assert.deepEqual(outputRoutes, baseline.routes.map((item) => item.path).sort(), 'Complete baseline route set changed');
+const tenantRoutes = outputRoutes.filter((route) => /^\/tenant\/[^/]+\/$/.test(route)).map((route) => origin + baseline.base.replace(/\/$/,'') + route).sort();
+assert.deepEqual(tenantRoutes, [...lock.urls].sort(), 'Built NFC routes differ from 154 locked URLs');
+let links = 0;
+const failures = [];
+for (const item of baseline.routes) {
+  const file = path.join(dist, item.path, 'index.html');
+  const html = fs.readFileSync(file,'utf8');
+  const tags = [...html.matchAll(/<(?:a|link|img|script)\b[^>]*>/g)].map(([tag]) => ({tag, a:attrs(tag)}));
+  const canonical = tags.find(({a}) => a.rel === 'canonical')?.a.href;
+  const slug = item.path.split('/')[2];
+  const alias = baseline.legacyCanonicalTargets[slug];
+  const expected = origin + baseline.base.replace(/\/$/,'') + (alias ? `/tenant/${alias}/` : item.path);
+  if (canonical !== expected) failures.push(`${item.path}: canonical ${canonical} != ${expected}`);
+  const external = new Set(tags.filter(({tag,a}) => tag.startsWith('<a ') && /^(https?:|mailto:|tel:)/.test(a.href || '')).map(({a}) => a.href));
+  for (const href of item.externalLinks) if (!external.has(href)) failures.push(`${item.path}: published destination removed: ${href}`);
+  for (const {tag,a} of tags) {
+    const href = a.href || a.src;
+    if (!href || /^(data:|mailto:|tel:|javascript:|#)/.test(href)) continue;
+    const url = new URL(href, origin + baseline.base.replace(/\/$/,'') + item.path);
+    if (url.origin !== origin) continue;
+    if (url.pathname === baseline.base.slice(0,-1)) url.pathname += '/';
+    if (!url.pathname.startsWith(baseline.base)) { failures.push(`${item.path}: escaped BASE_URL ${href}`); continue; }
+    const relative = decodeURIComponent(url.pathname.slice(baseline.base.length));
+    const target = path.join(dist, relative);
+    if (![target, target + '.html', path.join(target,'index.html')].some((p) => fs.existsSync(p) && fs.statSync(p).isFile())) failures.push(`${item.path}: missing internal asset/link ${href}`);
+    if (tag.startsWith('<a ')) links++;
+  }
+}
+for (const [file, hash] of Object.entries(baseline.protectedAssets)) assert.equal(crypto.createHash('sha256').update(fs.readFileSync(path.join(root,file))).digest('hex'), hash, `Protected Lalisha asset changed: ${file}`);
+if (failures.length) throw new Error(failures.join('\n'));
+console.log(`Output verified: ${pages.length} pages, ${tenantRoutes.length} NFC routes, ${links} internal links, all published external destinations and ${Object.keys(baseline.protectedAssets).length} Lalisha assets preserved.`);
diff --git a/scripts/verify-package.mjs b/scripts/verify-package.mjs
new file mode 100644
index 0000000..ac0956a
--- /dev/null
+++ b/scripts/verify-package.mjs
@@ -0,0 +1,22 @@
+import fs from 'node:fs';
+import path from 'node:path';
+import crypto from 'node:crypto';
+
+const root = path.resolve(process.argv[2] || '.');
+const manifest = fs.readFileSync(path.join(root,'PATCH-SHA256SUMS.txt'),'utf8');
+let count = 0;
+const expectedFiles = ['PATCH-SHA256SUMS.txt'];
+for (const line of manifest.trim().split(/\r?\n/)) {
+  const match = /^([a-f0-9]{64})  (.+)$/.exec(line);
+  if (!match) throw new Error('Invalid checksum record');
+  const [, expected, relative] = match;
+  expectedFiles.push(relative);
+  const file = path.resolve(root, relative);
+  if (!file.startsWith(root + path.sep)) throw new Error('Unsafe checksum path');
+  const actual = crypto.createHash('sha256').update(fs.readFileSync(file)).digest('hex');
+  if (actual !== expected) throw new Error(`Checksum mismatch: ${relative}`);
+  count++;
+}
+const walk=dir=>fs.readdirSync(dir,{withFileTypes:true}).flatMap(e=>e.isDirectory()?walk(path.join(dir,e.name)):[path.relative(root,path.join(dir,e.name)).replaceAll('\\','/')]);
+if(JSON.stringify(walk(root).sort()) !== JSON.stringify(expectedFiles.sort())) throw new Error('Package has missing or unmanifested files');
+console.log(`Patch integrity OK: ${count} files.`);
