diff --git a/src/lib/discovery.mjs b/src/lib/discovery.mjs
new file mode 100644
index 0000000..ca7b4b8
--- /dev/null
+++ b/src/lib/discovery.mjs
@@ -0,0 +1,19 @@
+export function normalizeSearch(value = '') {
+  return String(value).normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().trim().replace(/\s+/g, ' ');
+}
+
+export function buildDiscoveryProfiles(tenants, research = {}, showcases = {}) {
+  return tenants.map((tenant) => {
+    const evidence = research[tenant.slug] || {};
+    const showcase = showcases[tenant.slug] || {};
+    const description = showcase.tagline || evidence.description || tenant.description || '';
+    const products = (showcase.highlights || []).map((item) => `${item.title || ''} ${item.body || ''}`).join(' ');
+    return { ...tenant, description, searchable: normalizeSearch([tenant.name, tenant.category, `hall ${tenant.hall || ''}`, `booth ${tenant.booth || ''}`, description, evidence.description || '', products].join(' ')) };
+  });
+}
+
+export function matchesDiscovery(profile, { q = '', sector = '', hall = '' } = {}) {
+  return normalizeSearch(q).split(' ').every((word) => profile.searchable.includes(word))
+    && (!sector || normalizeSearch(profile.category) === normalizeSearch(sector))
+    && (!hall || normalizeSearch(profile.hall) === normalizeSearch(hall));
+}
diff --git a/src/styles/accessibility-rc.css b/src/styles/accessibility-rc.css
new file mode 100644
index 0000000..7e4f1c7
--- /dev/null
+++ b/src/styles/accessibility-rc.css
@@ -0,0 +1,27 @@
+/* Keep decorative brand accents; use full-contrast ink for informational text. */
+.smart-nfc .section-label,.smart-nfc .highlight-grid small,.smart-nfc .testimonial-role,.smart-nfc .channel-pending a,.smart-nfc .facts strong{color:var(--nfc-ink)!important}
+.smart-nfc .facts span,.smart-nfc footer,.smart-nfc footer>*{color:var(--nfc-ink)!important;opacity:1!important}
+.smart-nfc .verification{color:var(--nfc-ink)!important}
+.smart-nfc .hero-copy .eyebrow{white-space:normal!important;max-width:100%;overflow-wrap:anywhere;color:inherit!important}
+.smart-nfc[data-layout="poster-stack"] .verification{color:var(--nfc-bg)!important}
+.smart-nfc .commercial-grid>*{min-width:0;overflow-wrap:anywhere}
+.adaptive-tenant .booth-chip span{opacity:.85}
+.premium-onepage .chapter-kicker>span,.premium-onepage .story-aside,.premium-onepage .links .index,.premium-onepage .ledger-head span,.premium-onepage .stats-grid small,.premium-onepage .highlight-grid>article>span{color:var(--ink)!important}
+.premium-onepage .visuals .chapter-kicker>span{color:var(--page)!important}
