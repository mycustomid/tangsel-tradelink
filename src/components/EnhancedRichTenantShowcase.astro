---
import RichTenantShowcase from './RichTenantShowcase.astro';
import { getTenantLinks, getTenantLogo } from '../lib/tenant-utils.mjs';

interface Props {
  tenant: Record<string, any>;
  config: Record<string, any>;
  baseUrl?: string;
}

const { tenant, config, baseUrl = '' } = Astro.props;
const tenantLinks = getTenantLinks(tenant);
const existing = new Set((config.actions || []).map((action: any) => String(action.key || '').toLowerCase()));
const priorityExtras = tenantLinks
  .filter((link: any) => ['whatsapp', 'maps'].includes(link.key) && !existing.has(link.key))
  .map((link: any) => ({ key: link.key, label: link.label, url: link.href }));
const enhancedConfig = { ...config, actions: [...priorityExtras, ...(config.actions || [])] };
const brandLogo = getTenantLogo(tenant);
const safeLogo = brandLogo ? brandLogo.replace(/"/g, '%22') : '';
const logoStyle = safeLogo ? `--tenant-brand-logo:url("${safeLogo}")` : undefined;
---

<div class:list={['enhanced-rich-showcase', brandLogo && 'has-brand-logo']} style={logoStyle}>
  <RichTenantShowcase tenant={tenant} config={enhancedConfig} baseUrl={baseUrl} />
</div>

<style is:global>
  .enhanced-rich-showcase.has-brand-logo .brand-token > span {
    background-color: #fff !important;
    background-image: var(--tenant-brand-logo) !important;
    background-position: center !important;
    background-repeat: no-repeat !important;
    background-size: 72% 72% !important;
    color: transparent !important;
    font-size: 0 !important;
  }

  .enhanced-rich-showcase a[href*="facebook.com"] .brand-icon-wrap > *,
  .enhanced-rich-showcase a[href*="linkedin.com"] .brand-icon-wrap > * {
    display: none !important;
  }

  .enhanced-rich-showcase a[href*="facebook.com"] .brand-icon-wrap {
    background: url("https://cdn.simpleicons.org/facebook/0866FF") center / 23px 23px no-repeat !important;
  }

  .enhanced-rich-showcase a[href*="linkedin.com"] .brand-icon-wrap {
    background: url("https://cdn.simpleicons.org/linkedin/0A66C2") center / 23px 23px no-repeat !important;
  }
</style>