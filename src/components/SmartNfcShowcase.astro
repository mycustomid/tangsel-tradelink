---
import BrandIcon from './BrandIcon.astro';

interface Props {
  tenant: Record<string, any>;
  config: Record<string, any>;
  baseUrl?: string;
}

const { tenant, config, baseUrl = '' } = Astro.props;
const normalizedBase = String(baseUrl).replace(/\/$/, '');
const resolveAsset = (src?: string) =>
  src?.startsWith('/brand/') ? `${normalizedBase}${src}` : src;
const heroImage = resolveAsset(config.heroImage);
const p = config.palette || {};
const vars = `--nfc-bg:${p.bg || '#faf7f2'};--nfc-ink:${p.ink || '#1f1a18'};--nfc-accent:${p.accent || '#9a3412'};--nfc-surface:${p.surface || '#ffffff'};--hero-fit:${config.heroFit || 'cover'}`;
const visualMode = config.visualMode || 'editorial';
const verification = config.verification || {};
const verificationLabel = verification.status === 'public-source-checked' ? 'Public sources checked' : verification.status === 'links-pending' ? 'Profile ready · public links pending' : verification.status === 'handover-verified' ? 'Project handover verified' : 'Primary/client data checked';
const label = config.brandLabel || tenant.name;
const initials = label.split(/\s+/).filter(Boolean).slice(0,2).map((x:string)=>x[0]).join('').toUpperCase();
const actions = Array.isArray(config.actions) ? config.actions : [];
const primaryActions = actions.slice(0,2);
const commercialBlocks = Array.isArray(config.commercialBlocks) ? config.commercialBlocks : [];
const gallery = Array.isArray(config.gallery) ? config.gallery.slice(0,4) : [];
const iconKey = (key = '') => {
  const normalized = String(key).toLowerCase();
  if (normalized.startsWith('email')) return 'email';
  if (normalized.startsWith('whatsapp')) return 'whatsapp';
  if (normalized === 'google-review' || normalized === 'contact-card') return normalized === 'google-review' ? 'maps' : 'catalog';
  return normalized;
};
---

<main class="smart-nfc" style={vars} data-visual-mode={visualMode}>
  <header class="nfc-topbar">
    <a href={baseUrl || '/'} class="directory-link">Tangsel TradeLink</a>
    <span>TEI 2026 · Hall {tenant.hall || '—'}{tenant.booth ? ` · Booth ${tenant.booth}` : ''}</span>
  </header>

  <section class="nfc-hero" aria-labelledby="tenant-title">
    <div class="hero-copy">
      <p class="eyebrow">{config.eyebrow}</p>
      <h1 id="tenant-title">{tenant.name}</h1>
      <p class="tagline">{config.tagline}</p>

      {primaryActions.length > 0 && (
        <div class="hero-actions" aria-label={`${label} primary actions`}>
          {primaryActions.map((action:any, index:number) => (
            <a class:list={['action', index === 0 && 'primary']} href={action.url} target="_blank" rel="noopener noreferrer">
              <BrandIcon name={iconKey(action.key)} />
              <span>{action.label}</span>
              <b aria-hidden="true">↗</b>
            </a>
          ))}
        </div>
      )}

      <div class="verification">
        <span aria-hidden="true">✓</span>
        <p>
          {verificationLabel}
          {verification.checkedAt ? ` · ${verification.checkedAt}` : ''}
        </p>
      </div>
    </div>

    <figure class="hero-visual">
      <div class="visual-fallback" aria-hidden="true">
        <strong>{initials}</strong>
        <span>{label}</span>
      </div>
      {heroImage && (
        <img
          src={heroImage}
          alt={`${label} visual`}
          width="1200"
          height="900"
          loading="eager"
          decoding="async"
          fetchpriority="high"
          onerror="this.style.display='none'"
        />
      )}
    </figure>
  </section>

  <section class="nfc-overview" aria-labelledby="about-title">
    <div class="story">
      <p class="section-label">About</p>
      <h2 id="about-title">{config.story?.title}</h2>
      <p class="story-body">{config.story?.body}</p>
    </div>

    <div class="facts" aria-label={`${label} quick facts`}>
      {(config.stats || []).slice(0,4).map((stat:any) => (
        <article>
          <strong>{stat.value}</strong>
          <span>{stat.label}</span>
        </article>
      ))}
    </div>
  </section>

  {(config.highlights || []).length > 0 && (
    <section class="nfc-section" aria-labelledby="offer-title">
      <div class="section-heading">
        <p class="section-label">In focus</p>
        <h2 id="offer-title">What buyers should know.</h2>
      </div>
      <div class="highlight-grid">
        {(config.highlights || []).slice(0,4).map((item:any, index:number) => (
          <article>
            <small>{String(index + 1).padStart(2,'0')}</small>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </article>
        ))}
      </div>
    </section>
  )}

  {commercialBlocks.length > 0 && (
    <section class="nfc-section commercial" aria-labelledby="commercial-title">
      <div class="section-heading">
        <p class="section-label">Commercial reference</p>
        <h2 id="commercial-title">Pricing & reference points.</h2>
      </div>
      <div class="commercial-grid">
        {commercialBlocks.map((block:any) => (
          <article class="commercial-card">
            <div class="commercial-title">
              <h3>{block.title}</h3>
              {block.badge && <span>{block.badge}</span>}
            </div>
            {block.note && <p class="commercial-note">{block.note}</p>}
            <dl>
              {(block.items || []).map((item:any) => (
                <div>
                  <dt>{item.label}</dt>
                  <dd>{item.value}</dd>
                </div>
              ))}
            </dl>
          </article>
        ))}
      </div>
    </section>
  )}

  {gallery.length > 0 && (
    <section class="nfc-section" aria-labelledby="visual-title">
      <div class="section-heading">
        <p class="section-label">Visuals</p>
        <h2 id="visual-title">Brand & product context.</h2>
      </div>
      <div class="gallery">
        {gallery.map((item:any) => {
          const rawSrc = typeof item === 'string' ? item : (item.image || item.src);
          const rawLabel = typeof item === 'string' ? `${label} Product` : item.label;
          const rawCaption = typeof item === 'string' ? '' : item.caption;
          const image = resolveAsset(rawSrc);
          const figure = (
            <figure>
              {image && <img src={image} alt={rawLabel} width="900" height="700" loading="lazy" decoding="async" fetchpriority="low" onerror="this.style.display='none'" />}
              <figcaption>
                <strong>{rawLabel}</strong>
                {rawCaption && <span>{rawCaption}</span>}
              </figcaption>
            </figure>
          );
          const url = typeof item === 'object' ? item.url : null;
          return url ? <a href={url} target="_blank" rel="noopener noreferrer">{figure}</a> : figure;
        })}
      </div>
    </section>
  )}

  <section class="nfc-connect" aria-labelledby="connect-title">
    <div class="section-heading">
      <p class="section-label">Direct channels</p>
      <h2 id="connect-title">{actions.length > 0 ? 'Connect without another layer.' : 'Contact channel not published yet.'}</h2>
    </div>
    {actions.length > 0 ? (
      <div class="action-grid">
        {actions.map((action:any) => (
          <a href={action.url} target="_blank" rel="noopener noreferrer">
            <BrandIcon name={iconKey(action.key)} />
            <strong>{action.label}</strong>
            <b aria-hidden="true">↗</b>
          </a>
        ))}
      </div>
    ) : (
      <div class="channel-pending">
        <strong>Use the TEI booth / Tangsel TradeLink directory for now.</strong>
        <p>The business profile is ready, but a direct public WhatsApp, website, marketplace or social link has not been verified strongly enough to publish.</p>
        <a href={baseUrl || '/'}>Back to tenant directory →</a>
      </div>
    )}
  </section>

  <footer class="nfc-footer">
    <span>{label}</span>
    <a href={baseUrl || '/'}>Back to TEI 2026 directory</a>
  </footer>

  {primaryActions.length > 0 && (
    <nav class="mobile-quick" aria-label={`${label} quick actions`}>
      {primaryActions.map((action:any, index:number) => (
        <a class:list={[index === 0 && 'primary']} href={action.url} target="_blank" rel="noopener noreferrer">
          <BrandIcon name={iconKey(action.key)} />
          <span>{index === 0 ? 'Contact' : 'Open'}</span>
        </a>
      ))}
    </nav>
  )}
</main>

<style>
  .smart-nfc{background:var(--nfc-bg);color:var(--nfc-ink);min-height:100vh;padding:0 clamp(18px,4vw,54px) 38px}
  .nfc-topbar{max-width:1180px;margin:0 auto;min-height:64px;display:flex;align-items:center;justify-content:space-between;gap:20px;border-bottom:1px solid color-mix(in srgb,var(--nfc-ink) 12%,transparent);font-size:.68rem;letter-spacing:.1em;text-transform:uppercase}
  .directory-link{color:inherit;text-decoration:none;font-weight:900}
  .nfc-hero{max-width:1180px;margin:0 auto;padding:clamp(34px,6vw,76px) 0 clamp(32px,5vw,64px);display:grid;grid-template-columns:minmax(0,1fr) minmax(340px,.82fr);gap:clamp(28px,6vw,80px);align-items:center}
  .eyebrow,.section-label{margin:0;color:var(--nfc-accent);font-size:.68rem;line-height:1.3;font-weight:900;letter-spacing:.12em;text-transform:uppercase}
  h1{margin:18px 0 0;font-family:Georgia,'Times New Roman',serif;font-size:clamp(3.3rem,8vw,7.6rem);font-weight:400;line-height:.82;letter-spacing:-.06em;text-wrap:balance}
  .tagline{max-width:700px;margin:24px 0 0;font-size:clamp(1.05rem,1.8vw,1.35rem);line-height:1.5;color:color-mix(in srgb,var(--nfc-ink) 72%,transparent)}
  .hero-actions{display:flex;flex-wrap:wrap;gap:10px;margin-top:26px}
  .action{min-height:52px;display:flex;align-items:center;gap:10px;padding:12px 16px;border-radius:999px;border:1px solid color-mix(in srgb,var(--nfc-ink) 16%,transparent);color:inherit;text-decoration:none;font-size:.78rem;font-weight:850;background:color-mix(in srgb,var(--nfc-bg) 90%,white)}
  .action.primary{background:var(--nfc-ink);color:var(--nfc-bg);border-color:var(--nfc-ink)}
  .action b{margin-left:auto}
  .verification{display:flex;align-items:center;gap:8px;margin-top:18px;color:color-mix(in srgb,var(--nfc-ink) 55%,transparent);font-size:.7rem}
  .verification>span{width:24px;height:24px;display:grid;place-items:center;border-radius:50%;background:color-mix(in srgb,var(--nfc-accent) 13%,transparent);color:var(--nfc-accent);font-weight:900}
  .verification p{margin:0}
  .hero-visual{position:relative;margin:0;aspect-ratio:4/3;overflow:hidden;border-radius:32px;background:var(--nfc-surface);border:1px solid color-mix(in srgb,var(--nfc-ink) 10%,transparent)}
  .hero-visual img{position:absolute;z-index:2;inset:0;width:100%;height:100%;object-fit:var(--hero-fit)}
  .visual-fallback{position:absolute;inset:0;padding:28px;display:flex;flex-direction:column;justify-content:space-between;background:linear-gradient(145deg,color-mix(in srgb,var(--nfc-accent) 25%,var(--nfc-bg)),var(--nfc-surface));color:var(--nfc-ink)}
  .visual-fallback strong{font-family:Georgia,serif;font-size:clamp(4rem,9vw,8rem);font-weight:400;line-height:.8}
  .visual-fallback span{max-width:260px;font-size:.7rem;font-weight:900;letter-spacing:.12em;text-transform:uppercase}
  .nfc-overview,.nfc-section,.nfc-connect{max-width:1180px;margin:0 auto;padding:clamp(34px,5vw,58px) 0;border-top:1px solid color-mix(in srgb,var(--nfc-ink) 12%,transparent)}
  .nfc-overview{display:grid;grid-template-columns:1.08fr .92fr;gap:clamp(30px,6vw,72px);align-items:start}
  .story h2,.section-heading h2{margin:12px 0 0;font-family:Georgia,'Times New Roman',serif;font-size:clamp(2rem,4.4vw,4.4rem);font-weight:400;line-height:.95;letter-spacing:-.04em;text-wrap:balance}
  .story-body{max-width:720px;margin:22px 0 0;font-size:1rem;line-height:1.72;color:color-mix(in srgb,var(--nfc-ink) 74%,transparent)}
  .facts{display:grid;grid-template-columns:1fr 1fr;border-top:1px solid color-mix(in srgb,var(--nfc-ink) 12%,transparent)}
  .facts article{min-height:132px;padding:18px 14px;border-bottom:1px solid color-mix(in srgb,var(--nfc-ink) 12%,transparent)}
  .facts article:nth-child(odd){border-right:1px solid color-mix(in srgb,var(--nfc-ink) 12%,transparent)}
  .facts strong{display:block;font-family:Georgia,serif;font-size:clamp(1.7rem,3vw,2.8rem);font-weight:400;color:var(--nfc-accent)}
  .facts span{display:block;margin-top:8px;font-size:.72rem;line-height:1.35;color:color-mix(in srgb,var(--nfc-ink) 62%,transparent)}
  .section-heading{display:flex;justify-content:space-between;align-items:end;gap:28px;margin-bottom:28px}
  .section-heading h2{max-width:780px}
  .highlight-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}
  .highlight-grid article{min-height:210px;padding:22px;border:1px solid color-mix(in srgb,var(--nfc-ink) 11%,transparent);border-radius:22px;background:color-mix(in srgb,var(--nfc-bg) 92%,white);display:flex;flex-direction:column}
  .highlight-grid small{color:var(--nfc-accent);font-weight:900}
  .highlight-grid h3{margin:auto 0 10px;font-family:Georgia,serif;font-size:clamp(1.4rem,2.4vw,2.25rem);font-weight:400;line-height:1}
  .highlight-grid p{margin:0;font-size:.82rem;line-height:1.55;color:color-mix(in srgb,var(--nfc-ink) 65%,transparent)}
  .commercial-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:14px}
  .commercial-card{padding:24px;border-radius:24px;background:var(--nfc-ink);color:var(--nfc-bg)}
  .commercial-title{display:flex;align-items:start;justify-content:space-between;gap:16px}
  .commercial-title h3{margin:0;font-family:Georgia,serif;font-size:1.65rem;font-weight:400}
  .commercial-title span{padding:6px 8px;border:1px solid color-mix(in srgb,var(--nfc-bg) 24%,transparent);border-radius:999px;font-size:.6rem;text-transform:uppercase;letter-spacing:.08em}
  .commercial-note{margin:12px 0 18px;font-size:.74rem;line-height:1.5;opacity:.66}
  dl{margin:0}
  dl div{display:flex;justify-content:space-between;gap:18px;padding:11px 0;border-top:1px solid color-mix(in srgb,var(--nfc-bg) 15%,transparent)}
  dt{font-size:.75rem;opacity:.72}
  dd{margin:0;font-size:.78rem;font-weight:900;text-align:right}
  .gallery{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}
  .gallery>a{color:inherit;text-decoration:none}
  .gallery figure{position:relative;margin:0;min-height:300px;overflow:hidden;border-radius:22px;background:var(--nfc-surface)}
  .gallery img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
  .gallery figcaption{position:absolute;z-index:2;left:18px;right:18px;bottom:18px;padding:14px;border-radius:16px;background:color-mix(in srgb,var(--nfc-bg) 88%,transparent);backdrop-filter:blur(10px);display:flex;flex-direction:column;gap:4px}
  .gallery figcaption strong{font-family:Georgia,serif;font-size:1.2rem}
  .gallery figcaption span{font-size:.7rem;line-height:1.35}
  .action-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:10px}
  .channel-pending{max-width:760px;padding:22px;border:1px dashed color-mix(in srgb,var(--nfc-ink) 22%,transparent);border-radius:18px;background:color-mix(in srgb,var(--nfc-bg) 92%,white)}
  .channel-pending strong{display:block;font-family:Georgia,serif;font-size:clamp(1.2rem,2vw,1.7rem);font-weight:400}
  .channel-pending p{margin:10px 0 14px;color:color-mix(in srgb,var(--nfc-ink) 65%,transparent);font-size:.82rem;line-height:1.55}
  .channel-pending a{font-size:.76rem;font-weight:900;color:var(--nfc-accent);text-decoration:none}
  .action-grid a{min-height:58px;display:grid;grid-template-columns:28px 1fr auto;align-items:center;gap:12px;padding:13px 15px;border:1px solid color-mix(in srgb,var(--nfc-ink) 14%,transparent);border-radius:16px;color:inherit;text-decoration:none;background:color-mix(in srgb,var(--nfc-bg) 94%,white)}
  .action-grid strong{font-size:.82rem}
  .nfc-footer{max-width:1180px;margin:20px auto 0;display:flex;justify-content:space-between;gap:18px;color:color-mix(in srgb,var(--nfc-ink) 55%,transparent);font-size:.68rem}
  .nfc-footer a{color:inherit;text-decoration:none;font-weight:800}
  .mobile-quick{display:none}
  a:focus-visible{outline:3px solid var(--nfc-accent);outline-offset:3px}


  /* Batch art-direction modes: same accessible NFC system, distinct editorial character. */
  .smart-nfc[data-visual-mode="fashion"] .hero-visual{border-radius:48% 48% 28px 28px/24% 24% 28px 28px}
  .smart-nfc[data-visual-mode="fashion"] h1{font-style:italic}
  .smart-nfc[data-visual-mode="food"] .hero-visual{border-radius:42px}
  .smart-nfc[data-visual-mode="food"] .highlight-grid article:nth-child(odd){border-radius:70px 20px 20px}
  .smart-nfc[data-visual-mode="craft"] .hero-visual{border-radius:24px 110px 24px 24px}
  .smart-nfc[data-visual-mode="craft"] .highlight-grid article{border-radius:18px 62px 18px 18px}
  .smart-nfc[data-visual-mode="beauty"] .hero-visual{border-radius:999px 999px 34px 34px}
  .smart-nfc[data-visual-mode="beauty"] .facts article{background:color-mix(in srgb,var(--nfc-bg) 84%,white)}
  .smart-nfc[data-visual-mode="beverage"] .hero-visual{border-radius:50% 50% 28px 28px/18% 18% 28px 28px}
  .smart-nfc[data-visual-mode="industrial"] .hero-visual{border-radius:3px}
  .smart-nfc[data-visual-mode="industrial"] .highlight-grid article,.smart-nfc[data-visual-mode="industrial"] .action-grid a{border-radius:3px}
  .smart-nfc[data-visual-mode="tech"] .hero-visual{border-radius:0;clip-path:polygon(0 0,calc(100% - 36px) 0,100% 36px,100% 100%,0 100%)}
  .smart-nfc[data-visual-mode="tech"] .highlight-grid article{border-radius:0}

  @media(max-width:820px){
    .nfc-hero,.nfc-overview{grid-template-columns:1fr}
    .nfc-hero{padding-top:30px}
    .hero-visual{order:-1;aspect-ratio:16/11;border-radius:24px}
    h1{font-size:clamp(3.1rem,16vw,5.2rem)}
    .section-heading{align-items:start;flex-direction:column}
  }
  @media(max-width:620px){
    .smart-nfc{padding-left:16px;padding-right:16px;padding-bottom:96px}
    .nfc-topbar{min-height:56px;font-size:.58rem}
    .nfc-topbar span{max-width:160px;text-align:right}
    .hero-actions{display:none}
    .hero-visual{aspect-ratio:4/3}
    .facts,.highlight-grid,.commercial-grid,.gallery,.action-grid{grid-template-columns:1fr}
    .facts article:nth-child(odd){border-right:0}
    .highlight-grid article{min-height:180px}
    .commercial-card{border-radius:20px}
    .action-grid a{min-height:56px}
    .nfc-footer{flex-direction:column}
    .mobile-quick{position:fixed;z-index:80;left:12px;right:12px;bottom:max(12px,env(safe-area-inset-bottom));display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;padding:8px;border:1px solid color-mix(in srgb,var(--nfc-ink) 14%,transparent);border-radius:18px;background:color-mix(in srgb,var(--nfc-bg) 92%,transparent);backdrop-filter:blur(16px);box-shadow:0 16px 44px rgba(0,0,0,.16)}
    .mobile-quick a{min-height:52px;display:flex;align-items:center;justify-content:center;gap:8px;border-radius:12px;color:var(--nfc-ink);text-decoration:none;font-size:.76rem;font-weight:900}
    .mobile-quick a.primary{background:var(--nfc-ink);color:var(--nfc-bg)}
  }
  @media(prefers-reduced-motion:reduce){*{scroll-behavior:auto!important}}
</style>
