---
import BrandIcon from './BrandIcon.astro';

interface Props {
  tenant: Record<string, any>;
  config: Record<string, any>;
  baseUrl?: string;
}

const { tenant, config, baseUrl = '' } = Astro.props;
const normalizedBase = String(baseUrl).replace(/\/$/, '');
const resolveAsset = (src?: string) =>
  src?.startsWith('/brand/') ? `${normalizedBase}${src}` : src;
const resolveLink = (url?: string) =>
  url?.startsWith('/') && !url.startsWith('//') ? `${normalizedBase}${url}` : url;
const heroImage = resolveAsset(config.heroImage);
const heroFit = config.heroFit || 'cover';
const heroAspect = config.heroAspectRatio || (config.heroPortrait ? '3/4' : '16/11');
const heroAspectMobile = config.heroAspectRatioMobile || (config.heroPortrait ? '9/16' : (config.heroAspectRatio || '4/3'));
const galleryAspect = config.galleryAspectRatio || (config.galleryPortrait ? '3/4' : '4/3');
const galleryFit = config.galleryFit || 'cover';
const p = config.palette || {};
const vars = `--nfc-bg:${p.bg || '#faf7f2'};--nfc-ink:${p.ink || '#1f1a18'};--nfc-accent:${p.accent || '#9a3412'};--nfc-surface:${p.surface || '#ffffff'};--hero-fit:${heroFit};--hero-aspect:${heroAspect};--hero-aspect-mobile:${heroAspectMobile};--gallery-aspect:${galleryAspect};--gallery-fit:${galleryFit}`;
const visualMode = config.visualMode || 'editorial';
const verification = config.verification || {};
const verificationLabel = verification.status === 'public-source-checked' ? 'Public sources checked' : verification.status === 'links-pending' ? 'Profile ready · public links pending' : verification.status === 'handover-verified' ? 'Project handover verified' : 'Primary/client data checked';
const label = config.brandLabel || tenant.name;
const initials = label.split(/\s+/).filter(Boolean).slice(0,2).map((x:string)=>x[0]).join('').toUpperCase();
const actions = Array.isArray(config.actions) ? config.actions : [];
const primaryActions = actions.slice(0,2);
const commercialBlocks = Array.isArray(config.commercialBlocks) ? config.commercialBlocks : [];
const gallery = Array.isArray(config.gallery) ? config.gallery.slice(0, 6) : [];
const testimonials = Array.isArray(config.testimonials) ? config.testimonials : [];
const iconKey = (key = '') => {
  const normalized = String(key).toLowerCase();
  if (normalized.startsWith('email')) return 'email';
  if (normalized.startsWith('whatsapp')) return 'whatsapp';
  if (normalized === 'google-review' || normalized === 'contact-card') return normalized === 'google-review' ? 'maps' : 'catalog';
  return normalized;
};
const quickLabel = (action: any, index: number) => {
  const k = iconKey(action.key);
  if (k === 'whatsapp') return 'WhatsApp';
  if (k === 'zalo') return 'Zalo';
  if (k === 'catalog') return 'Katalog';
  if (k === 'maps') return 'Lokasi';
  if (k === 'website') return 'Website';
  if (k === 'email') return 'Email';
  return index === 0 ? 'Hubungi' : 'Buka';
};
---

<main class="smart-nfc" style={vars} data-visual-mode={visualMode}>
  <header class="nfc-topbar">
    <a href={baseUrl || '/'} class="directory-link">Tangsel TradeLink</a>
    <span>TEI 2026 · Hall {tenant.hall || '—'}{tenant.booth ? ` · Booth ${tenant.booth}` : ''}</span>
  </header>

  <section class="nfc-hero" aria-labelledby="tenant-title">
    <div class="hero-copy">
      <p class="eyebrow">{config.eyebrow}</p>
      {config.titleAsLogo ? (
        <h1 id="tenant-title" class="brand-title-logo-heading">
          <img
            src={resolveAsset(config.titleLogo || config.logo)}
            alt={tenant.name}
            class="brand-title-logo-img"
            width="340"
            height="99"
            loading="eager"
            decoding="async"
          />
          <span class="sr-only">{tenant.name}</span>
        </h1>
      ) : (
        <h1 id="tenant-title">{tenant.name}</h1>
      )}
      <p class="tagline">{config.tagline}</p>

      {primaryActions.length > 0 && (
        <div class="hero-actions" aria-label={`${label} primary actions`}>
          {primaryActions.map((action:any, index:number) => (
            <a class:list={['action', index === 0 && 'primary']} href={resolveLink(action.url)} target="_blank" rel="noopener noreferrer">
              <BrandIcon name={iconKey(action.key)} />
              <span>{action.label}</span>
              <b aria-hidden="true">↗</b>
            </a>
          ))}
        </div>
      )}

      <div class="verification">
        <span aria-hidden="true">✓</span>
        <p>
          {verificationLabel}
          {verification.checkedAt ? ` · ${verification.checkedAt}` : ''}
        </p>
      </div>
    </div>

    <figure class="hero-visual">
      {!heroImage && (
        <div class="visual-fallback" aria-hidden="true">
          <strong>{initials}</strong>
          <span>{label}</span>
        </div>
      )}
      {heroImage && (
        <>
          {heroFit === 'contain' && (
            <img
              src={heroImage}
              alt=""
              aria-hidden="true"
              class="hero-blur-backdrop"
              loading="eager"
              decoding="async"
            />
          )}
          <img
            src={heroImage}
            alt={`${label} visual`}
            class="hero-main-img"
            width="1200"
            height="900"
            loading="eager"
            decoding="async"
            fetchpriority="high"
            onerror="this.style.display='none'"
          />
        </>
      )}
    </figure>
  </section>

  <section class:list={['nfc-overview', (!config.hideStats && (config.stats || []).length > 0) ? '' : 'no-facts']} aria-labelledby="about-title">
    <div class="story">
      <p class="section-label">About</p>
      <h2 id="about-title">{config.story?.title}</h2>
      <p class="story-body">{config.story?.body}</p>
    </div>

    {!config.hideStats && (config.stats || []).length > 0 && (
      <div class="facts" aria-label={`${label} quick facts`}>
        {(config.stats || []).slice(0,4).map((stat:any) => (
          <article>
            <strong>{stat.value}</strong>
            <span>{stat.label}</span>
          </article>
        ))}
      </div>
    )}
  </section>

  {!config.hideHighlights && (config.highlights || []).length > 0 && (
    <section class="nfc-section" aria-labelledby="offer-title">
      <div class="section-heading">
        <p class="section-label">In focus</p>
        <h2 id="offer-title">What buyers should know.</h2>
      </div>
      <div class="highlight-grid">
        {(config.highlights || []).slice(0,4).map((item:any, index:number) => (
          <article>
            <small>{String(index + 1).padStart(2,'0')}</small>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </article>
        ))}
      </div>
    </section>
  )}

  {(config.pricelistImage || (!config.hideCommercialBlocks && commercialBlocks.length > 0)) && (
    <section class="nfc-section commercial" aria-labelledby="commercial-title">
      <div class="section-heading">
        <p class="section-label">{config.pricelistLabel || 'Commercial reference'}</p>
        <h2 id="commercial-title">{config.pricelistTitle || 'Pricing & reference points.'}</h2>
      </div>
      {config.pricelistImage && (
        <figure class="pricelist-showcase-wrap">
          <button
            type="button"
            class="pricelist-lightbox-trigger js-lightbox-trigger"
            aria-haspopup="dialog"
            aria-label={`Buka gambar katalog ${label} ukuran penuh`}
            data-full-img={resolveAsset(config.pricelistImage)}
            data-caption={`${label} — ${config.pricelistTitle || 'Katalog & Daftar Harga'}`}
          >
            <img
              src={resolveAsset(config.pricelistImage)}
              alt={`${label} Official Pricelist`}
              width="926"
              height="1600"
              loading="eager"
              decoding="async"
              class="pricelist-full-img"
            />
            <span class="pricelist-zoom-hint" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line><line x1="11" y1="8" x2="11" y2="14"></line><line x1="8" y1="11" x2="14" y2="11"></line></svg>
              <span>Klik untuk perbesar</span>
            </span>
          </button>
        </figure>
      )}
      {!config.hideCommercialBlocks && commercialBlocks.length > 0 && (
        <div class="commercial-grid">
          {commercialBlocks.map((block:any) => (
            <article class="commercial-card">
              <div class="commercial-title">
                <h3>{block.title}</h3>
                {block.badge && <span>{block.badge}</span>}
              </div>
              {block.note && <p class="commercial-note">{block.note}</p>}
              <dl>
                {(block.items || []).map((item:any) => (
                  <div>
                    <dt>{item.label}</dt>
                    <dd>{item.value}</dd>
                  </div>
                ))}
              </dl>
            </article>
          ))}
        </div>
      )}
    </section>
  )}

  {gallery.length > 0 && (
    <section class="nfc-section" aria-labelledby="visual-title">
      <div class="section-heading">
        <p class="section-label">Visuals</p>
        <h2 id="visual-title">Brand & product context.</h2>
      </div>
      <div class="gallery">
        {gallery.map((item:any) => {
          const rawSrc = typeof item === 'string' ? item : (item.image || item.src);
          const rawLabel = typeof item === 'string' ? `${label} Product` : item.label;
          const rawCaption = typeof item === 'string' ? '' : item.caption;
          const image = resolveAsset(rawSrc);
          const isContain = item.fit === 'contain';
          const rawUrl = typeof item === 'object' ? item.url : null;
          const isExternal = rawUrl && (rawUrl.startsWith('http://') || rawUrl.startsWith('https://'));
          const url = rawUrl ? resolveAsset(rawUrl) : null;
          const captionText = rawCaption ? `${rawLabel} — ${rawCaption}` : rawLabel;

          const figure = (
            <figure
              class:list={['gallery-card', !isExternal && image && 'js-lightbox-trigger']}
              data-full-img={!isExternal && image ? image : undefined}
              data-caption={!isExternal && image ? captionText : undefined}
              style={!isExternal && image ? 'cursor:zoom-in' : undefined}
            >
              <div class="gallery-img-wrap" style={item.aspectRatio ? `aspect-ratio:${item.aspectRatio}` : undefined}>
                {image && (
                  <>
                    {isContain && (
                      <img
                        src={image}
                        alt=""
                        aria-hidden="true"
                        class="gallery-blur-backdrop"
                        loading="lazy"
                        decoding="async"
                      />
                    )}
                    <img
                      src={image}
                      alt={rawLabel}
                      width="900"
                      height="700"
                      loading="lazy"
                      decoding="async"
                      fetchpriority="low"
                      class:list={[isContain && 'gallery-contain-img']}
                      style={isContain ? 'object-fit:contain;padding:6px;background:color-mix(in srgb,var(--nfc-ink) 2%,white)' : undefined}
                      onerror="this.style.display='none'"
                    />
                  </>
                )}
              </div>
              <figcaption>
                <strong>{rawLabel}</strong>
                {rawCaption && <span>{rawCaption}</span>}
              </figcaption>
            </figure>
          );

          return isExternal && url ? (
            <a href={url} target="_blank" rel="noopener noreferrer">
              {figure}
            </a>
          ) : (
            figure
          );
        })}
      </div>
    </section>
  )}

  {testimonials.length > 0 && (
    <section class="nfc-section" aria-labelledby="testimonial-title">
      <div class="section-heading">
        <p class="section-label">Buyer Trust</p>
        <h2 id="testimonial-title">Live encounters & delegation trust.</h2>
      </div>
      <div class="testimonial-grid">
        {testimonials.map((item:any) => {
          const rawSrc = typeof item === 'string' ? item : (item.image || item.src);
          const rawTitle = typeof item === 'string' ? `${label} Engagement` : (item.title || item.label);
          const rawQuote = typeof item === 'string' ? '' : item.quote;
          const rawRole = typeof item === 'string' ? '' : item.role;
          const rawCaption = typeof item === 'string' ? '' : item.caption;
          const image = resolveAsset(rawSrc);
          return (
            <figure class="testimonial-card">
              <div class="testimonial-img-wrap">
                {image && (
                  <img
                    src={image}
                    alt={rawTitle}
                    width="900"
                    height="1200"
                    loading="lazy"
                    decoding="async"
                    fetchpriority="low"
                    onerror="this.style.display='none'"
                  />
                )}
              </div>
              <figcaption>
                {rawRole && <span class="testimonial-role">{rawRole}</span>}
                <strong>{rawTitle}</strong>
                {rawQuote && <blockquote class="testimonial-quote">“{rawQuote}”</blockquote>}
                {rawCaption && <p class="testimonial-caption">{rawCaption}</p>}
              </figcaption>
            </figure>
          );
        })}
      </div>
    </section>
  )}

  <section class="nfc-connect" aria-labelledby="connect-title">
    <div class="section-heading">
      <p class="section-label">Direct channels</p>
      <h2 id="connect-title">{actions.length > 0 ? 'Connect without another layer.' : 'Contact channel not published yet.'}</h2>
    </div>
    {actions.length > 0 ? (
      <div class="action-grid">
        {actions.map((action:any) => (
          <a href={resolveLink(action.url)} target="_blank" rel="noopener noreferrer">
            <BrandIcon name={iconKey(action.key)} />
            <strong>{action.label}</strong>
            <b aria-hidden="true">↗</b>
          </a>
        ))}
      </div>
    ) : (
      <div class="channel-pending">
        <strong>Use the TEI booth / Tangsel TradeLink directory for now.</strong>
        <p>The business profile is ready, but a direct public WhatsApp, website, marketplace or social link has not been verified strongly enough to publish.</p>
        <a href={baseUrl || '/'}>Back to tenant directory →</a>
      </div>
    )}
  </section>

  <footer class="nfc-footer">
    <span>{label}</span>
    <a href={baseUrl || '/'}>Back to TEI 2026 directory</a>
  </footer>

  {primaryActions.length > 0 && (
    <nav class="mobile-quick" aria-label={`${label} quick actions`}>
      {primaryActions.map((action:any, index:number) => (
        <a class:list={[index === 0 && 'primary']} href={resolveLink(action.url)} target="_blank" rel="noopener noreferrer">
          <BrandIcon name={iconKey(action.key)} />
          <span>{quickLabel(action, index)}</span>
        </a>
      ))}
    </nav>
  )}

  <dialog id="nfc-lightbox-modal" class="nfc-lightbox-dialog" aria-modal="true" aria-label="Tampilan Penuh Gambar">
    <div class="lightbox-dialog-inner">
      <button type="button" class="lightbox-close-btn" id="lightbox-close-btn" aria-label="Tutup tampilan penuh">
        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
      </button>
      <div class="lightbox-img-scroll">
        <img id="lightbox-main-img" src="" alt="Tampilan penuh gambar katalog" loading="lazy" />
      </div>
      <p id="lightbox-caption" class="lightbox-caption-text"></p>
    </div>
  </dialog>
</main>

<script>
  function initLightbox() {
    const dialog = document.getElementById('nfc-lightbox-modal') as HTMLDialogElement | null;
    if (!dialog) return;
    const img = document.getElementById('lightbox-main-img') as HTMLImageElement | null;
    const caption = document.getElementById('lightbox-caption');
    const closeBtn = document.getElementById('lightbox-close-btn');

    document.querySelectorAll('.js-lightbox-trigger').forEach((trigger) => {
      trigger.addEventListener('click', (e) => {
        e.preventDefault();
        const fullSrc = trigger.getAttribute('data-full-img');
        const capText = trigger.getAttribute('data-caption') || '';
        if (img && fullSrc) img.src = fullSrc;
        if (caption) caption.textContent = capText;
        if (typeof dialog.showModal === 'function') {
          dialog.showModal();
        } else {
          dialog.setAttribute('open', '');
        }
      });
    });

    closeBtn?.addEventListener('click', () => {
      if (typeof dialog.close === 'function') dialog.close();
      else dialog.removeAttribute('open');
    });

    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) {
        if (typeof dialog.close === 'function') dialog.close();
        else dialog.removeAttribute('open');
      }
    });
  }

  if (typeof document !== 'undefined') {
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initLightbox);
    } else {
      initLightbox();
    }
    document.addEventListener('astro:page-load', initLightbox);
  }
</script>

<style>
  @starting-style {
    .nfc-hero { opacity: 0; transform: translateY(12px); }
    .hero-visual { opacity: 0; transform: scale(0.98); }
    .mobile-quick { transform: translateY(100%); }
  }
  .smart-nfc{background:var(--nfc-bg);color:var(--nfc-ink);min-height:100vh;padding:0 clamp(18px,4vw,54px) 38px}
  .nfc-topbar{max-width:1180px;margin:0 auto;min-height:64px;display:flex;align-items:center;justify-content:space-between;gap:20px;border-bottom:1px solid color-mix(in srgb,var(--nfc-ink) 12%,transparent);font-size:.68rem;letter-spacing:.1em;text-transform:uppercase}
  .directory-link{color:inherit;text-decoration:none;font-weight:900}
  .nfc-hero{max-width:1180px;margin:0 auto;padding:clamp(34px,6vw,76px) 0 clamp(32px,5vw,64px);display:grid;grid-template-columns:minmax(0,1fr) minmax(340px,.82fr);gap:clamp(28px,6vw,80px);align-items:center;transition:opacity .5s cubic-bezier(0.16,1,0.3,1),transform .5s cubic-bezier(0.16,1,0.3,1)}
  .eyebrow,.section-label{margin:0;color:var(--nfc-accent);font-size:.68rem;line-height:1.3;font-weight:900;letter-spacing:.12em;text-transform:uppercase}
  h1{margin:18px 0 0;font-family:Georgia,'Times New Roman',serif;font-size:clamp(3.3rem,8vw,7.6rem);font-weight:400;line-height:.82;letter-spacing:-.06em;text-wrap:balance;overflow-wrap:break-word;word-break:break-word}
  .brand-title-logo-heading{margin:18px 0 0;display:flex;align-items:center}
  .brand-title-logo-img{max-height:clamp(4.2rem,8vw,6rem);width:auto;max-width:min(100%,420px);object-fit:contain;display:block}
  .sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
  .tagline{max-width:700px;margin:24px 0 0;font-size:clamp(1.05rem,1.8vw,1.35rem);line-height:1.5;color:color-mix(in srgb,var(--nfc-ink) 72%,transparent)}
  .hero-actions{display:flex;flex-wrap:wrap;gap:10px;margin-top:26px}
  .action{min-height:52px;display:flex;align-items:center;gap:10px;padding:12px 16px;border-radius:999px;border:1px solid color-mix(in srgb,var(--nfc-ink) 16%,transparent);color:inherit;text-decoration:none;font-size:.78rem;font-weight:850;background:color-mix(in srgb,var(--nfc-bg) 90%,white);transition:transform .12s cubic-bezier(0.2,0,0,1)}
  .action:active{transform:scale(0.97)}
  .action.primary{background:var(--nfc-ink);color:var(--nfc-bg);border-color:var(--nfc-ink)}
  .action b{margin-left:auto}
  .verification{display:flex;align-items:center;gap:8px;margin-top:18px;color:color-mix(in srgb,var(--nfc-ink) 55%,transparent);font-size:.7rem}
  .verification>span{width:24px;height:24px;display:grid;place-items:center;border-radius:50%;background:color-mix(in srgb,var(--nfc-accent) 13%,transparent);color:var(--nfc-accent);font-weight:900}
  .verification p{margin:0}
  .hero-visual{position:relative;margin:0;aspect-ratio:var(--hero-aspect,16/11);overflow:hidden;border-radius:24px;background:color-mix(in srgb,var(--nfc-surface) 60%,var(--nfc-bg));border:1px solid color-mix(in srgb,var(--nfc-ink) 12%,transparent);box-shadow:0 16px 38px -12px color-mix(in srgb,var(--nfc-ink) 12%,transparent);display:flex;align-items:center;justify-content:center;transition:opacity .6s cubic-bezier(0.16,1,0.3,1),transform .6s cubic-bezier(0.16,1,0.3,1)}
  .hero-visual img.hero-blur-backdrop{position:absolute;inset:-20px;width:calc(100% + 40px);height:calc(100% + 40px);object-fit:cover;object-position:center;filter:blur(24px) saturate(1.2);opacity:.45;z-index:1;pointer-events:none}
  .hero-visual img{position:absolute;z-index:2;inset:0;width:100%;height:100%;object-fit:var(--hero-fit,cover);object-position:center}
  .visual-fallback{position:absolute;inset:0;padding:28px;display:flex;flex-direction:column;justify-content:space-between;background:linear-gradient(145deg,color-mix(in srgb,var(--nfc-accent) 25%,var(--nfc-bg)),var(--nfc-surface));color:var(--nfc-ink)}
  .visual-fallback strong{font-family:Georgia,serif;font-size:clamp(4rem,9vw,8rem);font-weight:400;line-height:.8}
  .visual-fallback span{max-width:260px;font-size:.7rem;font-weight:900;letter-spacing:.12em;text-transform:uppercase}
  .nfc-overview,.nfc-section,.nfc-connect{max-width:1180px;margin:0 auto;padding:clamp(34px,5vw,58px) 0;border-top:1px solid color-mix(in srgb,var(--nfc-ink) 12%,transparent)}
  .nfc-overview{display:grid;grid-template-columns:1.08fr .92fr;gap:clamp(30px,6vw,72px);align-items:start}
  .nfc-overview.no-facts{grid-template-columns:1fr;max-width:880px}
  .nfc-overview.no-facts .story-body{max-width:100%}
  .story h2,.section-heading h2{margin:12px 0 0;font-family:Georgia,'Times New Roman',serif;font-size:clamp(2rem,4.4vw,4.4rem);font-weight:400;line-height:.95;letter-spacing:-.04em;text-wrap:balance}
  .story-body{max-width:720px;margin:22px 0 0;font-size:1rem;line-height:1.72;color:color-mix(in srgb,var(--nfc-ink) 74%,transparent)}
  .facts{display:grid;grid-template-columns:1fr 1fr;border-top:1px solid color-mix(in srgb,var(--nfc-ink) 12%,transparent)}
  .facts article{min-height:132px;padding:18px 14px;border-bottom:1px solid color-mix(in srgb,var(--nfc-ink) 12%,transparent)}
  .facts article:nth-child(odd){border-right:1px solid color-mix(in srgb,var(--nfc-ink) 12%,transparent)}
  .facts strong{display:block;font-family:Georgia,serif;font-size:clamp(1.7rem,3vw,2.8rem);font-weight:400;color:var(--nfc-accent)}
  .facts span{display:block;margin-top:8px;font-size:.72rem;line-height:1.35;color:color-mix(in srgb,var(--nfc-ink) 62%,transparent)}
  .section-heading{display:flex;justify-content:space-between;align-items:end;gap:28px;margin-bottom:28px}
  .section-heading h2{max-width:780px}
