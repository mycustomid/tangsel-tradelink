---
import BrandIcon from './BrandIcon.astro';
interface Action { key?: string; label: string; url: string }
interface Highlight { title: string; body: string }
interface GalleryItem { image?: string; label: string; caption?: string; url?: string }
interface StatItem { value: string; label: string }
interface Props {
  tenant: { name: string; hall?: string; booth?: string; category?: string };
  config: {
    logoDomain?: string; brandLabel?: string; tagline: string; eyebrow: string; heroImage?: string;
    palette?: { bg?: string; ink?: string; accent?: string; surface?: string };
    story: { title: string; body: string }; stats: StatItem[]; highlights: Highlight[];
    gallery: GalleryItem[]; actions: Action[];
  };
  baseUrl?: string;
}
const { tenant, config } = Astro.props;
const p = config.palette || {};
const vars = `--page:${p.bg||'#f3f0e9'};--ink:${p.ink||'#141414'};--accent:${p.accent||'#b46b3d'};--surface:${p.surface||'#ffffff'}`;
const label = config.brandLabel || tenant.name;
const initials = label.split(/\s+/).slice(0,2).map(x=>x[0]).join('').toUpperCase();
const iconMap: Record<string,string> = {whatsapp:'whatsapp',instagram:'instagram',maps:'maps',tokopedia:'tokopedia',shopee:'shopee',catalog:'catalog',email:'email',youtube:'youtube',website:'website',tiktok:'tiktok'};
const chapterNames = ['Intro','Story','Proof','Visuals','Connect'];
---
<main class="premium-onepage" style={vars} data-brand={label}>
  <div class="scroll-progress" aria-hidden="true"><span></span></div>
  <aside class="chapter-rail" aria-label={`${label} page sections`}>
    <strong>{label}</strong>
    <nav>{chapterNames.map((name,i)=><a href={`#chapter-${i+1}`} data-progress-link={i+1}><span>{String(i+1).padStart(2,'0')}</span><b>{name}</b></a>)}</nav>
  </aside>

  <section id="chapter-1" class="chapter hero" data-chapter="1">
    <div class="hero-noise"></div>
    <div class="hero-meta"><span>{tenant.category || 'TEI 2026 exhibitor'}</span><span>Hall {tenant.hall || '—'}{tenant.booth ? ` · Booth ${tenant.booth}` : ''}</span></div>
    <div class="hero-grid">
      <div class="hero-copy reveal">
        <div class="brand-token"><span>{initials}</span><p>{config.eyebrow}</p></div>
        <h1>{tenant.name}</h1>
        <p class="tagline">{config.tagline}</p>
        <div class="hero-actions">{config.actions.slice(0,2).map((a,i)=><a class:list={[i===0&&'primary']} href={a.url} target="_blank" rel="noopener noreferrer"><BrandIcon name={iconMap[a.key||'website']||'website'}/><span>{a.label}</span><b>↗</b></a>)}</div>
      </div>
      <figure class="hero-visual reveal" style="--delay:.12s">
        <div class="visual-fallback"><b>{initials}</b><span>{config.eyebrow}</span></div>
        {config.heroImage && <img src={config.heroImage} alt={label} loading="eager" decoding="async" referrerpolicy="no-referrer" onerror="this.style.display='none'" />}
        <figcaption><small>{label}</small><span>{config.tagline}</span></figcaption>
      </figure>
    </div>
    <a class="scroll-cue" href="#chapter-2"><span>Scroll</span><b>↓</b></a>
  </section>

  <section id="chapter-2" class="chapter story" data-chapter="2">
    <div class="chapter-kicker reveal"><span>01</span><p>Story</p></div>
    <div class="story-layout">
      <h2 class="reveal">{config.story.title}</h2>
      <div class="story-copy reveal" style="--delay:.12s"><p>{config.story.body}</p><span class="rule"></span><small>{label} · {tenant.category || 'TEI 2026'}</small></div>
    </div>
  </section>

  <section id="chapter-3" class="chapter proof" data-chapter="3">
    <div class="chapter-kicker reveal"><span>02</span><p>Proof</p></div>
    <div class="stats-grid reveal">{config.stats.map((s,i)=><article><small>{String(i+1).padStart(2,'0')}</small><strong>{s.value}</strong><p>{s.label}</p></article>)}</div>
    <div class="highlight-grid">{config.highlights.map((h,i)=><article class="reveal" style={`--delay:${i*.07}s`}><span>{String(i+1).padStart(2,'0')}</span><h3>{h.title}</h3><p>{h.body}</p></article>)}</div>
  </section>

  <section id="chapter-4" class="chapter visuals" data-chapter="4">
    <div class="chapter-kicker reveal"><span>03</span><p>In focus</p></div>
    <div class="visual-heading"><h2 class="reveal">A closer look.</h2><p class="reveal" style="--delay:.1s">Products, places and processes that define the business.</p></div>
    <div class="gallery">{config.gallery.map((g,i)=>{const card=<figure class:list={[i===0&&'wide','reveal']} style={`--delay:${i*.08}s`}><div class="visual-fallback"><b>{String(i+1).padStart(2,'0')}</b><span>{g.label}</span></div>{g.image&&<img src={g.image} alt={g.label} loading="lazy" decoding="async" referrerpolicy="no-referrer" onerror="this.style.display='none'"/>}<figcaption><small>{String(i+1).padStart(2,'0')}</small><strong>{g.label}</strong>{g.caption&&<span>{g.caption}</span>}</figcaption></figure>;return g.url?<a href={g.url} target="_blank" rel="noopener noreferrer">{card}</a>:card})}</div>
  </section>

  <section id="chapter-5" class="chapter connect" data-chapter="5">
    <div class="chapter-kicker reveal"><span>04</span><p>Connect</p></div>
    <div class="connect-heading"><h2 class="reveal">Continue with {label}.</h2><p class="reveal" style="--delay:.1s">Official destinations only.</p></div>
    <div class="links">{config.actions.map((a,i)=><a class="reveal" style={`--delay:${i*.06}s`} href={a.url} target="_blank" rel="noopener noreferrer"><span class="index">{String(i+1).padStart(2,'0')}</span><span class="icon"><BrandIcon name={iconMap[a.key||'website']||'website'}/></span><strong>{a.label}</strong><b>↗</b></a>)}</div>
    <div class="endcap reveal"><span>{initials}</span><div><small>{label}</small><strong>{config.tagline}</strong></div></div>
  </section>
</main>

<script>
  const root = document.querySelector('.premium-onepage');
  if (root) {
    const progress = root.querySelector('.scroll-progress span');
    const links = [...root.querySelectorAll('[data-progress-link]')];
    const chapters = [...root.querySelectorAll('[data-chapter]')];
    const updateProgress = () => {
      const doc = document.documentElement;
      const max = doc.scrollHeight - innerHeight;
      const ratio = max > 0 ? Math.min(1, Math.max(0, scrollY / max)) : 0;
      if (progress instanceof HTMLElement) progress.style.transform = `scaleX(${ratio})`;
    };
    addEventListener('scroll', updateProgress, { passive: true });
    updateProgress();
    const chapterObserver = new IntersectionObserver((entries) => {
      const visible = entries.filter(e => e.isIntersecting).sort((a,b)=>b.intersectionRatio-a.intersectionRatio)[0];
      if (!visible) return;
      const n = visible.target.getAttribute('data-chapter');
      links.forEach(link => link.toggleAttribute('aria-current', link.getAttribute('data-progress-link') === n));
    }, { threshold: [0.35,0.6] });
    chapters.forEach(chapter => chapterObserver.observe(chapter));
    const revealObserver = new IntersectionObserver((entries)=>entries.forEach(entry=>{if(entry.isIntersecting){entry.target.classList.add('is-visible');revealObserver.unobserve(entry.target)}}),{threshold:.16});
    root.querySelectorAll('.reveal').forEach(el=>revealObserver.observe(el));
  }
</script>

<style>
