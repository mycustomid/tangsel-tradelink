enter;max-width:1500px;width:100%;margin:auto}.brand-token{display:flex;align-items:center;gap:14px}.brand-token>span{width:54px;height:54px;border-radius:50%;display:grid;place-items:center;background:var(--accent);color:var(--ink);font-size:.66rem;font-weight:900;letter-spacing:.06em}.brand-token p{margin:0;max-width:420px;font-size:.68rem;font-weight:800;letter-spacing:.11em;text-transform:uppercase;opacity:.68}.hero h1{margin:24px 0 0;max-width:980px;font-family:Georgia,'Times New Roman',serif;font-size:clamp(4.2rem,10.5vw,10.6rem);font-weight:400;line-height:.78;letter-spacing:-.065em;text-wrap:balance}.tagline{max-width:720px;margin:30px 0 0;font-size:clamp(1rem,1.6vw,1.35rem);line-height:1.45;letter-spacing:.02em;opacity:.78}.hero-actions{display:flex;flex-wrap:wrap;gap:10px;margin-top:30px}.hero-actions a{display:flex;align-items:center;gap:10px;padding:13px 16px;border:1px solid color-mix(in srgb,var(--page) 22%,transparent);border-radius:999px;color:inherit;text-decoration:none;font-size:.78rem;font-weight:850;transition:transform .22s,background .22s}.hero-actions a:hover{transform:translateY(-3px);background:color-mix(in srgb,var(--page) 8%,transparent)}.hero-actions a.primary{background:var(--page);color:var(--ink)}.hero-proof{display:grid;grid-template-columns:auto 1fr;gap:12px;align-items:end;margin-top:26px;width:max-content;max-width:100%;padding-top:18px;border-top:1px solid color-mix(in srgb,var(--page) 18%,transparent)}.hero-proof span{font-family:Georgia,serif;font-size:clamp(2rem,4vw,4rem);line-height:.8;color:var(--accent)}.hero-proof p{margin:0 0 2px;max-width:180px;font-size:.64rem;line-height:1.35;letter-spacing:.09em;text-transform:uppercase;opacity:.58}.hero-visual{position:relative;margin:0;min-height:min(68vh,720px);border-radius:36px;overflow:hidden;background:color-mix(in srgb,var(--accent) 35%,var(--ink));box-shadow:0 42px 120px rgba(0,0,0,.28)}.hero-visual img,.gallery img{position:absolute;inset:0;width:100%;height:100%;object-fit: