---
import BrandIcon from './BrandIcon.astro';
interface Action { key?: string; label: string; url: string }
interface Highlight { title: string; body: string }
interface GalleryItem { image?: string; label: string; caption?: string; url?: string }
interface StatItem { value: string; label: string }
interface Props {
  tenant: { name: string; hall?: string; booth?: string; category?: string };
  config: {
    logoDomain?: string; brandLabel?: string; tagline: string; eyebrow: string; heroImage?: string;
    palette?: { bg?: string; ink?: string; accent?: string; surface?: string };
    story: { title: string; body: string }; stats: StatItem[]; highlights: Highlight[];
    gallery: GalleryItem[]; actions: Action[];
  };
  baseUrl?: string;
}
const { tenant, config } = Astro.props;
const p = config.palette || {};
const vars = `--page:${p.bg||'#f3f0e9'};--ink:${p.ink||'#141414'};--accent:${p.accent||'#b46b3d'};--surface:${p.surface||'#ffffff'}`;
const label = config.brandLabel || tenant.name;
const initials = label.split(/\s+/).slice(0,2).map(x=>x[0]).join('').toUpperCase();
const iconMap: Record<string,string> = {whatsapp:'whatsapp',instagram:'instagram',maps:'maps',tokopedia:'tokopedia',shopee:'shopee',catalog:'catalog',email:'email',youtube:'youtube',website:'website',tiktok:'tiktok'};

const experienceMap: Record<string, any> = {
  'TMMIN': {
    mode: 'industrial', rail: ['Origin','System','Scale','Line','Access'],
    heroMark: 'INDONESIA / PRODUCTION BASE', storyKicker: 'Manufacturing logic', proofKicker: 'Scale in motion', visualKicker: 'Production floor', connectKicker: 'Source material',
    storyAside: 'Five facilities. One manufacturing system.', proofTitle: 'Built in sequence.', proofIntro: 'Production, precision and export measured in real output.',
    visualTitle: 'Steel. Motion. Precision.', visualIntro: 'Factories, process and export milestones from Toyota Motor Manufacturing Indonesia.',
    connectTitle: 'Go to the source.', connectIntro: 'Corporate, factory and manufacturing references from TMMIN.'
  },
  'TATALOGAM': {
    mode: 'architectural', rail: ['Material','Origin','System','Surface','Network'],
    heroMark: 'ROOF / STEEL / SYSTEM', storyKicker: 'Material story', proofKicker: 'Structure + standards', visualKicker: 'Built surface', connectKicker: 'Product network',
    storyAside: 'Roofing became a wider building system.', proofTitle: 'Strength, made legible.', proofIntro: 'Products, standards and patents become part of the architecture.',
    visualTitle: 'From sheet to shelter.', visualIntro: 'A visual language of coated steel, roof profiles and lightweight structure.',
    connectTitle: 'Specify the system.', connectIntro: 'Products, authorized resellers and official Tatalogam channels.'
  },
  'MORRIS': {
    mode: 'fragrance', rail: ['Scent','House','Notes','Editions','Discover'],
    heroMark: 'EAU DE PARFUM / TANGERANG', storyKicker: 'Scent wardrobe', proofKicker: 'Portfolio', visualKicker: 'The edit', connectKicker: 'Discover',
    storyAside: 'Everyday fragrance, treated like a wardrobe.', proofTitle: 'A scent for every mood.', proofIntro: 'Formats, editions and product families create a wide discovery path.',
    visualTitle: 'Bottled personalities.', visualIntro: 'Gourmand, fantasy and everyday fragrance directions from Morris.',
    connectTitle: 'Choose your note.', connectIntro: 'Official Morris and Aroma Prima Livindo destinations.'
  },
  'SANFOOD': {
    mode: 'family-food', rail: ['Table','Purpose','Nutrition','Shelf','Shop'],
    heroMark: 'GOOD FOOD / GOOD KIDS', storyKicker: 'For the family table', proofKicker: 'What is inside', visualKicker: 'Pantry edit', connectKicker: 'Bring it home',
    storyAside: 'Healthy positioning, practical products, familiar meals.', proofTitle: 'Built around the everyday plate.', proofIntro: 'Low sugar and salt, no MSG, organic ingredients and certification are central to the brand story.',
    visualTitle: 'A brighter pantry.', visualIntro: 'Rice meals, seasonings, cereal, oils and snacks designed for family routines.',
    connectTitle: 'From shelf to table.', connectIntro: 'Products, partner routes and official Sanfood destinations.'
  },
  'AZAKI TEMPE': {
    mode: 'natural-export', rail: ['Bean','Culture','Process','Reach','Trade'],
    heroMark: 'TEMPEH / INDONESIA / WORLD', storyKicker: 'Culture to scale', proofKicker: 'Export discipline', visualKicker: 'Fermentation story', connectKicker: 'Global route',
    storyAside: 'A traditional food scaled with modern production standards.', proofTitle: 'Local craft, global discipline.', proofIntro: 'Factories, certifications and export markets make the scale visible.',
    visualTitle: 'From soybean to shelf.', visualIntro: 'Fresh, frozen and snack formats carry Indonesian tempeh into global markets.',
    connectTitle: 'Follow the export story.', connectIntro: 'Products, company background and official Azaki contact routes.'
  },
  'DRAGON': {
    mode: 'heritage-wellness', rail: ['1948','Heritage','Ritual','Range','Partner'],
    heroMark: 'HERITAGE WELLNESS / SINCE 1948', storyKicker: 'A household ritual', proofKicker: 'Legacy + compliance', visualKicker: 'The cabinet', connectKicker: 'Partner',
    storyAside: 'Menthol first. A broader wellness cabinet followed.', proofTitle: 'Heritage with standards behind it.', proofIntro: 'Decades of familiarity sit alongside certification, QC and product breadth.',
    visualTitle: 'Products people already know.', visualIntro: 'Balms, oils, menthol and topical wellness formats from Dragon Prima Farma.',
    connectTitle: 'Open the cabinet.', connectIntro: 'Official products, portfolio and partnership channels.'
  },
  'CLEAN MATIC': {
    mode: 'utility-design', rail: ['Tool','Range','System','Use','Store'],
    heroMark: 'TOOLS / CLEANING / EVERYDAY', storyKicker: 'Utility, refined', proofKicker: 'Range + supply', visualKicker: 'Object library', connectKicker: 'Get the tool',
    storyAside: 'Everyday cleaning, organized as a product system.', proofTitle: 'Useful objects, made easier to choose.', proofIntro: 'Categories, wholesale supply and physical stores turn utility into a complete retail experience.',
    visualTitle: 'Objects that earn their place.', visualIntro: 'Brooms, mops, sponges, bins and supporting tools presented as a coherent system.',
    connectTitle: 'Find the right tool.', connectIntro: 'Official store, marketplace and physical-store routes.'
  },
  'SINAR MAS LAND': {
    mode: 'placemaking', rail: ['Place','Scale','Portfolio','City','Contact'],
    heroMark: 'CITY / DISTRICT / DEVELOPMENT', storyKicker: 'Place-making', proofKicker: 'Scale of place', visualKicker: 'Urban field', connectKicker: 'Explore',
    storyAside: 'Townships, workplaces, retail and industry as one urban portfolio.', proofTitle: 'Development at city scale.', proofIntro: 'Land, property count, population and green-office space reveal the size of the platform.',
    visualTitle: 'Places with a horizon.', visualIntro: 'Township, industrial and mixed-use environments from Sinar Mas Land.',
    connectTitle: 'Explore the portfolio.', connectIntro: 'Official development, industrial and contact destinations.'
  },
