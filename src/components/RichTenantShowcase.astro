00px;width:100%;margin:auto}.brand-token{display:flex;align-items:center;gap:14px}.brand-token>span{width:54px;height:54px;border-radius:50%;display:grid;place-items:center;background:var(--accent);color:var(--ink);font-size:.66rem;font-weight:900;letter-spacing:.06em}.brand-token p{margin:0;max-width:420px;font-size:.68rem;font-weight:800;letter-spacing:.11em;text-transform:uppercase;opacity:.68}.hero h1{margin:24px 0 0;max-width:980px;font-family:Georgia,'Times New Roman',serif;font-size:clamp(4.2rem,10.5vw,10.6rem);font-weight:400;line-height:.78;letter-spacing:-.065em;text-wrap:balance}.tagline{max-width:720px;margin:30px 0 0;font-size:clamp(1rem,1.6vw,1.35rem);line-height:1.45;letter-spacing:.02em;opacity:.78}.hero-actions{display:flex;flex-wrap:wrap;gap:10px;margin-top:30px}.hero-actions a{display:flex;align-items:center;gap:10px;padding:13px 16px;border:1px solid color-mix(in srgb,var(--page) 22%,transparent);border-radius:999px;color:inherit;text-decoration:none;font-size:.78rem;font-weight:850;transition:transform .22s,background .22s}.hero-actions a:hover{transform:translateY(-3px);background:color-mix(in srgb,var(--page) 8%,transparent)}.hero-actions a.primary{background:var(--page);color:var(--ink)}.hero-visual{position:relative;margin:0;min-height:min(68vh,720px);border-radius:36px;overflow:hidden;background:color-mix(in srgb,var(--accent) 35%,var(--ink));box-shadow:0 42px 120px rgba(0,0,0,.28)}.hero-visual img,.gallery img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}.hero-visual:after,.gallery figure:after{content:"";position:absolute;inset:auto 0 0;height:56%;background:linear-gradient(transparent,rgba(0,0,0,.78))}.hero-visual figcaption,.gallery figcaption{position:absolute;z-index:3;left:24px;right:24px;bottom:22px;color:#fff;display:flex;flex-direction:column;gap:6px}.hero-visual figcaption small,.gallery figcaption small{font-size:.6rem;letter-spacing:.12em;text-transform:uppercase;font-weight:900;opacity:.7}.hero-visual figcaption span{font-size:.84rem;line-height:1.45;opacity:.82}.visual-fallback{position:absolute;inset:0;display:flex;flex-direction:column;justify-content:flex-end;gap:10px;padding:28px;background:radial-gradient(circle at 78% 18%,color-mix(in srgb,var(--accent) 72%,transparent),transparent 30%),linear-gradient(145deg,color-mix(in srgb,var(--accent) 38%,var(--ink)),var(--ink));color:var(--page)}.visual-fallback b{font-family:Georgia,serif;font-size:clamp(3rem,8vw,7rem);font-weight:400;line-height:.8}.visual-fallback span{font-size:.62rem;letter-spacing:.12em;text-transform:uppercase;font-weight:900;opacity:.6}.scroll-cue{position:relative;z-index:2;align-self:flex-start;display:flex;align-items:center;gap:10px;color:inherit;text-decoration:none;font-size:.62rem;letter-spacing:.12em;text-transform:uppercase;font-weight:900;opacity:.65}.chapter-kicker{display:flex;align-items:center;gap:12px;margin-bottom:clamp(34px,5vw,70px)}.chapter-kicker span{color:var(--accent);font-size:.7rem;font-weight:900}.chapter-kicker p{margin:0;font-size:.68rem;letter-spacing:.13em;text-transform:uppercase;font-weight:900}.story{display:flex;flex-direction:column;justify-content:center}.story-layout{display:grid;grid-template-columns:1.22fr .78fr;gap:clamp(36px,8vw,120px);align-items:end;max-width:1400px}.story h2,.visual-heading h2,.connect-heading h2{margin:0;font-family:Georgia,'Times New Roman',serif;font-size:clamp(3rem,7vw,7rem);font-weight:400;line-height:.94;letter-spacing:-.05em;text-wrap:balance}.story-copy{max-width:560px}.story-copy>p{margin:0;font-size:clamp(1.1rem,1.8vw,1.45rem);line-height:1.7}.story-copy .rule{display:block;width:100%;height:1px;background:color-mix(in srgb,var(--ink) 16%,transparent);margin:30px 0 14px}.story-copy small{font-size:.65rem;letter-spacing:.1em;text-transform:uppercase;opacity:.5}.proof{background:color-mix(in srgb,var(--surface) 72%,var(--page))}.stats-grid{display:grid;grid-template-columns:repeat(4,1fr);border-top:1px solid color-mix(in srgb,var(--ink) 15%,transparent);border-bottom:1px solid color-mix(in srgb,var(--ink) 15%,transparent)}.stats-grid article{padding:26px 18px;border-right:1px solid color-mix(in srgb,var(--ink) 12%,transparent)}.stats-grid article:last-child{border-right:0}.stats-grid small{display:block;color:var(--accent);font-weight:900;font-size:.62rem}.stats-grid strong{display:block;margin-top:28px;font-family:Georgia,serif;font-size:clamp(2.4rem,4.6vw,5rem);font-weight:400;line-height:.9}.stats-grid p{margin:8px 0 0;font-size:.76rem;line-height:1.35;opacity:.62}.highlight-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-top:18px}.highlight-grid article{min-height:320px;padding:24px;border-radius:24px;border:1px solid color-mix(in srgb,var(--ink) 12%,transparent);background:var(--page);display:flex;flex-direction:column}.highlight-grid article>span{color:var(--accent);font-size:.62rem;font-weight:900}.highlight-grid h3{margin:auto 0 12px;font-family:Georgia,serif;font-size:clamp(1.7rem,2.7vw,3rem);font-weight:400;line-height:.98}.highlight-grid p{margin:0;font-size:.84rem;line-height:1.55;opacity:.68}.visuals{background:var(--ink);color:var(--page)}.visual-heading{display:flex;justify-content:space-between;gap:30px;align-items:end;margin-bottom:44px}.visual-heading p,.connect-heading p{max-width:340px;margin:0;font-size:.9rem;line-height:1.55;opacity:.6}.gallery{display:grid;grid-template-columns:1.3fr .7fr;grid-auto-rows:minmax(300px,42vw);gap:14px}.gallery>a{display:contents}.gallery figure{position:relative;margin:0;border-radius:28px;overflow:hidden;background:color-mix(in srgb,var(--accent) 30%,var(--ink))}.gallery figure.wide{grid-row:span 2}.gallery figcaption strong{font-family:Georgia,serif;font-size:clamp(1.7rem,3vw,3.4rem);font-weight:400}.gallery figcaption span{max-width:420px;font-size:.78rem;line-height:1.45;opacity:.72}.connect{display:flex;flex-direction:column;justify-content:center}.connect-heading{display:flex;justify-content:space-between;align-items:end;gap:34px;margin-bottom:40px}.links{border-top:1px solid color-mix(in srgb,var(--ink) 16%,transparent)}.links a{display:grid;grid-template-columns:44px 42px 1fr auto;gap:14px;align-items:center;padding:22px 4px;border-bottom:1px solid color-mix(in srgb,var(--ink) 16%,transparent);color:inherit;text-decoration:none;transition:padding .2s,background .2s}.links a:hover{padding-left:14px;padding-right:14px;background:color-mix(in srgb,var(--surface) 64%,transparent)}.links .index{font-size:.62rem;font-weight:900;color:var(--accent)}.links .icon{width:38px;height:38px;border-radius:50%;display:grid;place-items:center;background:var(--surface)}.links strong{font-family:Georgia,serif;font-size:clamp(1.2rem,2.3vw,2.1rem);font-weight:400}.endcap{margin-top:70px;padding-top:32px;border-top:1px solid color-mix(in srgb,var(--ink) 15%,transparent);display:flex;align-items:center;gap:18px}.endcap>span{width:64px;height:64px;border-radius:50%;display:grid;place-items:center;background:var(--ink);color:var(--page);font-size:.7rem;font-weight:900}.endcap div{display:flex;flex-direction:column;gap:6px}.endcap small{font-size:.62rem;text-transform:uppercase;letter-spacing:.12em;opacity:.55}.endcap strong{font-family:Georgia,serif;font-size:clamp(1.2rem,2.2vw,1.8rem);font-weight:400}.reveal{opacity:0;transform:translateY(28px);transition:opacity .75s ease var(--delay,0s),transform .75s cubic-bezier(.2,.75,.2,1) var(--delay,0s)}.reveal.is-visible{opacity:1;transform:none}@media(max-width:980px){.chapter-rail{display:none}.hero-grid,.story-layout{grid-template-columns:1fr}.hero-visual{min-height:60vh}.stats-grid,.highlight-grid{grid-template-columns:repeat(2,1fr)}.stats-grid article:nth-child(2){border-right:0}.stats-grid article:nth-child(-n+2){border-bottom:1px solid color-mix(in srgb,var(--ink) 12%,transparent)}.highlight-grid article{min-height:260px}.gallery{grid-template-columns:1fr;grid-auto-rows:minmax(320px,65vw)}.gallery figure.wide{grid-row:auto}.visual-heading,.connect-heading{align-items:start;flex-direction:column}}@media(max-width:620px){.chapter{padding:74px 18px;min-height:auto}.hero{min-height:100svh;padding-top:22px}.hero-meta{font-size:.56rem}.hero-grid{margin-top:10vh}.hero h1{font-size:19vw}.hero-visual{min-height:54vh;border-radius:24px}.stats-grid,.highlight-grid{grid-template-columns:1fr}.stats-grid article{border-right:0!important;border-bottom:1px solid color-mix(in srgb,var(--ink) 12%,transparent)!important}.highlight-grid article{min-height:220px}.gallery{grid-auto-rows:360px}.links a{grid-template-columns:30px 38px 1fr 18px}.links strong{font-size:1.15rem}.hero-actions{display:grid;grid-template-columns:1fr}.hero-actions a{justify-content:flex-start}}@media(prefers-reduced-motion:reduce){:global(html){scroll-behavior:auto}.reveal{opacity:1;transform:none;transition:none}.hero-actions a,.links a{transition:none}}
</style>
