---
interface Props { name: string }
const { name } = Astro.props;
const rawBaseUrl = import.meta.env.BASE_URL;
const baseUrl = rawBaseUrl.endsWith('/') ? rawBaseUrl : `${rawBaseUrl}/`;
const icons: Record<string, string> = {
  whatsapp: 'whatsapp.svg',
  instagram: 'instagram.svg',
  facebook: 'facebook.svg',
  linkedin: 'linkedin.svg',
  tiktok: 'tiktok.svg',
  tiktokshop: 'tiktok-shop.svg',
  youtube: 'youtube.svg',
  maps: 'google-maps.svg',
  tokopedia: 'tokopedia.svg',
  shopee: 'shopee.svg',
  drive: 'google-drive.svg',
  website: 'website.svg',
  catalog: 'catalog.svg',
  email: 'email.svg',
};
const iconFile = icons[name] || 'website.svg';
const iconSrc = `${baseUrl}icons/brands/${iconFile}`;
---

<span class="brand-icon-wrap" aria-hidden="true">
  <img class="brand-icon" src={iconSrc} alt="" width="24" height="24" loading="eager" decoding="async" />
</span>

<style>
  .brand-icon-wrap{width:24px;height:24px;display:grid;place-items:center;flex:none;overflow:hidden}
  .brand-icon{width:24px;height:24px;display:block;object-fit:contain}
</style>