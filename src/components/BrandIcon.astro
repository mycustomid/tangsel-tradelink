---
interface Props { name: string }
const { name } = Astro.props;
const brands: Record<string, { slug?: string; color?: string }> = {
  whatsapp: { slug: 'whatsapp', color: '25D366' },
  instagram: { slug: 'instagram', color: 'E4405F' },
  facebook: { slug: 'facebook', color: '0866FF' },
  linkedin: { slug: 'linkedin', color: '0A66C2' },
  tiktok: { slug: 'tiktok', color: '000000' },
  youtube: { slug: 'youtube', color: 'FF0000' },
  maps: { slug: 'googlemaps', color: '4285F4' },
  tokopedia: { slug: 'tokopedia', color: '42B549' },
  shopee: { slug: 'shopee', color: 'EE4D2D' },
};
const brand = brands[name];
---

{brand?.slug ? (
  <span class="brand-icon-wrap" aria-hidden="true">
    <svg class="brand-fallback" viewBox="0 0 24 24"><path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20Zm4.8 6h-2.45a14.2 14.2 0 0 0-.92-2.55A8.03 8.03 0 0 1 16.8 8ZM12 4.15c.65.9 1.2 2.2 1.53 3.85h-3.06C10.8 6.35 11.35 5.05 12 4.15ZM10.57 5.45A14.2 14.2 0 0 0 9.65 8H7.2a8.03 8.03 0 0 1 3.37-2.55ZM4.15 10h5.2a16 16 0 0 0 0 4h-5.2a8.07 8.07 0 0 1 0-4Zm3.05 6h2.45c.2.92.5 1.78.92 2.55A8.03 8.03 0 0 1 7.2 16ZM12 19.85c-.65-.9-1.2-2.2-1.53-3.85h3.06c-.33 1.65-.88 2.95-1.53 3.85ZM13.8 14h-3.6a14.1 14.1 0 0 1 0-4h3.6a14.1 14.1 0 0 1 0 4Zm-.37 4.55c.42-.77.72-1.63.92-2.55h2.45a8.03 8.03 0 0 1-3.37 2.55ZM14.65 14a16 16 0 0 0 0-4h5.2a8.07 8.07 0 0 1 0 4h-5.2Z"/></svg>
    <img class="brand-icon" src={`https://cdn.simpleicons.org/${brand.slug}/${brand.color}`} alt="" width="23" height="23" loading="lazy" decoding="async" onerror="this.style.display='none'" />
  </span>
) : name === 'email' ? (
  <svg class="standalone" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 5h18v14H3V5Zm2 2v.5l7 5 7-5V7H5Zm14 10V9.95l-7 5-7-5V17h14Z"/></svg>
) : name === 'catalog' ? (
  <svg class="standalone" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 2h9l4 4v16H6V2Zm8 2v3h3l-3-3ZM8 11h8V9H8v2Zm0 4h8v-2H8v2Zm0 4h6v-2H8v2Z"/></svg>
) : (
  <svg class="standalone" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20Zm6.92 6h-3.01a15.7 15.7 0 0 0-1.2-3.08A8.04 8.04 0 0 1 18.92 8ZM12 4c.83 1.08 1.48 2.43 1.84 4h-3.68C10.52 6.43 11.17 5.08 12 4ZM9.29 4.92A15.7 15.7 0 0 0 8.09 8H5.08a8.04 8.04 0 0 1 4.21-3.08ZM4.26 10h3.5a16.57 16.57 0 0 0 0 4h-3.5a8.1 8.1 0 0 1 0-4Zm.82 6h3.01c.27 1.1.67 2.14 1.2 3.08A8.04 8.04 0 0 1 5.08 16ZM12 20c-.83-1.08-1.48-2.43-1.84-4h3.68c-.36 1.57-1.01 2.92-1.84 4Zm2.24-6H9.76a14.46 14.46 0 0 1 0-4h4.48a14.46 14.46 0 0 1 0 4Zm.47 5.08c.53-.94.93-1.98 1.2-3.08h3.01a8.04 8.04 0 0 1-4.21 3.08ZM16.24 14a16.57 16.57 0 0 0 0-4h3.5a8.1 8.1 0 0 0 0 4h-3.5Z"/></svg>
)}

<style>
  .brand-icon-wrap{position:relative;width:23px;height:23px;display:block;flex:none}.brand-icon,.brand-fallback,.standalone{width:23px;height:23px;display:block;object-fit:contain}.brand-fallback{position:absolute;inset:0;fill:currentColor;opacity:.48}.brand-icon{position:absolute;inset:0}.standalone{fill:currentColor}
</style>
