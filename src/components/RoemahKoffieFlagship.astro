---
import BrandIcon from './BrandIcon.astro';
interface Props { tenant:any; config:any; baseUrl?:string }
const { tenant, config } = Astro.props;
const socials = [{key:'instagram',url:config.instagram},{key:'website',url:config.website}].filter(x=>x.url);
---
<main class="rk-onepage">
  <div class="scroll-progress" aria-hidden="true"><span></span></div>
  <aside class="rk-rail" aria-label="Roemah Koffie page sections"><strong>ROEMAH KOFFIE</strong><nav>{['Intro','Menus','Places','Shop','Business'].map((x,i)=><a href={`#rk-${i+1}`} data-progress-link={i+1}><span>{String(i+1).padStart(2,'0')}</span><b>{x}</b></a>)}</nav></aside>

  <section id="rk-1" class="chapter hero" data-chapter="1">
    <div class="hero-meta"><span>{config.eyebrow}</span><span>Hall {tenant.hall || '—'}{tenant.booth?` · Booth ${tenant.booth}`:''}</span></div>
    <div class="hero-grid">
      <div class="hero-copy reveal"><p class="eyebrow">Indonesian coffee · hospitality · culture</p><h1>Roemah<br/><em>Koffie.</em></h1><p class="tagline">{config.tagline}</p><div class="actions">{config.primaryActions.map((a:any,i:number)=><a class:list={[i===0&&'primary']} href={a.url} target="_blank" rel="noopener noreferrer"><BrandIcon name={a.key}/><span>{a.label}</span><b>↗</b></a>)}</div><div class="socials">{socials.map((s:any)=><a href={s.url} target="_blank" rel="noopener noreferrer" aria-label={s.key}><BrandIcon name={s.key}/></a>)}</div></div>
      <figure class="hero-card reveal" style="--delay:.12s"><img src={config.locationGallery?.[1]?.image || config.heroImage} alt="Roemah Koffie interior" loading="eager" decoding="async" referrerpolicy="no-referrer" onerror="this.style.display='none'"/><figcaption><small>Roastery · restaurant · coffee culture</small><strong>Indonesian coffee, presented with a sense of place.</strong></figcaption></figure>
    </div>
    <a class="scroll-cue" href="#rk-2">Explore ↓</a>
  </section>

  <section id="rk-2" class="chapter menus" data-chapter="2"><div class="section-kicker reveal"><span>01</span><p>Menus</p></div><div class="section-title"><h2 class="reveal">Three doors into the table.</h2><p class="reveal" style="--delay:.1s">Each location carries its own context, menu and pace.</p></div><div class="menu-grid">{config.menus.map((m:any,i:number)=><a class="menu-card reveal" style={`--delay:${i*.08}s`} href={m.url} target="_blank" rel="noopener noreferrer"><img src={m.image} alt={m.imageAlt || m.label} loading="lazy" decoding="async" referrerpolicy="no-referrer" onerror="this.style.display='none'"/><span class="shade"></span><small>Menu {String(i+1).padStart(2,'0')}</small><div><h3>{m.label.replace('Menu ','')}</h3><b>Open menu ↗</b></div></a>)}</div></section>

  <section id="rk-3" class="chapter places" data-chapter="3"><div class="section-kicker reveal"><span>02</span><p>Places</p></div><div class="places-heading"><h2 class="reveal">Coffee changes with the room.</h2><p class="reveal" style="--delay:.1s">Find the setting that fits the meeting, the meal or the afternoon.</p></div><div class="places-layout"><div class="place-gallery">{config.locationGallery.map((g:any,i:number)=><figure class:list={[i===0&&'big','reveal']} style={`--delay:${i*.08}s`}><img src={g.image} alt={g.label} loading="lazy" decoding="async" referrerpolicy="no-referrer" onerror="this.style.display='none'"/><figcaption><strong>{g.label}</strong><span>{g.caption}</span></figcaption></figure>)}</div><div class="place-list reveal">{config.locations.map((l:any,i:number)=><a href={l.url} target="_blank" rel="noopener noreferrer"><span>{String(i+1).padStart(2,'0')}</span><strong>{l.label}</strong><BrandIcon name="maps"/><b>↗</b></a>)}</div></div></section>

  <section id="rk-4" class="chapter shop" data-chapter="4"><div class="section-kicker reveal"><span>03</span><p>Shop</p></div><div class="shop-heading"><h2 class="reveal">Take the coffee home.</h2><p class="reveal" style="--delay:.1s">Official marketplaces and membership, without another layer in between.</p></div><div class="market-grid">{config.marketplaces.map((m:any,i:number)=><a class="reveal" style={`--delay:${i*.07}s`} href={m.url} target="_blank" rel="noopener noreferrer"><BrandIcon name={m.key}/><strong>{m.label}</strong><b>Shop ↗</b></a>)}</div><div class="membership reveal"><span>Membership</span><h3>Stay inside the Roemah Koffie circle.</h3><a href={config.membership.url} target="_blank" rel="noopener noreferrer">Register ↗</a></div></section>

  <section id="rk-5" class="chapter business" data-chapter="5"><div class="section-kicker reveal"><span>04</span><p>Business</p></div><div class="business-heading"><h2 class="reveal">From a table to a bigger room.</h2><p class="reveal" style="--delay:.1s">Training, catering and franchise paths for people who want to go further.</p></div><div class="business-grid"><a class="reveal" href={config.academy.url} target="_blank" rel="noopener noreferrer"><span>Academy</span><h3>Coffee knowledge, made practical.</h3><b>Explore academy ↗</b></a><a class="reveal" style="--delay:.08s" href={config.banquet.url} target="_blank" rel="noopener noreferrer"><span>Banquet & catering</span><h3>Bring the Roemah Koffie table to your event.</h3><b>Start an inquiry ↗</b></a><a class="reveal" style="--delay:.16s" href={config.franchise.url} target="_blank" rel="noopener noreferrer"><span>Franchise</span><h3>Build the next Roemah Koffie address.</h3><b>Explore franchise ↗</b></a></div><div class="signature reveal"><strong>ROEMAH KOFFIE</strong><span>{config.tagline}</span></div></section>
</main>

<script>
const root=document.querySelector('.rk-onepage');if(root){const bar=root.querySelector('.scroll-progress span');const links=[...root.querySelectorAll('[data-progress-link]')];const chapters=[...root.querySelectorAll('[data-chapter]')];const update=()=>{const max=document.documentElement.scrollHeight-innerHeight;const r=max>0?Math.min(1,Math.max(0,scrollY/max)):0;if(bar instanceof HTMLElement)bar.style.transform=`scaleX(${r})`};addEventListener('scroll',update,{passive:true});update();const co=new IntersectionObserver(es=>{const v=es.filter(e=>e.isIntersecting).sort((a,b)=>b.intersectionRatio-a.intersectionRatio)[0];if(!v)return;const n=v.target.getAttribute('data-chapter');links.forEach(l=>l.toggleAttribute('aria-current',l.getAttribute('data-progress-link')===n))},{threshold:[.35,.6]});chapters.forEach(c=>co.observe(c));const ro=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){e.target.classList.add('is-visible');ro.unobserve(e.target)}}),{threshold:.16});root.querySelectorAll('.reveal').forEach(e=>ro.observe(e))}
</script>

<style>
:global(html){scroll-behavior:smooth;background:#f0e3cf}:global(body){background:#f0e3cf}.rk-onepage{--cream:#f0e3cf;--ink:#1b0e08;--copper:#c77845;--wine:#5a2117;min-height:100vh;background:var(--cream);color:var(--ink);overflow:clip}.scroll-progress{position:fixed;z-index:50;top:0;left:0;right:0;height:3px;background:rgba(27,14,8,.12)}.scroll-progress span{display:block;width:100%;height:100%;transform:scaleX(0);transform-origin:left;background:var(--copper)}.rk-rail{position:fixed;z-index:40;right:18px;top:50%;transform:translateY(-50%);display:flex;flex-direction:column;align-items:flex-end;gap:18px;color:#fff;mix-blend-mode:difference;pointer-events:none}.rk-rail>strong{font-size:.6rem;letter-spacing:.13em}.rk-rail nav{display:flex;flex-direction:column;align-items:flex-end;gap:7px}.rk-rail a{pointer-events:auto;display:flex;gap:8px;color:inherit;text-decoration:none;font-size:.56rem;text-transform:uppercase;letter-spacing:.08em;opacity:.35}.rk-rail a[aria-current]{opacity:1}.chapter{position:relative;min-height:100svh;padding:clamp(72px,8vw,118px) clamp(20px,7vw,100px)}.hero{display:flex;flex-direction:column;justify-content:space-between;background:radial-gradient(circle at 76% 16%,#6f2817 0,transparent 34%),linear-gradient(145deg,#160b07,#2c130c 56%,#4e1b12);color:#fff2df;padding-top:28px}.hero-meta{display:flex;justify-content:space-between;gap:20px;font-size:.62rem;letter-spacing:.12em;text-transform:uppercase;font-weight:900;opacity:.58}.hero-grid{display:grid;grid-template-columns:1.12fr .88fr;gap:clamp(36px,8vw,110px);align-items:center;max-width:1450px;width:100%;margin:auto}.eyebrow{margin:0;color:#df9d69;font-size:.68rem;font-weight:900;letter-spacing:.12em;text-transform:uppercase}.hero h1{margin:18px 0 0;font-size:clamp(4.7rem,11vw,11rem);line-height:.73;letter-spacing:-.075em;font-weight:900}.hero h1 em{font-family:Georgia,serif;font-weight:400;color:#e4ad79}.tagline{max-width:560px;margin:28px 0 0;color:#d6bda6;font-size:clamp(1rem,1.6vw,1.3rem);line-height:1.55}.actions{display:flex;flex-wrap:wrap;gap:10px;margin-top:28px}.actions a{display:flex;align-items:center;gap:9px;padding:13px 16px;border:1px solid rgba(255,255,255,.18);border-radius:999px;color:inherit;text-decoration:none;font-size:.78rem;font-weight:900}.actions a.primary{background:#fff2df;color:#1f1009}.socials{display:flex;gap:10px;margin-top:16px}.socials a{width:42px;height:42px;border-radius:50%;display:grid;place-items:center;border:1px solid rgba(255,255,255,.16);color:inherit}.hero-card{position:relative;margin:0;min-height:min(70vh,720px);border-radius:36px;overflow:hidden;box-shadow:0 44px 120px rgba(0,0,0,.36);background:#3a1b10}.hero-card img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}.hero-card:after{content:"";position:absolute;inset:auto 0 0;height:58%;background:linear-gradient(transparent,rgba(14,7,4,.86))}.hero-card figcaption{position:absolute;z-index:2;left:26px;right:26px;bottom:24px;display:flex;flex-direction:column;gap:8px}.hero-card small{font-size:.6rem;letter-spacing:.12em;text-transform:uppercase;opacity:.7}.hero-card strong{font-family:Georgia,serif;font-size:clamp(1.7rem,3vw,3.3rem);font-weight:400;line-height:1}.scroll-cue{color:inherit;text-decoration:none;font-size:.62rem;letter-spacing:.12em;text-transform:uppercase;font-weight:900;opacity:.58}.section-kicker{display:flex;align-items:center;gap:12px;margin-bottom:clamp(32px,5vw,66px)}.section-kicker span{color:#9a5c37;font-size:.68rem;font-weight:900}.section-kicker p{margin:0;font-size:.66rem;letter-spacing:.12em;text-transform:uppercase;font-weight:900}.section-title,.places-heading,.shop-heading,.business-heading{display:flex;justify-content:space-between;align-items:end;gap:30px;margin-bottom:42px}.section-title h2,.places-heading h2,.shop-heading h2,.business-heading h2{margin:0;max-width:930px;font-family:Georgia,serif;font-size:clamp(3rem,7vw,7rem);font-weight:400;line-height:.94;letter-spacing:-.05em}.section-title p,.places-heading p,.shop-heading p,.business-heading p{max-width:340px;margin:0;font-size:.92rem;line-height:1.55;opacity:.62}.menus{background:#1c0f0a;color:#f7ead8}.menus .section-kicker span{color:#d99666}.menu-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.menu-card{position:relative;min-height:70vh;border-radius:30px;overflow:hidden;color:#fff;text-decoration:none;display:flex;flex-direction:column;padding:24px;isolation:isolate;background:#2a160f}.menu-card img{position:absolute;z-index:-2;inset:0;width:100%;height:100%;object-fit:cover;transition:transform .45s ease}.menu-card:hover img{transform:scale(1.04)}.menu-card .shade{position:absolute;z-index:-1;inset:0;background:linear-gradient(180deg,rgba(15,7,4,.08),rgba(15,7,4,.2) 42%,rgba(15,7,4,.9))}.menu-card small{align-self:flex-start;padding:7px 9px;border-radius:999px;background:rgba(20,10,5,.5);font-size:.62rem;letter-spacing:.1em;text-transform:uppercase;font-weight:900}.menu-card>div{margin-top:auto}.menu-card h3{margin:0 0 10px;font-family:Georgia,serif;font-size:clamp(2.3rem,4.2vw,4.7rem);font-weight:400;line-height:.93}.menu-card b{color:#ffd1a8;font-size:.78rem}.places-layout{display:grid;grid-template-columns:1.1fr .9fr;gap:24px}.place-gallery{display:grid;grid-template-columns:1.3fr .7fr;grid-template-rows:repeat(2,270px);gap:12px}.place-gallery figure{position:relative;margin:0;border-radius:28px;overflow:hidden;background:#d3bfa3}.place-gallery figure.big{grid-row:1/3}.place-gallery img{width:100%;height:100%;object-fit:cover}.place-gallery figure:after{content:"";position:absolute;inset:auto 0 0;height:48%;background:linear-gradient(transparent,rgba(20,10,5,.78))}.place-gallery figcaption{position:absolute;z-index:2;left:20px;right:20px;bottom:18px;color:#fff;display:flex;flex-direction:column;gap:4px}.place-gallery figcaption strong{font-family:Georgia,serif;font-size:1.6rem;font-weight:400}.place-gallery figcaption span{font-size:.72rem;opacity:.76}.place-list{border-top:1px solid rgba(27,14,8,.16)}.place-list a{display:grid;grid-template-columns:38px 1fr 28px 18px;gap:12px;align-items:center;padding:20px 4px;border-bottom:1px solid rgba(27,14,8,.16);color:inherit;text-decoration:none}.place-list span{font-size:.62rem;font-weight:900;color:#9a5c37}.place-list strong{font-family:Georgia,serif;font-size:clamp(1.1rem,2vw,1.8rem);font-weight:400}.shop{background:#efe1cb}.market-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.market-grid a{display:grid;grid-template-columns:38px 1fr auto;gap:12px;align-items:center;min-height:92px;padding:18px 20px;border:1px solid rgba(27,14,8,.15);border-radius:22px;color:inherit;text-decoration:none;background:#fff7e9}.market-grid strong{font-size:.94rem}.market-grid b{font-size:.72rem}.membership{margin-top:18px;min-height:300px;border-radius:30px;padding:30px;background:#6f2a1c;color:#fff1df;display:flex;flex-direction:column}.membership span{font-size:.65rem;letter-spacing:.12em;text-transform:uppercase;font-weight:900;opacity:.7}.membership h3{margin:50px 0 20px;max-width:690px;font-family:Georgia,serif;font-size:clamp(2.2rem,4.8vw,4.8rem);font-weight:400;line-height:.96}.membership a{margin-top:auto;color:inherit;text-decoration:none;font-weight:900}.business{background:#180c08;color:#f5e7d5}.business .section-kicker span{color:#d89565}.business-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.business-grid a{min-height:420px;padding:28px;border-radius:28px;background:#3c1b12;color:#f5e7d5;text-decoration:none;display:flex;flex-direction:column;border:1px solid rgba(255,255,255,.08)}.business-grid a:nth-child(2){background:#a95d35;color:#1a0d08}.business-grid span{font-size:.64rem;letter-spacing:.12em;text-transform:uppercase;font-weight:900;opacity:.7}.business-grid h3{margin:58px 0 18px;font-family:Georgia,serif;font-size:clamp(2rem,3.4vw,3.6rem);font-weight:400;line-height:.98}.business-grid b{margin-top:auto}.signature{margin-top:78px;padding-top:30px;border-top:1px solid rgba(255,255,255,.14);display:flex;justify-content:space-between;gap:24px;align-items:end}.signature strong{font-size:clamp(1.6rem,3vw,3rem);letter-spacing:.05em}.signature span{font-family:Georgia,serif;font-size:clamp(1rem,2vw,1.5rem);opacity:.6}.reveal{opacity:0;transform:translateY(28px);transition:opacity .75s ease var(--delay,0s),transform .75s cubic-bezier(.2,.75,.2,1) var(--delay,0s)}.reveal.is-visible{opacity:1;transform:none}@media(max-width:980px){.rk-rail{display:none}.hero-grid,.places-layout{grid-template-columns:1fr}.hero-card{min-height:60vh}.menu-grid,.market-grid,.business-grid{grid-template-columns:1fr}.menu-card{min-height:520px}.section-title,.places-heading,.shop-heading,.business-heading{align-items:start;flex-direction:column}.place-gallery{min-height:520px}}@media(max-width:620px){.chapter{min-height:auto;padding:72px 18px}.hero{min-height:100svh;padding-top:22px}.hero h1{font-size:21vw}.hero-card{min-height:54vh;border-radius:24px}.actions{display:grid;grid-template-columns:1fr}.menu-card{min-height:420px}.place-gallery{grid-template-columns:1fr;grid-template-rows:none;min-height:0}.place-gallery figure,.place-gallery figure.big{height:320px;grid-row:auto}.market-grid a{grid-template-columns:34px 1fr auto}.business-grid a{min-height:320px}.signature{align-items:flex-start;flex-direction:column}}@media(prefers-reduced-motion:reduce){:global(html){scroll-behavior:auto}.reveal{opacity:1;transform:none;transition:none}.menu-card img{transition:none}}
</style>
