---
import BrandIcon from './BrandIcon.astro';
interface LinkItem { key?: string; label: string; url: string }
interface Props {
  tenant: { name: string; hall?: string; booth?: string; category?: string };
  config: {
    tagline: string; eyebrow: string; heroImage: string;
    primaryActions: LinkItem[]; menus: LinkItem[]; locations: LinkItem[]; marketplaces: LinkItem[];
    membership: LinkItem; banquet: LinkItem; franchise: LinkItem; academy: LinkItem;
    website: string; instagram: string; linktree: string;
  };
  baseUrl: string;
}
const { tenant, config, baseUrl } = Astro.props;
const boothLabel = tenant.booth ? `Booth ${tenant.booth}` : 'TEI 2026 exhibitor';
const reservation = config.primaryActions.find((item) => item.key === 'reservation')?.url || config.website;
const actionIcon: Record<string, string> = { whatsapp: 'whatsapp', reservation: 'website' };
---

<main class="rk-shell">
  <section class="hero" aria-labelledby="rk-title">
    <div class="orb orb-one"></div><div class="orb orb-two"></div>
    <nav class="topbar">
      <a href={baseUrl}>← Tangsel TradeLink</a>
      <span>TEI 2026 · {tenant.hall || 'Exhibitor'} · {boothLabel}</span>
    </nav>

    <div class="hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">{config.eyebrow}</p>
        <h1 id="rk-title">ROEMAH<br/><em>KOFFIE</em></h1>
        <p class="tagline">{config.tagline}</p>
        <div class="primary-actions">
          {config.primaryActions.map((item) => (
            <a class:list={["primary", item.key === 'reservation' && 'ghost']} href={item.url} target="_blank" rel="noopener noreferrer">
              <BrandIcon name={actionIcon[item.key || ''] || 'website'} /><span>{item.label}</span><b>↗</b>
            </a>
          ))}
        </div>
        <div class="social-row">
          <a href={config.instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram"><BrandIcon name="instagram" /></a>
          <a href={config.website} target="_blank" rel="noopener noreferrer" aria-label="Official website"><BrandIcon name="website" /></a>
          <a href={config.linktree} target="_blank" rel="noopener noreferrer" aria-label="Original Linktree"><BrandIcon name="linktree" /></a>
        </div>
      </div>

      <div class="hero-card">
        <div class="image-wrap"><img src={config.heroImage} alt="Roemah Koffie" loading="eager" decoding="async" /></div>
        <div class="hero-card-copy"><span>Trade Expo Indonesia 2026</span><strong>{tenant.hall || 'Exhibitor Hall'} · {boothLabel}</strong><p>Indonesian coffee culture, from roastery and restaurants to academy experiences and retail.</p></div>
      </div>
    </div>
    <div class="marquee" aria-hidden="true"><div>INDONESIAN COFFEE · ROASTERY · RESTAURANTS · ACADEMY · HOSPITALITY · INDONESIAN COFFEE · ROASTERY · RESTAURANTS · ACADEMY · HOSPITALITY ·</div></div>
  </section>

  <section class="section-block experience">
    <div class="section-head"><p>01 / Experience</p><h2>Choose how you want to meet Roemah Koffie.</h2></div>
    <div class="feature-grid">
      <a class="feature feature-main" href={reservation} target="_blank" rel="noopener noreferrer"><span>Reserve</span><h3>Your table,<br/>your coffee story.</h3><p>Book a table at a Roemah Koffie outlet.</p><b>Reserve now ↗</b></a>
      <a class="feature" href={config.membership.url} target="_blank" rel="noopener noreferrer"><span>Membership</span><h3>Become part of the house.</h3><p>Register as a Roemah Koffie member.</p><b>Join ↗</b></a>
      <a class="feature" href={config.academy.url} target="_blank" rel="noopener noreferrer"><span>Academy</span><h3>Go deeper into coffee.</h3><p>Explore programs, classes and the coffee academy.</p><b>Explore academy ↗</b></a>
    </div>
  </section>

  <section class="section-block menus">
    <div class="section-head"><p>02 / Menus</p><h2>Three menus. One Indonesian coffee point of view.</h2></div>
    <div class="menu-grid">
      {config.menus.map((menu, index) => (
        <a class="menu-card" href={menu.url} target="_blank" rel="noopener noreferrer"><small>MENU 0{index + 1}</small><h3>{menu.label.replace('Menu ', '')}</h3><span>Open menu ↗</span></a>
      ))}
    </div>
  </section>

  <section class="section-block locations">
    <div class="section-head"><p>03 / Locations</p><h2>Find your nearest Roemah.</h2></div>
    <div class="location-list">
      {config.locations.map((location, index) => (
        <a href={location.url} target="_blank" rel="noopener noreferrer"><span>{String(index + 1).padStart(2, '0')}</span><strong>{location.label}</strong><BrandIcon name="maps" /><b>↗</b></a>
      ))}
    </div>
  </section>

  <section class="section-block commerce">
    <div class="section-head"><p>04 / Take it home</p><h2>Roemah Koffie, beyond the table.</h2></div>
    <div class="market-grid">
      {config.marketplaces.map((market) => (
        <a href={market.url} target="_blank" rel="noopener noreferrer"><BrandIcon name={market.key || 'website'} /><span>{market.label}</span><b>Shop ↗</b></a>
      ))}
    </div>
  </section>

  <section class="section-block business">
    <div class="section-head"><p>05 / Business</p><h2>Build something with Roemah Koffie.</h2></div>
    <div class="business-grid">
      <a href={config.banquet.url} target="_blank" rel="noopener noreferrer"><span>Banquet & Catering</span><h3>Bring Roemah Koffie to your celebration.</h3><b>Start an inquiry ↗</b></a>
      <a href={config.franchise.url} target="_blank" rel="noopener noreferrer"><span>Franchise</span><h3>Explore a business opportunity with the brand.</h3><b>Explore franchise ↗</b></a>
    </div>
  </section>

  <footer class="rk-footer"><div><strong>ROEMAH KOFFIE</strong><span>{config.tagline}</span></div><div><a href={config.website} target="_blank" rel="noopener noreferrer">Official website ↗</a><a href={baseUrl}>Tangsel TradeLink</a></div></footer>
</main>

<style>
  :global(body){background:#180f0a}.rk-shell{--cream:#f4ead8;--ink:#1a100b;min-height:100vh;background:var(--cream);color:var(--ink);overflow:hidden}.hero{position:relative;min-height:100svh;padding:24px clamp(18px,4vw,62px) 0;background:linear-gradient(145deg,#1a0e09 0%,#2b160d 48%,#5b2517 100%);color:#fff6e8;overflow:hidden}.orb{position:absolute;border-radius:999px;opacity:.38;pointer-events:none}.orb-one{width:42vw;height:42vw;right:-12vw;top:-9vw;background:radial-gradient(circle,#f1a45f 0%,transparent 68%)}.orb-two{width:34vw;height:34vw;left:-14vw;bottom:5vw;background:radial-gradient(circle,#8c2e22 0%,transparent 70%)}.topbar{position:relative;z-index:2;display:flex;justify-content:space-between;gap:16px;align-items:center;font-size:.72rem;letter-spacing:.08em;text-transform:uppercase}.topbar a{color:inherit;text-decoration:none;font-weight:900}.topbar span{color:#d9bf9d;text-align:right}.hero-grid{position:relative;z-index:2;display:grid;grid-template-columns:minmax(0,1.18fr) minmax(280px,.82fr);gap:clamp(30px,7vw,110px);align-items:center;max-width:1360px;margin:8vh auto 0}.eyebrow,.section-head p{margin:0 0 16px;font-size:.72rem;font-weight:900;letter-spacing:.12em;text-transform:uppercase}.eyebrow{color:#e0a06c}h1{margin:0;font-size:clamp(4.5rem,10.8vw,10.5rem);line-height:.72;letter-spacing:-.075em;font-weight:900}h1 em{color:#e6b07c;font-family:Georgia,serif;font-weight:400}.tagline{max-width:540px;margin:30px 0 0;color:#d9c4ae;font-size:clamp(1rem,1.6vw,1.35rem);line-height:1.55}.primary-actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:32px}.primary{display:flex;align-items:center;gap:10px;padding:14px 18px;border:1px solid rgba(255,255,255,.18);border-radius:999px;background:#fff3df;color:#25130a;text-decoration:none;font-weight:900;box-shadow:0 18px 60px rgba(0,0,0,.18);transition:transform .25s ease}.primary:hover{transform:translateY(-3px)}.primary b{margin-left:6px}.primary.ghost{background:transparent;color:#fff3df}.social-row{display:flex;gap:10px;margin-top:18px}.social-row a{width:44px;height:44px;border-radius:50%;display:grid;place-items:center;background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.12)}.hero-card{justify-self:end;width:min(100%,420px);padding:12px;border-radius:36px;background:rgba(255,247,234,.08);border:1px solid rgba(255,255,255,.13);backdrop-filter:blur(18px);transform:rotate(2deg);box-shadow:0 40px 110px rgba(0,0,0,.36)}.image-wrap{aspect-ratio:1/1;border-radius:28px;overflow:hidden;background:#f2e3cd}.image-wrap img{width:100%;height:100%;object-fit:cover;display:block}.hero-card-copy{padding:20px 16px 16px}.hero-card-copy span{display:block;color:#d9b48e;font-size:.68rem;letter-spacing:.12em;text-transform:uppercase;font-weight:900}.hero-card-copy strong{display:block;margin-top:7px;font-size:1rem}.hero-card-copy p{margin:10px 0 0;color:#cfbaa5;font-size:.88rem;line-height:1.55}.marquee{position:relative;z-index:2;margin:8vh -5vw 0;border-top:1px solid rgba(255,255,255,.12);overflow:hidden;white-space:nowrap}.marquee div{width:max-content;padding:18px 0;font-weight:900;letter-spacing:.12em;color:#d7a576;animation:move 28s linear infinite}@keyframes move{to{transform:translateX(-50%)}}.section-block{max-width:1240px;margin:0 auto;padding:clamp(72px,10vw,140px) clamp(18px,4vw,44px)}.section-head{display:grid;grid-template-columns:180px 1fr;gap:30px;align-items:start;margin-bottom:42px}.section-head p{color:#8b5c3d;padding-top:9px}.section-head h2{margin:0;max-width:860px;font-family:Georgia,serif;font-size:clamp(2.3rem,5.6vw,5.4rem);line-height:.98;font-weight:400;letter-spacing:-.045em}.feature-grid{display:grid;grid-template-columns:1.2fr .8fr .8fr;gap:14px}.feature{min-height:310px;padding:28px;border:1px solid #d7c4aa;border-radius:28px;color:inherit;text-decoration:none;display:flex;flex-direction:column;background:#efe1ce;transition:transform .28s ease,box-shadow .28s ease}.feature:hover,.menu-card:hover,.business-grid a:hover{transform:translateY(-6px);box-shadow:0 28px 70px rgba(55,29,14,.12)}.feature-main{background:#6e2519;color:#fff2df;border-color:#6e2519}.feature span,.business-grid span,.menu-card small{font-size:.68rem;font-weight:900;letter-spacing:.12em;text-transform:uppercase;opacity:.72}.feature h3{margin:42px 0 14px;font-family:Georgia,serif;font-size:clamp(1.8rem,3vw,3rem);line-height:1;letter-spacing:-.035em}.feature p{max-width:330px;margin:0;line-height:1.5;opacity:.72}.feature b{margin-top:auto;padding-top:26px}.menus{background:#21120c;max-width:none;color:#f8eddc}.menus>*{max-width:1152px;margin-left:auto;margin-right:auto}.menus .section-head p{color:#d29163}.menu-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.menu-card{min-height:290px;padding:26px;border-radius:24px;background:linear-gradient(145deg,#3a1b11,#231109);border:1px solid rgba(255,255,255,.1);color:inherit;text-decoration:none;display:flex;flex-direction:column;transition:.28s ease}.menu-card h3{margin:auto 0 8px;font-size:clamp(2rem,4vw,4rem);font-family:Georgia,serif;font-weight:400}.menu-card span{color:#d6a377;font-weight:900}.location-list{border-top:1px solid #cdb89d}.location-list a{display:grid;grid-template-columns:55px 1fr auto 24px;align-items:center;gap:14px;padding:24px 2px;border-bottom:1px solid #cdb89d;color:inherit;text-decoration:none;transition:padding .2s ease,background .2s ease}.location-list a:hover{padding-left:12px;padding-right:12px;background:#ead9c4}.location-list span{color:#8b5c3d;font-size:.72rem;font-weight:900}.location-list strong{font-size:clamp(1.2rem,2.4vw,2rem);font-family:Georgia,serif;font-weight:400}.market-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.market-grid a{display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:12px;padding:22px;border:1px solid #cfb99b;border-radius:20px;color:inherit;text-decoration:none;background:#fff8eb}.market-grid span{font-weight:900}.market-grid b{font-size:.75rem}.business{padding-top:30px}.business-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:14px}.business-grid a{min-height:320px;padding:30px;border-radius:28px;background:#b96d3d;color:#21110a;text-decoration:none;display:flex;flex-direction:column;transition:.28s ease}.business-grid a:last-child{background:#451b14;color:#f7ead7}.business-grid h3{margin:56px 0 20px;max-width:470px;font-family:Georgia,serif;font-size:clamp(2rem,4vw,4rem);font-weight:400;line-height:1;letter-spacing:-.04em}.business-grid b{margin-top:auto}.rk-footer{display:flex;justify-content:space-between;gap:24px;padding:54px clamp(18px,4vw,62px);background:#180f0a;color:#ead6bd}.rk-footer div{display:flex;flex-direction:column;gap:7px}.rk-footer strong{letter-spacing:.08em}.rk-footer span{color:#9f846b;font-size:.8rem}.rk-footer a{color:inherit;text-decoration:none;font-size:.8rem;font-weight:800}@media(max-width:850px){.hero{min-height:auto}.hero-grid{grid-template-columns:1fr;margin-top:9vh}.hero-card{justify-self:start;width:min(86vw,400px);margin:0 0 20px auto}.feature-grid,.menu-grid,.market-grid,.business-grid{grid-template-columns:1fr}.feature{min-height:230px}.section-head{grid-template-columns:1fr;gap:6px}}@media(max-width:520px){.topbar{align-items:flex-start}.topbar span{max-width:160px}h1{font-size:21vw}.hero-card{width:100%;margin:20px 0 0;transform:none}.primary-actions{display:grid;grid-template-columns:1fr}.primary{justify-content:flex-start}.location-list a{grid-template-columns:34px 1fr 24px}.location-list a :global(.brand-icon){display:none}.rk-footer{flex-direction:column}}@media(prefers-reduced-motion:reduce){.marquee div{animation:none}.feature,.menu-card,.business-grid a,.primary{transition:none}}
</style>
