---
import BrandIcon from './BrandIcon.astro';

interface Props {
  tenant: Record<string, any>;
  config: Record<string, any>;
  baseUrl?: string;
}

const { tenant, config, baseUrl = '' } = Astro.props;
const normalizedBase = String(baseUrl).replace(/\/$/, '');
const resolveAsset = (src?: string) =>
  src?.startsWith('/brand/') ? `${normalizedBase}${src}` : src;
const resolveLink = (url?: string) =>
  url?.startsWith('/') && !url.startsWith('//') ? `${normalizedBase}${url}` : url;

const heroImage = resolveAsset(config.heroImage);
const emblemSvg = resolveAsset('/brand/vietrade/vietnam-emblem.svg');
const officer = config.officer || {};
const corridors = config.exportCorridors || [];
const vietnamValue = config.vietnamValue || {};
const tradeAgenda = config.tradeAgenda || [];
const gallery = config.gallery || [];
const actions = config.actions || [];
const verification = config.verification || {};
---

<main class="diplomatic-showcase" id="main-content">
  <!-- Top Sovereign Header Bar -->
  <header class="gov-topbar">
    <div class="gov-topbar-inner">
      <div class="gov-crest-brand">
        <img src={emblemSvg} alt="Quốc huy Việt Nam" class="national-crest" width="38" height="38" loading="eager" />
        <div class="gov-titles">
          <span class="gov-sup">BỘ CÔNG THƯƠNG · VIỆT NAM</span>
          <strong class="gov-sub">CỤC XÚC TIẾN THƯƠNG MẠI · VIETRADE</strong>
        </div>
      </div>

      <div class="gov-topbar-right">
        <span class="mission-tag">TEI 2026 · Hall {tenant.hall || '8'} · Booth {tenant.booth || '8-7C'}</span>
        <a href={baseUrl || '/'} class="back-link">Tangsel TradeLink ↗</a>
      </div>
    </div>
  </header>

  <!-- Hero Section -->
  <section class="diplomatic-hero" aria-labelledby="diplomatic-title">
    <div class="hero-backdrop" aria-hidden="true">
      <img src={resolveAsset('/brand/vietrade/vietrade-hq-hanoi.webp')} alt="" class="hero-bg-img" />
      <div class="hero-gradient-overlay"></div>
    </div>

    <div class="hero-content">
      <div class="delegation-chip">
        <span class="pulse-indicator"></span>
        <span>OFFICIAL STATE TRADE MISSION · TRADE EXPO INDONESIA 2026</span>
      </div>

      <p class="hero-kicker">CỘNG HÒA XÃ HỘI CHỦ NGHĨA VIỆT NAM</p>
      <h1 id="diplomatic-title" class="hero-headline">
        VIETNAM TRADE<br />
        <span class="gold-gradient-text">PROMOTION AGENCY</span>
      </h1>
      <p class="hero-viet-title">CỤC XÚC TIẾN THƯƠNG MẠI · BỘ CÔNG THƯƠNG</p>
      
      <p class="hero-desc">
        {config.tagline || 'Official National Trade Promotion Delegation · Ministry of Industry and Trade of Vietnam.'}
      </p>

      <!-- Quick Diplomatic Actions -->
      <div class="hero-cta-group">
        <a href={officer.zalo || 'https://zalo.me/84828807986'} target="_blank" rel="noopener noreferrer" class="btn-diplomatic btn-gold">
          <BrandIcon name="zalo" />
          <span>Connect Zalo Official</span>
          <b aria-hidden="true">↗</b>
        </a>
        <a href={officer.whatsapp || 'https://wa.me/84828807986'} target="_blank" rel="noopener noreferrer" class="btn-diplomatic btn-outline">
          <BrandIcon name="whatsapp" />
          <span>WhatsApp Direct Desk</span>
          <b aria-hidden="true">↗</b>
        </a>
        <a href={resolveAsset(officer.vcard || '/brand/vietrade/tam-trang-vietrade.vcf')} download="tam-trang-vietrade.vcf" class="btn-diplomatic btn-vcard">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
          <span>Save Contact (.vcf)</span>
        </a>
      </div>

      <!-- Quick Metrics Ribbon -->
      <div class="hero-stats-ribbon">
        {(config.stats || []).map((s:any) => (
          <div class="stat-cell">
            <strong>{s.value}</strong>
            <span>{s.label}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Executive NFC Card Section: Tâm Trang -->
  <section class="section-nfc-card" id="executive-card" aria-labelledby="officer-name">
    <div class="section-container">
      <div class="section-eyebrow-center">
        <span class="gold-badge">DIPLOMATIC CREDENTIAL</span>
        <h2>Official Delegation Trade Representative</h2>
        <p>Bilateral sourcing matchmaking, factory due diligence, and sovereign trade linkage at TEI 2026.</p>
      </div>

      <div class="card-executive-layout">
        <!-- Physical NFC Smart Card Visual Showcase -->
        <div class="card-visual-column">
          <div class="smart-card-perspective">
            <figure class="nfc-card-frame">
              <img
                src={resolveAsset('/brand/vietrade/vietrade-card-front.webp')}
                alt="Executive NFC Touch Card — Nguyễn Tâm Trang (VIETRADE)"
                width="1200"
                height="750"
                loading="eager"
                class="nfc-card-image"
                id="active-nfc-card"
              />
              <div class="nfc-card-sheen" aria-hidden="true"></div>
            </figure>
          </div>
          <!-- Language & side switcher for authentic delegation card -->
          <div class="card-sides-toolbar" role="tablist" aria-label="Business Card Language">
            <span class="toolbar-label">Official Card:</span>
            <button type="button" class="btn-side is-active js-switch-side" data-side-img={resolveAsset('/brand/vietrade/vietrade-card-en.webp')} aria-selected="true">English (International)</button>
            <button type="button" class="btn-side js-switch-side" data-side-img={resolveAsset('/brand/vietrade/vietrade-card-vi.webp')} aria-selected="false">Tiếng Việt</button>
            <button type="button" class="btn-side js-switch-side" data-side-img={resolveAsset('/brand/vietrade/vietrade-card-dual.webp')} aria-selected="false">Dual View</button>
          </div>
          <div class="nfc-tap-guidance">
            <span class="nfc-icon-wave">📡</span>
            <p><strong>NFC SMART TOUCH READY:</strong> Tap delegation physical card against your mobile phone to instantly sync trade credentials.</p>
          </div>
        </div>

        <!-- Executive Detail Dossier -->
        <div class="officer-dossier">
          <div class="officer-header">
            <div class="officer-avatar-wrap">
              <img
                src={resolveAsset(officer.avatar || '/brand/vietrade/tam-trang-avatar.webp')}
                alt={officer.name || 'Nguyễn Tâm Trang'}
                width="110"
                height="110"
                class="officer-avatar"
              />
              <span class="officer-status-badge" title="Official Delegate on Site">✓</span>
            </div>
            <div class="officer-identity">
              <div class="badge-role">{officer.badge || 'Official State Delegate · TEI 2026'}</div>
              <h3 id="officer-name">{officer.name || 'Nguyễn Tâm Trang'}</h3>
              <p class="officer-title-vi">{officer.titleVi || 'Phòng Đào tạo & Hỗ trợ kinh doanh'}</p>
              <p class="officer-title-en">{officer.title || 'Training and Sales Support Division'}</p>
              <p class="officer-agency">{officer.agency || 'Export Promotion Center (PROMOCEN)'} · {officer.organization || 'VIETRADE'}</p>
            </div>
          </div>

          <div class="officer-contact-matrix">
            <div class="contact-entry">
              <span class="contact-label">Mobile / WhatsApp / Zalo</span>
              <a href={`tel:${officer.phone}`} class="contact-val highlight-gold">{officer.phone || '+84 82 880 7986'}</a>
            </div>
            <div class="contact-entry">
              <span class="contact-label">Hanoi Office Tel & Fax</span>
              <span class="contact-val">{officer.officeTel || '84-43 936 4791 (Ext: 118)'} · Fax: {officer.fax || '84-43 936 4793'}</span>
            </div>
            <div class="contact-entry">
              <span class="contact-label">Official Ministry Email</span>
              <a href={`mailto:${officer.email}`} class="contact-val">{officer.email || 'tamtrang.vietrade@gmail.com'}</a>
            </div>
            <div class="contact-entry">
              <span class="contact-label">Headquarters Office & Stand</span>
              <span class="contact-val">{officer.officeAddress || 'Tầng 7, 20 Lý Thường Kiệt, Hà Nội'} · {officer.location || 'TEI 2026 Booth 8-7C'}</span>
            </div>
          </div>

          <!-- Dossier Actions -->
          <div class="officer-actions-grid">
            <a href={resolveAsset(officer.vcard || '/brand/vietrade/tam-trang-vietrade.vcf')} download="tam-trang-vietrade.vcf" class="btn-dossier btn-primary-gold btn-full-row">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
              <span>Save Contact to Phone (.vcf)</span>
            </a>
            <button type="button" class="btn-dossier btn-secondary js-open-qr" aria-haspopup="dialog">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
              <span>Show Delegate QR</span>
            </button>
            <a href={officer.zalo || 'https://zalo.me/84828807986'} target="_blank" rel="noopener noreferrer" class="btn-dossier btn-zalo">
              <BrandIcon name="zalo" />
              <span>Zalo Official</span>
            </a>
            <a href={officer.whatsapp || 'https://wa.me/84828807986'} target="_blank" rel="noopener noreferrer" class="btn-dossier btn-wa">
              <BrandIcon name="whatsapp" />
              <span>WhatsApp Desk</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 4 Strategic Export Corridors -->
  <section class="section-corridors" id="export-corridors" aria-labelledby="corridors-title">
    <div class="section-container">
      <div class="section-eyebrow-center">
        <span class="gold-badge">NATIONAL INDUSTRIAL CORRIDORS</span>
        <h2 id="corridors-title">4 Strategic Export Corridors of Vietnam</h2>
        <p>Authoritative trade channels connecting accredited Vietnamese manufacturing hubs with Indonesian & ASEAN buyers.</p>
      </div>

      <div class="corridors-grid">
        {corridors.map((corridor:any, index:number) => (
          <article class="corridor-card" data-corridor-id={corridor.id}>
            <div class="corridor-img-wrap">
              <img
                src={resolveAsset(corridor.image)}
                alt={corridor.name}
                width="800"
                height="530"
                decoding="async"
                class="corridor-img"
              />
              <span class="corridor-number">0{index + 1}</span>
              <span class="corridor-tag">{corridor.tag}</span>
            </div>
            <div class="corridor-body">
              <h3>{corridor.name}</h3>
              <p class="corridor-sub">{corridor.subtitle}</p>
              <ul class="corridor-bullets">
                {(corridor.highlights || []).map((h:string) => (
                  <li>
                    <span class="check-gold">✓</span>
                    <span>{h}</span>
                  </li>
                ))}
              </ul>
              <div class="corridor-footer">
                <a
                  href={`mailto:${officer.email}?subject=Inquiry:%20${encodeURIComponent(corridor.name)}%20(TEI%202026)`}
                  class="corridor-inquiry-link"
                >
                  <span>Request Sourcing Dossier</span>
                  <b aria-hidden="true">→</b>
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Vietnam Value (Thương hiệu Quốc gia) Profile -->
  <section class="section-vietnam-value" aria-labelledby="value-title">
    <div class="section-container">
      <div class="value-layout">
        <div class="value-media-col">
          <figure class="value-brand-card">
            <img
              src={resolveAsset('/brand/vietrade/vietnam-value-brand.webp')}
              alt="Vietnam Value — Thương hiệu Quốc gia Việt Nam"
              width="1200"
              height="800"
              loading="lazy"
              class="value-brand-img"
            />
          </figure>
          <div class="value-accreditation-quote">
            <p>“The Vietnam National Brand program (Vietnam Value) is the only governmental brand development initiative approved by the Prime Minister and entrusted to the Ministry of Industry and Trade to champion national industrial competitiveness.”</p>
            <cite>— Ministry of Industry and Trade of Vietnam (MOIT)</cite>
          </div>
        </div>

        <div class="value-copy-col">
          <span class="gold-badge">NATIONAL ACCREDITATION</span>
          <h2 id="value-title">{vietnamValue.title || 'Chương trình Thương hiệu Quốc gia Việt Nam'}</h2>
          <p class="value-intro">{vietnamValue.description}</p>

          <div class="pillars-stack">
            {(vietnamValue.pillars || []).map((p:any, i:number) => (
              <div class="pillar-card">
                <div class="pillar-num">0{i + 1}</div>
                <div class="pillar-text">
                  <h4>{p.title}</h4>
                  <p>{p.desc}</p>
                </div>
              </div>
            ))}
          </div>

          <div class="value-cta-wrap">
            <a href="http://www.vietrade.gov.vn" target="_blank" rel="noopener noreferrer" class="btn-diplomatic btn-gold">
              <BrandIcon name="website" />
              <span>Explore Certified National Brand Enterprises</span>
              <b aria-hidden="true">↗</b>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Official Trade Agenda & Vietnam Expo 2026 -->
  <section class="section-agenda" aria-labelledby="agenda-title">
    <div class="section-container">
      <div class="section-eyebrow-center">
        <span class="gold-badge">ANNUAL TRADE CALENDAR</span>
        <h2 id="agenda-title">Official Vietnam Trade Fairs & Overseas Pavilions</h2>
        <p>Key bilateral exhibition platforms managed by VIETRADE for international buyers and regional importers.</p>
      </div>

      <div class="agenda-grid">
        {tradeAgenda.map((item:any, index:number) => (
          <article class="agenda-card">
            <div class="agenda-time-chip">
              <span class="agenda-cal-icon">📅</span>
              <span>{item.date}</span>
            </div>
            <h3>{item.event}</h3>
            <p>{item.scope}</p>
            <div class="agenda-footer">
              <span class="delegation-organizer">Organized by VIETRADE · MOIT</span>
              <a href="http://www.vietrade.gov.vn" target="_blank" rel="noopener noreferrer" class="agenda-link">Official Portal ↗</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Institutional Photo Gallery & Headquarters (5 verified items) -->
  <section class="section-gallery" aria-labelledby="gallery-title">
    <div class="section-container">
      <div class="section-heading-split">
        <div>
          <span class="gold-badge">INSTITUTIONAL ARCHIVES</span>
          <h2 id="gallery-title">Official Facilities & State Operations</h2>
        </div>
        <p class="heading-aside-text">Photographic records of VIETRADE executive headquarters, national trade pavilions, and certified industrial operations.</p>
      </div>

      <div class="gallery-grid">
        {gallery.map((g:any) => (
          <figure class="gallery-item js-gallery-lightbox" data-full-img={resolveAsset(g.image)} data-caption={`${g.label} — ${g.caption}`}>
            <div class="gallery-item-wrap">
              <img src={resolveAsset(g.image)} alt={g.label} width="800" height="530" loading="lazy" decoding="async" />
              <div class="gallery-item-overlay">
                <span class="zoom-icon">🔍 View Full Size</span>
              </div>
            </div>
            <figcaption>
              <strong>{g.label}</strong>
              <small>{g.caption}</small>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- Official Direct Desks & Verification Ledger -->
  <section class="section-channels" aria-labelledby="channels-title">
    <div class="section-container">
      <div class="section-eyebrow-center">
        <span class="gold-badge">DIRECT CHANNELS</span>
        <h2 id="channels-title">Official Bilateral Trade Links</h2>
        <p>Communicate directly with the Vietnamese trade delegation without intermediation.</p>
      </div>

      <div class="channels-grid">
        {actions.map((act:any) => (
          <a href={resolveLink(act.url)} target="_blank" rel="noopener noreferrer" class="channel-card">
            <BrandIcon name={act.key} />
            <div class="channel-info">
              <strong>{act.label}</strong>
              <span class="channel-url">{act.url}</span>
            </div>
            <span class="channel-arrow">↗</span>
          </a>
        ))}
      </div>

      <!-- Verification Seal Box -->
      <div class="verification-seal-box">
        <div class="seal-header">
          <span class="seal-icon">🏛️</span>
          <div>
            <strong>STATE GOVERNMENT AUTHORITATIVE ACCREDITATION</strong>
            <p>Verified against official government records of the Ministry of Industry and Trade (MOIT Vietnam).</p>
          </div>
          <span class="status-verified-chip">✓ {verification.status || 'verified-authoritative'}</span>
        </div>
        <p class="seal-note">{verification.note}</p>
        <div class="sources-list">
          <span>Authoritative Primary Proofs:</span>
          {(verification.sources || []).map((s:any) => (
            <a href={s.url} target="_blank" rel="noopener noreferrer" class="source-tag">{s.label} ↗</a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Diplomatic Sovereign Footer -->
  <footer class="diplomatic-footer">
    <div class="footer-container">
      <div class="footer-top">
        <div class="footer-emblem-wrap">
          <img src={emblemSvg} alt="Quốc huy Việt Nam" width="48" height="48" />
          <div>
            <strong>BỘ CÔNG THƯƠNG · CỤC XÚC TIẾN THƯƠNG MẠI</strong>
            <p>VIETNAM TRADE PROMOTION AGENCY (VIETRADE)</p>
          </div>
        </div>
        <div class="footer-location">
          <span>Trụ sở chính (Headquarters):</span>
          <address>Số 20 Lý Thường Kiệt, P. Phan Chu Trinh, Q. Hoàn Kiếm, TP. Hà Nội, Vietnam</address>
        </div>
      </div>
      <div class="footer-bottom">
        <p>© 2026 VIETRADE — Ministry of Industry and Trade of the Socialist Republic of Vietnam.</p>
        <div class="footer-links">
          <a href={baseUrl || '/'}>Tangsel TradeLink Directory</a>
          <span>·</span>
          <a href="http://www.vietrade.gov.vn" target="_blank" rel="noopener noreferrer">vietrade.gov.vn</a>
        </div>
      </div>
    </div>
  </footer>

  <!-- Mobile Floating Quick Contact Bar -->
  <div class="mobile-delegation-bar" aria-label="Mobile quick trade contacts">
    <a href={resolveAsset(officer.vcard || '/brand/vietrade/tam-trang-vietrade.vcf')} download="tam-trang-vietrade.vcf" class="mob-btn mob-vcard">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
      <span>Save vCard</span>
    </a>
    <a href={officer.zalo || 'https://zalo.me/84828807986'} target="_blank" rel="noopener noreferrer" class="mob-btn mob-zalo">
      <BrandIcon name="zalo" />
      <span>Zalo</span>
    </a>
    <a href={officer.whatsapp || 'https://wa.me/84828807986'} target="_blank" rel="noopener noreferrer" class="mob-btn mob-wa">
      <BrandIcon name="whatsapp" />
      <span>WhatsApp</span>
    </a>
  </div>

  <!-- QR Code Dialog Modal -->
  <dialog id="qr-dialog" class="diplomatic-dialog" aria-labelledby="qr-modal-title">
    <div class="dialog-card">
      <button type="button" class="dialog-close js-close-qr" aria-label="Close dialog">✕</button>
      <div class="dialog-crest">
        <img src={emblemSvg} alt="" width="36" height="36" />
        <span class="dialog-kicker">CỤC XÚC TIẾN THƯƠNG MẠI</span>
      </div>
      <h3 id="qr-modal-title">Tâm Trang · VIETRADE</h3>
      <p class="dialog-sub">Trade Promotion Officer · Trade Expo Indonesia 2026</p>
      
      <figure class="dialog-qr-wrap">
        <img src={resolveAsset(officer.qrCode || '/brand/vietrade/vietrade-qr.png')} alt="Tâm Trang VIETRADE QR Code" width="220" height="220" />
      </figure>

      <p class="dialog-hint">Scan with camera to open official delegation showcase & instant contact links.</p>

      <div class="dialog-actions">
        <a href={resolveAsset(officer.vcard || '/brand/vietrade/tam-trang-vietrade.vcf')} download="tam-trang-vietrade.vcf" class="btn-diplomatic btn-gold" style="width:100%;justify-content:center;">
          Download vCard (.vcf)
        </a>
      </div>
    </div>
  </dialog>

  <!-- Gallery Lightbox Modal -->
  <dialog id="gallery-dialog" class="diplomatic-dialog lightbox-dialog" aria-label="Full size institutional image">
    <div class="lightbox-inner">
      <button type="button" class="lightbox-close js-close-gallery" aria-label="Close image">✕</button>
      <img id="lightbox-img" src="" alt="" />
      <p id="lightbox-cap"></p>
    </div>
  </dialog>
</main>

<script>
  function initDiplomaticInteractions() {
    // Card Side Switcher
    const activeCard = document.getElementById('active-nfc-card') as HTMLImageElement | null;
    const switchBtns = document.querySelectorAll<HTMLButtonElement>('.js-switch-side');
    switchBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const src = btn.getAttribute('data-side-img');
        if (activeCard && src) {
          activeCard.src = src;
          switchBtns.forEach(b => {
            b.classList.remove('is-active');
            b.setAttribute('aria-selected', 'false');
          });
          btn.classList.add('is-active');
          btn.setAttribute('aria-selected', 'true');
        }
      });
    });

    // QR Modal
    const qrDialog = document.getElementById('qr-dialog') as HTMLDialogElement | null;
    document.querySelectorAll('.js-open-qr').forEach(btn => {
      btn.addEventListener('click', () => qrDialog?.showModal());
    });
    document.querySelectorAll('.js-close-qr').forEach(btn => {
      btn.addEventListener('click', () => qrDialog?.close());
    });
    qrDialog?.addEventListener('click', (e) => {
      if (e.target === qrDialog) qrDialog.close();
    });

    // Gallery Lightbox
    const galleryDialog = document.getElementById('gallery-dialog') as HTMLDialogElement | null;
    const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement | null;
    const lightboxCap = document.getElementById('lightbox-cap');

    document.querySelectorAll('.js-gallery-lightbox').forEach(item => {
      item.addEventListener('click', () => {
        const full = item.getAttribute('data-full-img');
        const cap = item.getAttribute('data-caption') || '';
        if (lightboxImg && full) lightboxImg.src = full;
        if (lightboxCap) lightboxCap.textContent = cap;
        galleryDialog?.showModal();
      });
    });

    document.querySelectorAll('.js-close-gallery').forEach(btn => {
      btn.addEventListener('click', () => galleryDialog?.close());
    });
    galleryDialog?.addEventListener('click', (e) => {
      if (e.target === galleryDialog) galleryDialog.close();
    });
  }

  if (typeof document !== 'undefined') {
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initDiplomaticInteractions);
    } else {
      initDiplomaticInteractions();
    }
    document.addEventListener('astro:page-load', initDiplomaticInteractions);
  }
</script>

