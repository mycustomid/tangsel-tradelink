---
import TenantMeta from './TenantMeta.astro';

interface Props {
  name: string;
  category?: string;
  hall?: string;
  booth?: string;
  description?: string;
  logo?: string;
}

const {
  name,
  category = '',
  hall = '',
  booth = '',
  description = '',
  logo = '',
} = Astro.props;
const monogram = name.trim().charAt(0).toUpperCase() || 'T';
---

<header class="tenant-header">
  <div class="brand-row">
    <div class="logo-wrap" aria-hidden={Boolean(logo) ? undefined : 'true'}>
      {logo ? <img src={logo} alt={`Logo ${name}`} loading="eager" /> : <span>{monogram}</span>}
    </div>
    <div class="brand-copy">
      <p class="eyebrow">Trade Expo Indonesia 2026</p>
      <h1>{name}</h1>
    </div>
  </div>

  <TenantMeta category={category} hall={hall} booth={booth} />
  {description && <p class="description">{description}</p>}
</header>

<style>
  .tenant-header {
    display: grid;
    gap: 18px;
    padding: 24px;
    border: 1px solid rgba(255,255,255,.66);
    border-radius: 28px;
    background:
      radial-gradient(circle at top right, rgba(255,255,255,.75), transparent 32%),
      linear-gradient(135deg, var(--hero-a), var(--hero-b));
    box-shadow: var(--shadow);
  }

  .brand-row {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .logo-wrap {
    flex: 0 0 68px;
    width: 68px;
    height: 68px;
    display: grid;
    place-items: center;
    overflow: hidden;
    border-radius: 20px;
    background: rgba(255,255,255,.82);
    border: 1px solid rgba(255,255,255,.9);
    box-shadow: 0 10px 28px rgba(16,32,51,.09);
    font-size: 1.55rem;
    font-weight: 900;
    color: var(--accent-strong);
  }

  .logo-wrap img { width: 100%; height: 100%; object-fit: contain; padding: 8px; }
  .brand-copy { min-width: 0; }
  h1 { margin: 0; font-size: clamp(1.7rem, 8vw, 2.65rem); line-height: .98; letter-spacing: -.045em; }
  .description { margin: 0; color: #415367; line-height: 1.65; }

  @media (max-width: 430px) {
    .tenant-header { padding: 20px; border-radius: 24px; }
    .logo-wrap { flex-basis: 58px; width: 58px; height: 58px; border-radius: 17px; }
  }
</style>
