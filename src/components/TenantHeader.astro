---
import TenantMeta from './TenantMeta.astro';
interface Props { name: string; category?: string; hall?: string; booth?: string; description?: string; logo?: string; researchStatus?: string; verifiedAt?: string }
const { name, category = '', hall = '', booth = '', description = '', logo = '', researchStatus = '', verifiedAt = '' } = Astro.props;
const monogram = name.trim().charAt(0).toUpperCase() || 'T';
const verified = researchStatus === 'web-verified';
---

<header class="tenant-header">
  <div class="brand-row">
    <div class="logo-wrap">
      {logo ? <img src={logo} alt={`Logo ${name}`} loading="eager" decoding="async" /> : <span aria-hidden="true">{monogram}</span>}
    </div>
    <div class="brand-copy">
      <p class="eyebrow">TEI 2026 · Digital Booth Card</p>
      <h1>{name}</h1>
      {verified && <span class="verified">✓ Public profile verified {verifiedAt ? `· ${verifiedAt}` : ''}</span>}
    </div>
  </div>
  <TenantMeta category={category} hall={hall} booth={booth} />
  {description && <p class="description">{description}</p>}
</header>

<style>
  .tenant-header { display: grid; gap: 18px; padding: 24px; border: 1px solid rgba(255,255,255,.66); border-radius: 28px; background: radial-gradient(circle at top right, rgba(255,255,255,.8), transparent 34%), linear-gradient(135deg, var(--hero-a), var(--hero-b)); box-shadow: var(--shadow); }
  .brand-row { display: flex; align-items: center; gap: 16px; }
  .logo-wrap { flex: 0 0 76px; width: 76px; height: 76px; display: grid; place-items: center; overflow: hidden; border-radius: 21px; background: rgba(255,255,255,.92); border: 1px solid rgba(255,255,255,.95); box-shadow: 0 10px 28px rgba(16,32,51,.09); font-size: 1.65rem; font-weight: 900; color: var(--accent-strong); }
  .logo-wrap img { width: 100%; height: 100%; object-fit: contain; padding: 9px; }
  .brand-copy { min-width: 0; }
  .eyebrow { margin: 0 0 6px; color: var(--accent-strong); font-size: .72rem; font-weight: 900; letter-spacing: .08em; text-transform: uppercase; }
  h1 { margin: 0; font-size: clamp(1.7rem, 8vw, 2.65rem); line-height: .98; letter-spacing: -.045em; }
  .verified { display: inline-flex; margin-top: 9px; font-size: .7rem; font-weight: 800; color: #236c51; background: rgba(255,255,255,.62); padding: 5px 8px; border-radius: 999px; }
  .description { margin: 0; color: #415367; line-height: 1.65; }
  @media (max-width: 430px) { .tenant-header { padding: 20px; border-radius: 24px; } .logo-wrap { flex-basis: 64px; width: 64px; height: 64px; border-radius: 18px; } }
</style>
