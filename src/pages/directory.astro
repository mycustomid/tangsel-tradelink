---
import BaseLayout from '../layouts/BaseLayout.astro';
import tenants from '../data/tenants.json';
import tenantExtras from '../data/tenants-extra.json';
import { uniqueValues } from '../lib/tenant-utils.mjs';
import '../styles/discovery-editorial.css';
import type { Tenant } from '../types/tenant';
import { discoveryProfiles } from '../data/discovery-profiles.mjs';

const rawList = discoveryProfiles;
const seenSlugs = new Set<string>();
const tenantList = rawList.filter((tenant) => {
  if (!tenant.slug || seenSlugs.has(tenant.slug)) return false;
  seenSlugs.add(tenant.slug);
  return true;
});
const categories = uniqueValues(tenantList, 'category');
const halls = uniqueValues(tenantList, 'hall');
const rawBaseUrl = import.meta.env.BASE_URL;
const baseUrl = rawBaseUrl.endsWith('/') ? rawBaseUrl : `${rawBaseUrl}/`;

function getInitials(name: string) {
  const clean = name.replace(/^(pt\.?|cv\.?|ud\.?)\s*/i, '').trim();
  const words = clean.split(/\s+/).filter(Boolean);
  return (words.length > 1 ? `${words[0][0]}${words[1][0]}` : clean.slice(0,2)).toUpperCase();
}
const pageDescription = `Cari ${tenantList.length} profil bisnis Trade Expo Indonesia 2026 berdasarkan sektor, hall, booth, atau nama tenant.`;
---

<BaseLayout title={`Business Directory — ${tenantList.length} Profiles · Tangsel TradeLink`} description={pageDescription}>
  <main class="directory-page">
    <header class="discovery-nav discovery-shell">
      <a class="discovery-brand" href={baseUrl}><strong>Tangsel TradeLink</strong><span>TEI / 2026</span></a>
      <nav aria-label="Navigasi utama">
        <a href={baseUrl}>Overview</a>
        <a href={`${baseUrl}directory`} aria-current="page">Directory</a>
        <a href={`${baseUrl}guide`}>Hall guide</a>
      </nav>
    </header>

    <section class="directory-hero discovery-shell" aria-labelledby="directory-title">
      <div>
        <span class="directory-kicker">Business discovery / {tenantList.length} published profiles</span>
        <h1 id="directory-title">Find the right conversation.</h1>
      </div>
      <p class="directory-intro">Dari produsen pangan hingga studio kriya. Cari produk yang Anda butuhkan, temukan lokasinya, lalu kenali bisnisnya sebelum memulai percakapan.</p>
    </section>

    <section class="directory-controls-wrap" aria-label="Pencarian dan filter tenant">
      <div class="controls-card discovery-shell">
        <div class="search-row">
          <div class="search-input-box">
            <input type="search" data-search autocomplete="off" placeholder="Search business, product, hall or booth…" aria-label="Cari tenant" />
            <button type="button" class="clear-btn" data-clear aria-label="Hapus pencarian" hidden>×</button>
          </div>
          <div class="counter-badge" data-count aria-live="polite">{tenantList.length} profiles</div>
        </div>
        <div class="filter-rails">
          <div class="filter-group">
            <span class="filter-label">Sector</span>
            <div class="chips-scroll" role="group" aria-label="Filter kategori">
              <button type="button" class="chip active" data-cat-filter="" aria-pressed="true">All sectors</button>
              {categories.map((category) => <button type="button" class="chip" data-cat-filter={category.toLowerCase()} aria-pressed="false">{category}</button>)}
            </div>
          </div>
          <div class="filter-group">
            <span class="filter-label">Hall</span>
            <div class="chips-scroll" role="group" aria-label="Filter hall">
              <button type="button" class="chip active" data-hall-filter="" aria-pressed="true">All halls</button>
              {halls.map((hall) => <button type="button" class="chip" data-hall-filter={hall.toLowerCase()} aria-pressed="false">Hall {hall}</button>)}
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="tenant-grid-wrap discovery-shell" data-results data-view="list" aria-labelledby="results-title">
      <div class="results-head">
        <div><span class="result-count">Live results</span><h2 id="results-title">Business profiles</h2></div>
        <div class="result-tools">
          <span class="result-count" data-count-secondary>{tenantList.length} shown</span>
          <div class="view-toggle" aria-label="Tampilan hasil">
            <button type="button" data-view-toggle="list" aria-pressed="true">List</button>
            <button type="button" data-view-toggle="grid" aria-pressed="false">Grid</button>
          </div>
        </div>
      </div>

      <div class="tenant-grid" data-list>
        {tenantList.map((tenant, index) => {
          const searchable = tenant.searchable;
          return (
            <a
              class="tenant-card"
              href={`${baseUrl}tenant/${tenant.slug}/`}
              data-tenant-card
              data-searchable={searchable}
              data-category={(tenant.category || '').toLowerCase()}
              data-hall={(tenant.hall || '').toLowerCase()}
            >
              <div class="tenant-avatar" aria-hidden="true">{getInitials(tenant.name)}</div>
              <div>
                <span class="profile-index">{String(index + 1).padStart(3,'0')}</span>
                <h3 class="tenant-name">{tenant.name}</h3>
                {tenant.description && <p class="tenant-preview">{tenant.description}</p>}
              </div>
              <div class="tenant-category">{tenant.category || 'Trade Expo Indonesia 2026'}</div>
              <div class="tenant-location">{tenant.hall ? `Hall ${tenant.hall}` : 'TEI 2026'}{tenant.booth ? ` · ${tenant.booth}` : ''}</div>
              <div class="tenant-arrow" aria-hidden="true">↗</div>
            </a>
          );
        })}
      </div>

      <div class="empty-results-box" data-no-results hidden>
        <h3>No matching profile.</h3>
        <p>Kurangi filter atau gunakan nama bisnis yang lebih pendek.</p>
        <button type="button" class="reset-filter-btn" data-reset>Reset search & filters</button>
      </div>
    </section>

    <footer class="discovery-footer discovery-shell">
      <div><strong>Tangsel TradeLink</strong><br/>Trade Expo Indonesia 2026</div>
      <div>{tenantList.length} business profiles · Trade Expo Indonesia 2026</div>
      <a href={`${baseUrl}guide`}>Hall guide ↗</a>
    </footer>
  </main>

  <script>
    import { normalizeSearch } from '../lib/discovery.mjs';
    const searchInput = document.querySelector<HTMLInputElement>('[data-search]');
    const clearBtn = document.querySelector<HTMLButtonElement>('[data-clear]');
    const catChips = [...document.querySelectorAll<HTMLButtonElement>('[data-cat-filter]')];
    const hallChips = [...document.querySelectorAll<HTMLButtonElement>('[data-hall-filter]')];
    const cards = [...document.querySelectorAll<HTMLElement>('[data-tenant-card]')];
    const countBadges = [...document.querySelectorAll<HTMLElement>('[data-count], [data-count-secondary]')];
    const noResults = document.querySelector<HTMLElement>('[data-no-results]');
    const resetBtn = document.querySelector<HTMLButtonElement>('[data-reset]');
    const resultsWrap = document.querySelector<HTMLElement>('[data-results]');
    const viewButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-view-toggle]')];

    const params = new URLSearchParams(window.location.search);
    let activeCategory = (params.get('sector') || '').toLowerCase();
    let activeHall = (params.get('hall') || '').toLowerCase();
    let activeView = params.get('view') === 'grid' ? 'grid' : 'list';
    if (searchInput) searchInput.value = params.get('q') || '';

    function markActive(buttons: HTMLButtonElement[], key: 'catFilter' | 'hallFilter', value: string) {
      const values = new Set(buttons.map((button) => button.dataset[key] || ''));
      const normalized = values.has(value) ? value : '';
      buttons.forEach((button) => {
        const active = (button.dataset[key] || '') === normalized;
        button.classList.toggle('active', active);
        button.setAttribute('aria-pressed', String(active));
      });
      return normalized;
    }

    function syncUrl(query: string) {
      const next = new URLSearchParams();
      if (query) next.set('q', query);
      if (activeCategory) next.set('sector', activeCategory);
      if (activeHall) next.set('hall', activeHall);
      if (activeView !== 'list') next.set('view', activeView);
      const suffix = next.toString();
      history.replaceState(null, '', `${location.pathname}${suffix ? `?${suffix}` : ''}`);
    }

    function setView(view: string) {
      activeView = view === 'grid' ? 'grid' : 'list';
      if (resultsWrap) resultsWrap.dataset.view = activeView;
      viewButtons.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.viewToggle === activeView)));
    }

    function filterTenants() {
      const query = normalizeSearch(searchInput?.value || '');
      if (clearBtn) clearBtn.hidden = query.length === 0;
      let visible = 0;
      cards.forEach((card) => {
        const matchesQuery = query.split(' ').every((word) => (card.dataset.searchable || '').includes(word));
        const matchesCategory = !activeCategory || card.dataset.category === activeCategory;
        const matchesHall = !activeHall || card.dataset.hall === activeHall;
        const show = matchesQuery && matchesCategory && matchesHall;
        card.hidden = !show;
        if (show) visible += 1;
      });
      countBadges.forEach((badge, index) => badge.textContent = index === 0 ? `${visible} profiles` : `${visible} shown`);
      if (noResults) noResults.hidden = visible !== 0;
      syncUrl(query);
    }

    catChips.forEach((button) => button.addEventListener('click', () => {
      activeCategory = button.dataset.catFilter || '';
      markActive(catChips, 'catFilter', activeCategory);
      filterTenants();
    }));
    hallChips.forEach((button) => button.addEventListener('click', () => {
      activeHall = button.dataset.hallFilter || '';
      markActive(hallChips, 'hallFilter', activeHall);
      filterTenants();
    }));
    viewButtons.forEach((button) => button.addEventListener('click', () => {
      setView(button.dataset.viewToggle || 'list');
      filterTenants();
    }));
    searchInput?.addEventListener('input', filterTenants);
    clearBtn?.addEventListener('click', () => { if (searchInput) { searchInput.value = ''; searchInput.focus(); } filterTenants(); });
    resetBtn?.addEventListener('click', () => {
      if (searchInput) searchInput.value = '';
      activeCategory = '';
      activeHall = '';
      markActive(catChips, 'catFilter', '');
      markActive(hallChips, 'hallFilter', '');
      filterTenants();
      searchInput?.focus();
    });

    window.addEventListener('popstate', () => {
      const restored = new URLSearchParams(location.search);
      if (searchInput) searchInput.value = restored.get('q') || '';
      activeCategory = markActive(catChips, 'catFilter', (restored.get('sector') || '').toLowerCase());
      activeHall = markActive(hallChips, 'hallFilter', (restored.get('hall') || '').toLowerCase());
      setView(restored.get('view') || 'list');
      filterTenants();
    });

    activeCategory = markActive(catChips, 'catFilter', activeCategory);
    activeHall = markActive(hallChips, 'hallFilter', activeHall);
    setView(activeView);
    filterTenants();
  </script>
</BaseLayout>
