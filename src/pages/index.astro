---
import BaseLayout from '../layouts/BaseLayout.astro';
import tenants from '../data/tenants.json';
import tenantExtras from '../data/tenants-extra.json';
import '../styles/discovery-editorial.css';
import type { Tenant } from '../types/tenant';

const rawList = [...(tenants as Tenant[]), ...(tenantExtras as Tenant[])];
const seenSlugs = new Set<string>();
const tenantList = rawList.filter((tenant) => {
  if (!tenant.slug || seenSlugs.has(tenant.slug)) return false;
  seenSlugs.add(tenant.slug);
  return true;
});
const rawBaseUrl = import.meta.env.BASE_URL;
const baseUrl = rawBaseUrl.endsWith('/') ? rawBaseUrl : `${rawBaseUrl}/`;
const categories = [...new Set(tenantList.map((tenant) => tenant.category).filter(Boolean))];
const halls = [...new Set(tenantList.map((tenant) => tenant.hall).filter(Boolean))];
const categoryCounts = categories
  .map((category) => ({ category, count: tenantList.filter((tenant) => tenant.category === category).length }))
  .sort((a, b) => b.count - a.count);

const featuredShowcases = [
  { slug:'my-aicustom', name:'MY-AICUSTOM', line:'Enterprise AI agents, automation and applied digital operations.', image:`${baseUrl}brand/my-aicustom-hero.svg`, category:'Technology & Digital' },
  { slug:'raja-freeze-dried', name:'Raja Freeze Dried', line:'Freeze-drying capability for food, ingredients and contract processing.', image:`${baseUrl}brand/raja-freeze-dried-hero.webp`, category:'Food Technology' },
  { slug:'bumina-eenk', name:'Bumina Eenk', line:'A hospitality profile built around place, landscape and direct booking.', image:`${baseUrl}brand/bumina-eenk-hero.webp`, category:'Hospitality' },
  { slug:'samara-from-home', name:'Samara from Home', line:'Artisanal pantry products presented through a product-led editorial story.', image:`${baseUrl}brand/samara-real-1.webp`, category:'Food & Pantry' },
  { slug:'md-organic', name:'MD Organic', line:'Organic rice and export-ready agricultural products.', image:`${baseUrl}brand/md-organic/md-organic-hero.webp`, category:'Food & Agriculture' },
  { slug:'ladifa-collection', name:'Ladifa Collection', line:'Jewelry and natural gemstones with a more fashion-led presentation.', image:`${baseUrl}brand/ladifa-collection/ladifa-asset-2.webp`, category:'Craft & Fashion' },
];
const pageDescription = `Direktori digital ${tenantList.length} profil bisnis Trade Expo Indonesia 2026 dengan kanal resmi, lokasi hall dan halaman tenant yang NFC-safe.`;
---

<BaseLayout title="Tangsel TradeLink — Trade Expo Indonesia 2026" description={pageDescription}>
  <main class="discovery-home">
    <header class="discovery-nav discovery-shell">
      <a class="discovery-brand" href={baseUrl}><strong>Tangsel TradeLink</strong><span>TEI / 2026</span></a>
      <nav aria-label="Navigasi utama">
        <a href={baseUrl} aria-current="page">Overview</a>
        <a href={`${baseUrl}directory`}>Directory</a>
        <a href={`${baseUrl}guide`}>Hall guide</a>
      </nav>
    </header>

    <section class="discovery-hero discovery-shell" aria-labelledby="home-title">
      <div class="hero-copy">
        <span class="hero-serial">Tangerang Selatan · Trade Expo Indonesia 2026</span>
        <h1 id="home-title">One fair.<br/><em>Many identities.</em></h1>
        <p>Temukan bisnis yang relevan, pahami apa yang mereka tawarkan, lalu masuk ke kanal resmi tanpa lapisan informasi yang tidak perlu. Setiap profil punya karakter visual sendiri; struktur navigasinya tetap konsisten.</p>
        <a class="hero-primary" href={`${baseUrl}directory`}><span>Explore all {tenantList.length} profiles</span><b aria-hidden="true">↗</b></a>
        <a class="hero-secondary" href={`${baseUrl}guide`}>Open Hall 3A visitor guide →</a>
      </div>
      <div class="hero-stats" aria-label="Ringkasan direktori">
        <div class="hero-stat"><strong>{tenantList.length}</strong><small>published business profiles</small></div>
        <div class="hero-stat"><strong>{categories.length}</strong><small>business sectors</small></div>
        <div class="hero-stat"><strong>{halls.length}</strong><small>exhibition halls represented</small></div>
      </div>
    </section>

    <section class="editorial-section discovery-shell" aria-labelledby="sector-title">
      <div class="section-head">
        <span class="section-index">01 / Browse</span>
        <h2 id="sector-title">Start with what you need.</h2>
        <p>Sektor berfungsi sebagai pintu masuk, bukan dekorasi. Pilih konteks bisnis dulu, lalu persempit berdasarkan hall atau nama tenant di direktori.</p>
      </div>
      <div class="sector-index">
        {categoryCounts.map((item, index) => (
          <a class="sector-row" href={`${baseUrl}directory?sector=${encodeURIComponent(item.category)}`}>
            <span>{String(index + 1).padStart(2,'0')}</span>
            <strong>{item.category}</strong>
            <b>{item.count} profiles ↗</b>
          </a>
        ))}
      </div>
    </section>

    <section class="editorial-section discovery-shell" aria-labelledby="selected-title">
      <div class="section-head">
        <span class="section-index">02 / Selected</span>
        <h2 id="selected-title">Profiles with distinct visual voices.</h2>
        <p>Contoh tenant dengan treatment berbeda—technology, food, hospitality, craft—tetapi tetap berada dalam satu sistem TradeLink yang mudah dipahami.</p>
      </div>
      <div class="profile-stage featured-showcases">
        {featuredShowcases.map((item, index) => (
          <a class="profile-card featured-showcase" href={`${baseUrl}tenant/${item.slug}/`}>
            <div class="profile-media"><img src={item.image} alt="" loading={index < 2 ? 'eager' : 'lazy'} decoding="async" /></div>
            <div class="profile-top"><span>{String(index + 1).padStart(2,'0')}</span><span>{item.category}</span></div>
            <div class="profile-body"><h3>{item.name}</h3><p>{item.line}</p><span class="profile-arrow" aria-hidden="true">↗</span></div>
          </a>
        ))}
      </div>
    </section>

    <section class="editorial-section discovery-shell">
      <div class="directory-callout">
        <div>
          <span class="section-index">03 / Directory</span>
          <h2>Search first. Tap once.</h2>
          <p>Gunakan pencarian, sektor, dan hall untuk menemukan tenant. URL profile tetap permanen karena halaman-halaman ini juga menjadi destination untuk NFC card yang sudah beredar.</p>
        </div>
        <a class="hero-primary" href={`${baseUrl}directory`}><span>Open business directory</span><b aria-hidden="true">↗</b></a>
      </div>
    </section>

    <footer class="discovery-footer discovery-shell">
      <div><strong>Tangsel TradeLink</strong><br/>Trade Expo Indonesia 2026</div>
      <div>Built for discovery, meetings and NFC hand-offs.</div>
      <a href={`${baseUrl}guide`}>Hall 3A guide ↗</a>
    </footer>
  </main>
</BaseLayout>

<style>
  .profile-card,
  .sector-row {
    content-visibility: auto;
    contain-intrinsic-size: 72px;
  }
</style>
