---
import BaseLayout from '../layouts/BaseLayout.astro';
import tenants from '../data/tenants.json';
import tenantExtras from '../data/tenants-extra.json';
import { uniqueValues } from '../lib/tenant-utils.mjs';
import type { Tenant } from '../types/tenant';

const tenantList = [...(tenants as Tenant[]), ...(tenantExtras as Tenant[])];
const categories = uniqueValues(tenantList, 'category');
const halls = uniqueValues(tenantList, 'hall');
const rawBaseUrl = import.meta.env.BASE_URL;
const baseUrl = rawBaseUrl.endsWith('/') ? rawBaseUrl : `${rawBaseUrl}/`;
const featuredShowcases = [
  { slug:'my-aicustom', name:'MY-AICUSTOM', kicker:'Intelligent operations', line:'AI agents · automation · RAG', image:`${baseUrl}brand/my-aicustom-hero.svg`, mode:'tech' },
  { slug:'raja-freeze-dried', name:'Raja Freeze Dried', kicker:'Food technology', line:'Freeze · vacuum · product development', image:`${baseUrl}brand/raja-freeze-dried-hero.jpg`, mode:'agro' },
  { slug:'bumina-eenk', name:'Bumina EENK', kicker:'Pangalengan highlands', line:'Stay · tea fields · direct booking', image:`${baseUrl}brand/bumina-eenk-hero.webp`, mode:'stay' },
  { slug:'samara-from-home', name:'SAMARA from Home', kicker:'Home-kitchen pantry', line:'Sauces · pantry · social commerce', image:`${baseUrl}brand/samara-real-1.jpg`, mode:'food' },
];
---

<BaseLayout title="Tangsel TradeLink — TEI 2026" description="Tangsel TradeLink connects TEI 2026 visitors with exhibitor profiles, verified public channels and curated Tangsel showcases.">
  <main>
    <section class="hero shell">
      <div class="hero-index"><span>TEI / 2026</span><span>TANGERANG SELATAN</span></div>
      <p class="eyebrow">NFC Tenant Directory</p>
      <h1>Tangsel<br/>TradeLink</h1>
      <p class="lead">Tap. Discover. Verify. Connect directly with exhibitors and curated Tangerang Selatan businesses without a maze of generic landing pages.</p>
      <div class="hero-badge">Static-first · Mobile-ready · Source-aware</div>
    </section>

    <section class="featured-showcase" aria-labelledby="featured-title">
      <header class="featured-head">
        <div><p class="eyebrow">Curated additions</p><h2 id="featured-title">Four distinct brands.<br/>Four distinct visual systems.</h2></div>
        <p>Real repository assets, brand-specific layouts and public-source notes—built to avoid the same-template look.</p>
      </header>
      <div class="featured-grid">
        {featuredShowcases.map((item, index) => (
          <a class:list={['feature-card', `feature-${index + 1}`]} data-mode={item.mode} href={`${baseUrl}tenant/${item.slug}`}>
            <figure><img src={item.image} alt={`${item.name} showcase`} loading={index < 2 ? 'eager' : 'lazy'} decoding="async" /></figure>
            <div class="feature-copy"><small>{item.kicker}</small><strong>{item.name}</strong><span>{item.line}</span></div>
            <b class="feature-arrow" aria-hidden="true">↗</b>
          </a>
        ))}
      </div>
    </section>

    <section class="directory shell" aria-labelledby="directory-title">
      <div class="section-head"><div><p class="eyebrow">Full directory</p><h2 id="directory-title">Tenant</h2></div><span class="count" data-count>{tenantList.length} tenant</span></div>
      {tenantList.length > 0 ? (
        <>
          <div class="controls" aria-label="Pencarian dan filter tenant">
            <label class="field search-field"><span class="sr-only">Cari tenant</span><input type="search" placeholder="Cari nama, kategori, hall, booth…" data-search autocomplete="off" /></label>
            {categories.length > 0 && <label class="field"><span class="sr-only">Filter kategori</span><select data-category><option value="">Semua kategori</option>{categories.map((category) => <option value={category}>{category}</option>)}</select></label>}
            {halls.length > 0 && <label class="field"><span class="sr-only">Filter hall</span><select data-hall><option value="">Semua hall</option>{halls.map((hall) => <option value={hall}>Hall {hall}</option>)}</select></label>}
          </div>
          <div class="tenant-list" data-list>
            {tenantList.map((tenant) => (
              <a class="tenant-card" href={`${baseUrl}tenant/${tenant.slug}`} data-tenant-card data-searchable={[tenant.name, tenant.category, tenant.hall, tenant.booth].join(' ').toLowerCase()} data-category={tenant.category.toLowerCase()} data-hall={tenant.hall.toLowerCase()}>
                <div class="tenant-card-main"><strong>{tenant.name}</strong>{(tenant.category || tenant.hall || tenant.booth) && <span>{[tenant.category, tenant.hall && `Hall ${tenant.hall}`, tenant.booth && `Booth ${tenant.booth}`].filter(Boolean).join(' · ')}</span>}</div>
                <span class="go" aria-hidden="true">→</span>
              </a>
            ))}
          </div>
          <p class="no-results" data-no-results hidden>Tidak ada tenant yang cocok dengan filter ini.</p>
        </>
      ) : <div class="empty-state"><div class="empty-icon" aria-hidden="true">NFC</div><h3>Data tenant belum dimasukkan</h3><p>Struktur direktori siap menerima data tenant.</p></div>}
    </section>
  </main>
  <footer class="shell"><span>Tangsel TradeLink</span><span>Trade Expo Indonesia 2026</span></footer>

  <script>
    const search = document.querySelector<HTMLInputElement>('[data-search]');
    const category = document.querySelector<HTMLSelectElement>('[data-category]');
    const hall = document.querySelector<HTMLSelectElement>('[data-hall]');
    const cards = [...document.querySelectorAll<HTMLElement>('[data-tenant-card]')];
    const count = document.querySelector<HTMLElement>('[data-count]');
    const noResults = document.querySelector<HTMLElement>('[data-no-results]');
    const update = () => {
      const q = (search?.value || '').trim().toLowerCase();
      const selectedCategory = (category?.value || '').toLowerCase();
      const selectedHall = (hall?.value || '').toLowerCase();
      let visible = 0;
      cards.forEach((card) => {
        const matches = (!q || card.dataset.searchable?.includes(q)) && (!selectedCategory || card.dataset.category === selectedCategory) && (!selectedHall || card.dataset.hall === selectedHall);
        card.hidden = !matches; if (matches) visible += 1;
      });
      if (count) count.textContent = `${visible} tenant`;
      if (noResults) noResults.hidden = visible !== 0;
    };
    [search, category, hall].forEach((control) => control?.addEventListener(control instanceof HTMLInputElement ? 'input' : 'change', update));
  </script>
</BaseLayout>

<style>
  main{padding:14px 0 58px}.hero.shell,.directory.shell,footer.shell,.featured-showcase{width:min(100% - 28px,1180px);margin-inline:auto}
  .hero{position:relative;overflow:hidden;margin-top:4px;min-height:min(720px,88svh);padding:34px clamp(22px,5vw,64px);display:flex;flex-direction:column;justify-content:flex-end;background:radial-gradient(circle at 82% 16%,rgba(51,210,211,.18),transparent 25%),#081722;color:#f2f6f3;border:1px solid rgba(255,255,255,.08)}
  .hero:after{content:'TRADE / CONNECT';position:absolute;right:-.02em;top:.32em;writing-mode:vertical-rl;font-size:clamp(3rem,8vw,7rem);font-weight:900;letter-spacing:-.06em;color:rgba(255,255,255,.035);pointer-events:none}.hero-index{position:absolute;left:clamp(22px,5vw,64px);right:clamp(22px,5vw,64px);top:26px;display:flex;justify-content:space-between;font-size:.62rem;font-weight:850;letter-spacing:.13em}.hero .eyebrow{color:#63d7d4}.hero h1{margin:0;font-family:Georgia,'Times New Roman',serif;font-size:clamp(4.6rem,13vw,10rem);font-weight:400;line-height:.72;letter-spacing:-.075em}.lead{max-width:660px;margin:28px 0 0;color:#b8c7c8;line-height:1.65;font-size:clamp(.95rem,1.5vw,1.12rem)}.hero-badge{display:inline-flex;align-self:flex-start;margin-top:24px;padding:8px 0;border-bottom:1px solid rgba(99,215,212,.5);color:#dce8e7;font-size:.72rem;font-weight:850;letter-spacing:.08em;text-transform:uppercase}
  .featured-showcase{padding:74px 0 46px}.featured-head{display:grid;grid-template-columns:1.2fr .8fr;gap:40px;align-items:end;margin-bottom:28px}.featured-head h2{margin:0;font-family:Georgia,serif;font-size:clamp(2.8rem,6vw,5.8rem);font-weight:400;line-height:.92;letter-spacing:-.055em}.featured-head>p{max-width:420px;margin:0 0 6px;color:#657466;line-height:1.6}.featured-grid{display:grid;grid-template-columns:1.1fr .9fr;grid-template-rows:repeat(2,minmax(360px,42vw));gap:8px}.feature-card{position:relative;overflow:hidden;min-height:360px;color:#fff;text-decoration:none;background:#111}.feature-card figure{position:absolute;inset:0;margin:0;background:#111}.feature-card img{width:100%;height:100%;object-fit:cover;transition:transform .7s cubic-bezier(.2,.7,.2,1)}.feature-card:after{content:'';position:absolute;inset:0;background:linear-gradient(180deg,transparent 38%,rgba(0,0,0,.82))}.feature-card:hover img{transform:scale(1.025)}.feature-1{grid-row:span 2}.feature-1 img{object-fit:contain;background:#07101a}.feature-2{border-radius:0 120px 0 0}.feature-3{border-radius:120px 0 0 0}.feature-4{display:none}.feature-copy{position:absolute;z-index:2;left:24px;right:64px;bottom:24px;display:grid;gap:5px}.feature-copy small{font-size:.62rem;text-transform:uppercase;letter-spacing:.12em;opacity:.7}.feature-copy strong{font-family:Georgia,serif;font-size:clamp(1.8rem,4vw,4rem);font-weight:400;line-height:.9}.feature-copy span{font-size:.76rem;opacity:.72}.feature-arrow{position:absolute;z-index:3;right:24px;bottom:25px;font-size:1.4rem}.feature-card[data-mode='agro']{background:#0f291e}.feature-card[data-mode='stay']{background:#173126}.feature-card[data-mode='food']{background:#4a2e27}
  .directory{padding-top:42px}.section-head{display:flex;align-items:end;justify-content:space-between;gap:16px;margin-bottom:16px}.section-head h2{margin:0;font-size:2.2rem;letter-spacing:-.04em}.count{color:var(--muted);font-size:.82rem;font-weight:800}.controls{display:grid;grid-template-columns:minmax(0,1.5fr) repeat(2,minmax(0,.75fr));gap:8px;margin-bottom:10px}.field input,.field select{width:100%;min-height:50px;border:1px solid var(--line);border-radius:0;padding:0 14px;background:#fff;color:var(--ink);outline:none}.field input:focus,.field select:focus{border-color:var(--accent)}.tenant-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}.tenant-card{display:grid;grid-template-columns:1fr auto;align-items:center;gap:14px;min-height:94px;padding:18px;border:1px solid var(--line);background:#fff;text-decoration:none;transition:transform .18s ease,box-shadow .18s ease}.tenant-card:hover,.tenant-card:focus-visible{transform:translateY(-2px);box-shadow:0 14px 34px rgba(20,45,70,.08);outline:none}.tenant-card-main{min-width:0;display:grid;gap:5px}.tenant-card strong{font-size:.98rem}.tenant-card span{color:var(--muted);font-size:.76rem;line-height:1.35}.tenant-card .go{width:34px;height:34px;display:grid;place-items:center;border-radius:50%;background:var(--accent-soft);color:var(--accent-strong);font-weight:900}.no-results{padding:26px 16px;text-align:center;color:var(--muted)}.empty-state{padding:34px 22px;border:1px dashed var(--line);background:#fff;text-align:center}.empty-icon{font-weight:900}.empty-state p{color:var(--muted)}footer{display:flex;justify-content:space-between;gap:12px;padding:0 0 28px;color:var(--muted);font-size:.72rem}
  @media(min-width:1000px){.featured-grid{grid-template-columns:1.15fr .85fr .72fr;grid-template-rows:minmax(340px,31vw) minmax(340px,31vw)}.feature-1{grid-row:span 2}.feature-2{grid-column:2}.feature-3{grid-column:2}.feature-4{display:block;grid-column:3;grid-row:1/-1;border-radius:160px 160px 0 0}.feature-4 img{object-fit:contain;background:#faf7f2}}
  @media(max-width:780px){.featured-head{grid-template-columns:1fr}.featured-grid{grid-template-columns:1fr;grid-template-rows:none}.feature-card,.feature-1,.feature-2,.feature-3,.feature-4{display:block;grid-row:auto;min-height:430px;border-radius:0}.tenant-list{grid-template-columns:1fr}.controls{grid-template-columns:1fr 1fr}.search-field{grid-column:1/-1}}
  @media(max-width:430px){main{padding-top:8px}.hero{min-height:78svh}.hero h1{font-size:18vw}.featured-showcase{padding-top:54px}.featured-grid{gap:6px}.feature-card{min-height:370px}.controls{grid-template-columns:1fr}.search-field{grid-column:auto}footer{flex-direction:column}}
  @media(hover:none){.feature-card:hover img{transform:none}}@media(prefers-reduced-motion:reduce){.feature-card img,.tenant-card{transition:none}}
</style>

<style is:global>.tenant-card{content-visibility:auto;contain-intrinsic-size:72px}</style>
