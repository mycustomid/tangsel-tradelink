---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { resolveTenantFavicon } from '../../lib/tenant-utils.mjs';
import SmartNfcShowcase from '../../components/SmartNfcShowcase.astro';
import config from '../../data/showcases/kule-perfume.json';

const baseUrl = import.meta.env.BASE_URL;
const tenant = {
  name: "KULE PERFUME",
  slug: "kule-perfume",
  hall: '8',
  booth: '8-7C',
  category: "Health, Beauty & Personal Care",
  description: "Fine artisan fragrance and high-concentration extrait de parfum crafted in Serpong, South Tangerang.",
  theme: "luxury",
  researchStatus: "verified",
  verifiedAt: '2026-10-14'
};
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: tenant.name,
  url: "https://shopee.co.id/kule_parfum",
  sameAs: ["https://www.instagram.com/kuleperfume", "https://shopee.co.id/kule_parfum"]
};
---
<BaseLayout
  favicon={resolveTenantFavicon(tenant, config)}
  title={`${tenant.name} — Tangsel TradeLink`}
  description={tenant.description}
  theme={tenant.theme}
  canonical={`${baseUrl}tenant/${tenant.slug}`}
  image={config.heroImage}
  structuredData={structuredData}
>
  <SmartNfcShowcase tenant={tenant} config={config} baseUrl={baseUrl} />
</BaseLayout>
