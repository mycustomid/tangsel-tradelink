---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { resolveTenantFavicon } from '../../lib/tenant-utils.mjs';
import SmartNfcShowcase from '../../components/SmartNfcShowcase.astro';
import config from '../../data/showcases/fennycroche.json';

const baseUrl = import.meta.env.BASE_URL;
const tenant = {
  name: "FENNYCROCHE", slug: "fennycroche", hall: '8', booth: '8-7C',
  category: "Fashion, Handicraft & Home Decor",
  description: "Handmade crochet accessories from Ciputat, South Tangerang.",
  theme: "editorial",
  researchStatus: "public-source-checked", verifiedAt: '2026-10-13'
};
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: tenant.name,
  url: "https://kurasi.tangerangselatankota.go.id/produk/549", sameAs: ["https://www.instagram.com/fennycroche", "https://kurasi.tangerangselatankota.go.id/produk/549"]
};
---
<BaseLayout favicon={resolveTenantFavicon(tenant, config)} title={`${tenant.name} — Tangsel TradeLink`} description={tenant.description} theme={tenant.theme}
  canonical={`${baseUrl}tenant/${tenant.slug}`} image={config.heroImage} structuredData={structuredData}>
  <SmartNfcShowcase tenant={tenant} config={config} baseUrl={baseUrl} />
</BaseLayout>
