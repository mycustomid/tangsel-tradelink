---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SmartNfcShowcase from '../../components/SmartNfcShowcase.astro';
import config from '../../data/showcases/datik-batik.json';

const baseUrl = import.meta.env.BASE_URL;
const tenant = {
  name: "Datik Batik", slug: "datik-batik", hall: '8', booth: '8-7C',
  category: "Fashion, Handicraft & Home Decor",
  description: "Batik and fashion from Pamulang, South Tangerang.",
  theme: "editorial",
  researchStatus: "public-source-checked", verifiedAt: '2026-10-13'
};
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: tenant.name,
  url: "https://www.instagram.com/datikbatik", sameAs: ["https://www.instagram.com/datikbatik"]
};
---
<BaseLayout title={`${tenant.name} — Tangsel TradeLink`} description={tenant.description} theme={tenant.theme}
  canonical={`${baseUrl}tenant/${tenant.slug}`} image={config.heroImage} structuredData={structuredData}>
  <SmartNfcShowcase tenant={tenant} config={config} baseUrl={baseUrl} />
</BaseLayout>
