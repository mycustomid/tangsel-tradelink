---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import commodities from '../../../data/cuan-dong-commodities.json';

export function getStaticPaths() {
  return commodities.map((commodity) => ({
    params: { commodity: commodity.slug },
    props: { commodity },
  }));
}

interface Commodity {
  id: string;
  slug: string;
  title: string;
  brand: string;
  category: string;
  hsCode: string;
  origin: string;
  harvestSeason: string;
  heroImage: string;
  packagingImage: string;
  shortDescription: string;
  fullDescription: string;
  gradesAvailable: string[];
  physicalChemicalSpecs: Record<string, string>;
  packagingOptions: string[];
  containerLoadability: Record<string, string>;
  certifications: string[];
  minOrderQuantity: string;
  supplyCapacity: string;
  incoTerms: string[];
  loadingPort: string;
  leadTime: string;
  seo: {
    title: string;
    metaDescription: string;
    primaryKeywords: string[];
    secondaryKeywords: string[];
  };
  rfqAction: {
    desk: string;
    whatsappNumber: string;
    prefilledText: string;
    whatsappUrl: string;
  };
}

const { commodity } = Astro.props as { commodity: Commodity };
const baseUrl = import.meta.env.BASE_URL || '/';
const normalizedBase = String(baseUrl).replace(/\/$/, '');
const showcaseUrl = `${normalizedBase}/tenant/cuan-dong`;
const canonicalPath = `${normalizedBase}/tenant/cuan-dong/${commodity.slug}`;

const categoryImageMap: Record<string, string> = {
  'Cocoa Derivatives': '/brand/cuan-dong/cuan-dong-cocoa.jpg',
  'Indonesian Spices': '/brand/cuan-dong/cuan-dong-spices.jpg',
  'Coconut Derivatives': '/brand/cuan-dong/cuan-dong-coconut.jpg',
  'Marine & Seafood': '/brand/cuan-dong/cuan-dong-shipping.jpg',
};

const heroImagePath = commodity.heroImage || categoryImageMap[commodity.category] || '/brand/cuan-dong/cuan-dong-hero.jpg';
const packagingImagePath = commodity.packagingImage || `/brand/cuan-dong/commodities/${commodity.slug}-packaging.jpg`;
const resolvedHeroImage = `${normalizedBase}${heroImagePath}`;
const resolvedPackagingImage = `${normalizedBase}${packagingImagePath}`;
const resolvedWarehouseImage = `${normalizedBase}/brand/cuan-dong/cuan-dong-warehouse.jpg`;
const resolvedShippingImage = `${normalizedBase}/brand/cuan-dong/cuan-dong-shipping.jpg`;
const resolvedLogo = `${normalizedBase}/brand/cuan-dong/cuan-dong-logo.png`;
const resolvedFavicon = `${normalizedBase}/brand/cuan-dong/cuan-dong-favicon.png`;

const visualGalleryItems = [
  {
    src: resolvedHeroImage,
    badge: '01 · EXPORT GRADE SPECIMEN',
    title: 'Raw / Processed Export Grade Visual (Unbranded)',
    caption: `Verified export-grade ${commodity.title} inspected for color, moisture equilibrium, and physical purity prior to batch lot allocation.`,
  },
  {
    src: resolvedPackagingImage,
    badge: '02 · WHITE-LABEL PACKAGING',
    title: 'White-Label Bulk Export Packaging (Zero Third-Party Logos)',
    caption: `Neutral export-ready bags, cartons, or OEM containers with zero third-party manufacturer marks—ready for buyer private-label stenciling.`,
  },
  {
    src: resolvedWarehouseImage,
    badge: '03 · QUALITY GATEKEEPING',
    title: 'Consolidation & Pre-Shipment Inspection Gate',
    caption: 'Controlled consolidation warehouse protocol including random probe sampling, moisture testing, and SGS / Sucofindo pre-shipment verification.',
  },
  {
    src: resolvedShippingImage,
    badge: '04 · FCL MARITIME DISPATCH',
    title: 'FCL Container Loading & Port Dispatch',
    caption: `Container stuffing with food-grade Kraft liner, desiccant moisture poles, ISPM-15 pallets, and direct dispatch via ${commodity.loadingPort}.`,
  },
];

const specLabelOverrides: Record<string, string> = {
  moistureContent: 'Moisture Content',
  beanCountPer100g: 'Bean Count (per 100g)',
  fermentationDegree: 'Fermentation Degree',
  fatContentCocoaButter: 'Fat Content (Cocoa Butter)',
  freeFattyAcidsFFA: 'Free Fatty Acids (FFA)',
  pHValue: 'pH Value',
  slatyBeansUnfermented: 'Slaty / Unfermented Beans',
  moldyBeans: 'Moldy Beans',
  insectDamagedBeans: 'Insect-Damaged Beans',
  germinatedBeans: 'Germinated Beans',
  wasteForeignMatter: 'Waste & Foreign Matter',
  heavyMetalsLeadPb: 'Heavy Metals — Lead (Pb)',
  heavyMetalsCadmiumCd: 'Heavy Metals — Cadmium (Cd)',
  heavyMetalsArsenicAs: 'Heavy Metals — Arsenic (As)',
  heavyMetalsMercuryHg: 'Heavy Metals — Mercury (Hg)',
  fatContent: 'Fat Content',
  finenessThrough200Mesh: 'Fineness (Through 200 Mesh)',
  totalAsh: 'Total Ash',
  acidInsolubleAsh: 'Acid-Insoluble Ash',
  shellContent: 'Shell Content',
  totalPlateCountTPC: 'Total Plate Count (TPC)',
  yeastAndMold: 'Yeast & Mold',
  enterobacteriaceae: 'Enterobacteriaceae',
  escherichiaColi: 'Escherichia coli (E. coli)',
  salmonella: 'Salmonella',
  moistureAndVolatiles: 'Moisture & Volatiles',
  slipMeltingPoint: 'Slip Melting Point',
  iodineValue: 'Iodine Value',
  saponificationValue: 'Saponification Value',
  refractiveIndex40C: 'Refractive Index (@ 40°C)',
  unsaponifiableMatter: 'Unsaponifiable Matter',
  peroxideValue: 'Peroxide Value',
  solidFatContentSFC20C: 'Solid Fat Content (SFC @ 20°C)',
  solidFatContentSFC25C: 'Solid Fat Content (SFC @ 25°C)',
  solidFatContentSFC30C: 'Solid Fat Content (SFC @ 30°C)',
  solidFatContentSFC35C: 'Solid Fat Content (SFC @ 35°C)',
  blueValue: 'Blue Value',
  aerobicPlateCount: 'Aerobic Plate Count',
  volatileOilContent: 'Volatile Oil Content',
  cinnamaldehydeInOil: 'Cinnamaldehyde in Oil',
  extraneousForeignMatter: 'Extraneous / Foreign Matter',
  moldContamination: 'Mold Contamination',
  insectDefilingExcreta: 'Insect Defiling / Excreta',
  coumarinContent: 'Coumarin Content',
  leadPb: 'Lead (Pb)',
  eColi: 'Escherichia coli (E. coli)',
  podDiameterSize: 'Pod Diameter Size',
  openSplitPods: 'Open / Split Pods',
  emptyImmaturePods: 'Empty / Immature Pods',
  foreignMatterStems: 'Foreign Matter & Stems',
  bulkDensity: 'Bulk Density',
  insectDamageInfestation: 'Insect Damage & Infestation',
  vanillinContent: 'Vanillin Content (Dry Basis)',
  moistureContentGourmet: 'Moisture Content (Gourmet Grade)',
  moistureContentExtract: 'Moisture Content (Extract Grade)',
  podLengthGradeA: 'Pod Length (Grade A)',
  podLengthGradeB: 'Pod Length (Grade B)',
  colorAndAppearance: 'Color & Appearance',
  texture: 'Physical Texture',
  moldAndInsectContamination: 'Mold & Insect Contamination',
  totalPlateCount: 'Total Plate Count',
  eugenolPurityInOil: 'Eugenol Purity in Oil',
  headlessCloves: 'Headless Cloves Tolerance',
  stemsAndForeignMatter: 'Stems & Foreign Matter',
  immatureBabyCloves: 'Immature / Baby Cloves',
  moldyOrFermentedCloves: 'Moldy or Fermented Cloves',
  insectDamagedCloves: 'Insect-Damaged Cloves',
  oilContentDryBasis: 'Oil Content (Dry Basis)',
  moistureContentEdible: 'Moisture Content (White Edible)',
  moistureContentMilling: 'Moisture Content (Milling Grade)',
  freeFattyAcidFFAEdible: 'Free Fatty Acid (FFA — Edible)',
  freeFattyAcidFFAMilling: 'Free Fatty Acid (FFA — Milling)',
  rubberyImmatureCups: 'Rubbery / Immature Cups',
  smokyOrBurntCups: 'Smoky or Burnt Cups',
  moldyDiscoloredCups: 'Moldy / Discolored Cups',
  foreignMatter: 'Foreign Matter',
  aflatoxinContent: 'Total Aflatoxin Content',
  appearanceEdible: 'Appearance (Edible Grade)',
  crudeProteinDryBasis: 'Crude Protein (Dry Basis)',
  crudeFatResidualOil: 'Crude Fat / Residual Oil',
  crudeFiber: 'Crude Fiber',
  sandSilica: 'Sand & Silica (Acid-Insoluble)',
  metabolizableEnergy: 'Metabolizable Energy (ME)',
  aflatoxinB1: 'Aflatoxin B1 Limit',
  melamineAndUrea: 'Melamine & Non-Protein Nitrogen',
  fishSpecies: 'Marine Fish Species',
  fishCut: 'Fish Dressing & Cut Spec',
  netWeightOptions: 'Net Weight Options',
  drainedWeightFishContent: 'Drained Weight (Fish Content)',
  fishPieceCount: 'Fish Piece Count per Tin',
  vacuumLevel: 'Internal Can Vacuum Level',
  histamineContent: 'Histamine Level',
  commercialSterility: 'Commercial Sterility (Retort)',
  tinplateCanSpec: 'Tinplate Can & Lacquer Spec',
  shelfLife: 'Guaranteed Shelf Life',
};

const formatSpecKey = (key: string) => {
  if (specLabelOverrides[key]) return specLabelOverrides[key];
  return key
    .replace(/([A-Z])/g, ' $1')
    .replace(/^./, (s) => s.toUpperCase())
    .trim();
};

const containerLabelOverrides: Record<string, string> = {
  fcl20ft: '20ft FCL Standard Loadability',
  fcl40ft: '40ft FCL Standard Loadability',
  fcl40ftHC: '40ft High Cube (HC) Loadability',
  fcl20ftSolidCartons: '20ft FCL (Solid Block Cartons)',
  fcl20ftFlexitankLiquid: '20ft FCL (Liquid Flexitank)',
  fcl40ftReeferDry: '40ft FCL (Reefer / Dry Container)',
  fcl20ftQuillsSticks: '20ft FCL (Cut Quills & Sticks)',
  fcl20ftBrokenBales: '20ft FCL (Hydraulic Pressed Bales)',
  fcl40ftHCBrokenBales: '40ft HC (Hydraulic Pressed Bales)',
  fcl40ftHCQuillsSticks: '40ft HC (Cut Quills & Sticks)',
  airFreightLCL: 'Air Cargo / LCL Consolidation',
  fcl20ftDry: '20ft Dry Container (Vacuum Cartons)',
  fcl20ftBags: '20ft FCL (Bagged Stowage)',
  fcl40ftHCBags: '40ft HC (Bagged Stowage)',
  fcl40ftHCLooseBulk: '40ft HC (Loose Bulk Liner)',
  fcl20ft50kgBags: '20ft FCL (50 kg Woven PP Bags)',
  fcl20ftJumboBags: '20ft FCL (1,000 kg FIBC Jumbo Bags)',
  fcl40ftHC50kgBagsBulk: '40ft HC (50 kg Bags / Bulk)',
  fcl20ft155gCartons: '20ft FCL (155g Club/Round Tins)',
  fcl20ft425gCartons: '20ft FCL (425g Tall/Oval Tins)',
};

const formatContainerKey = (key: string) => {
  if (containerLabelOverrides[key]) return containerLabelOverrides[key];
  return key
    .replace(/([A-Z])/g, ' $1')
    .replace(/^./, (s) => s.toUpperCase())
    .trim();
};

const primary20ft =
  commodity.containerLoadability.fcl20ft ||
  Object.entries(commodity.containerLoadability).find(([k]) => k.toLowerCase().includes('20ft'))?.[1] ||
  Object.values(commodity.containerLoadability)[0];

const primary40ft =
  commodity.containerLoadability.fcl40ft ||
  commodity.containerLoadability.fcl40ftHC ||
  Object.entries(commodity.containerLoadability).find(([k]) => k.toLowerCase().includes('40ft'))?.[1] ||
  'Custom FCL / Air Consolidation';

const specEntries = Object.entries(commodity.physicalChemicalSpecs);
const loadabilityEntries = Object.entries(commodity.containerLoadability);
const relatedCommodities = commodities.filter((item) => item.slug !== commodity.slug);

const emailSubject = encodeURIComponent(`RFQ Inquiry: ${commodity.title} (HS ${commodity.hsCode}) — CUAN-DONG Global Holdings`);
const emailBody = encodeURIComponent(commodity.rfqAction.prefilledText);
const mailtoUrl = `mailto:cuandongholdings@gmail.com?subject=${emailSubject}&body=${emailBody}`;

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'CUAN-DONG Global Holdings',
    url: 'https://cuan-dong.com/',
    email: 'cuandongholdings@gmail.com',
    telephone: '+62-813-1723-0957',
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'South Tangerang',
      addressRegion: 'Banten',
      addressCountry: 'ID',
    },
    sameAs: ['https://www.instagram.com/cuandong_holdings'],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: commodity.title,
    image: [resolvedHeroImage, resolvedPackagingImage],
    description: commodity.fullDescription,
    sku: `CDGH-${commodity.id.toUpperCase()}`,
    mpn: `HS-${commodity.hsCode}`,
    category: commodity.category,
    countryOfOrigin: {
      '@type': 'Country',
      name: 'Indonesia',
    },
    brand: {
      '@type': 'Brand',
      name: commodity.brand,
    },
    manufacturer: {
      '@type': 'Organization',
      name: 'CUAN-DONG Global Holdings',
      url: 'https://cuan-dong.com/',
    },
    additionalProperty: [
      {
        '@type': 'PropertyValue',
        name: 'HS Code',
        value: commodity.hsCode,
      },
      {
        '@type': 'PropertyValue',
        name: 'Origin',
        value: commodity.origin,
      },
      {
        '@type': 'PropertyValue',
        name: 'Minimum Order Quantity (MOQ)',
        value: commodity.minOrderQuantity,
      },
      {
        '@type': 'PropertyValue',
        name: 'Monthly Supply Capacity',
        value: commodity.supplyCapacity,
      },
      {
        '@type': 'PropertyValue',
        name: 'Loading Port',
        value: commodity.loadingPort,
      },
    ],
    offers: {
      '@type': 'Offer',
      availability: 'https://schema.org/InStock',
      priceCurrency: 'USD',
      priceSpecification: {
        '@type': 'PriceSpecification',
        priceCurrency: 'USD',
        eligibleQuantity: {
          '@type': 'QuantitativeValue',
          name: commodity.minOrderQuantity,
        },
      },
      seller: {
        '@type': 'Organization',
        name: 'CUAN-DONG Global Holdings',
        url: 'https://cuan-dong.com/',
      },
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemPage',
    name: commodity.seo.title,
    description: commodity.seo.metaDescription,
    inLanguage: 'en',
    mainEntity: {
      '@type': 'Product',
      name: commodity.title,
      sku: `CDGH-${commodity.id.toUpperCase()}`,
    },
  },
];
---

<BaseLayout
  lang="en"
  title={commodity.seo.title}
  description={commodity.seo.metaDescription}
  favicon={resolvedFavicon}
  canonical={canonicalPath}
  image={heroImagePath}
  theme="industrial"
  structuredData={structuredData}
>
  <div class="cd-page" lang="en">
    <!-- Top Institutional Navigation Bar -->
    <header class="cd-topbar">
      <div class="cd-container cd-topbar-inner">
        <div class="cd-topbar-left">
          <a href={showcaseUrl} class="cd-back-link" aria-label="Back to CUAN-DONG Global Holdings Showcase">
            <span class="cd-back-arrow" aria-hidden="true">←</span>
            <span>CUAN-DONG Global Holdings Showcase</span>
          </a>
          <span class="cd-divider" aria-hidden="true">/</span>
          <span class="cd-crumb-current">{commodity.title}</span>
        </div>
        <div class="cd-topbar-right">
          <span class="cd-booth-pill">TEI 2026 · Hall 8 · Booth 8-7C</span>
          <a href="https://cuan-dong.com/" target="_blank" rel="noopener noreferrer" class="cd-official-link">
            <span>cuan-dong.com</span>
            <b aria-hidden="true">↗</b>
          </a>
        </div>
      </div>
    </header>

    <main class="cd-main">
      <!-- Hero Section -->
      <section class="cd-hero" aria-labelledby="commodity-heading">
        <div class="cd-container cd-hero-grid">
          <div class="cd-hero-content">
            <div class="cd-badge-row">
              <span class="cd-badge cd-badge-category">{commodity.category}</span>
              <span class="cd-badge cd-badge-hs">HS CODE: {commodity.hsCode}</span>
              <span class="cd-badge cd-badge-verified">EXPORT READY · UNBRANDED WHITE-LABEL</span>
            </div>

            <h1 id="commodity-heading" class="cd-title">{commodity.title}</h1>

            <div class="cd-origin-bar">
              <div class="cd-origin-item">
                <span class="cd-meta-label">ORIGIN PROVENANCE</span>
                <strong class="cd-meta-value">{commodity.origin}</strong>
              </div>
              <div class="cd-origin-item">
                <span class="cd-meta-label">HARVEST / PRODUCTION WINDOW</span>
                <strong class="cd-meta-value">{commodity.harvestSeason}</strong>
              </div>
            </div>

            <p class="cd-short-desc">{commodity.shortDescription}</p>
            <p class="cd-full-desc">{commodity.fullDescription}</p>

            <div class="cd-cta-group" role="group" aria-label="Direct B2B RFQ Actions">
              <a
                href={commodity.rfqAction.whatsappUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="cd-btn cd-btn-primary"
              >
                <span class="cd-btn-dot" aria-hidden="true"></span>
                <span>Inquire via WhatsApp Desk · +62 813-1723-0957</span>
                <b aria-hidden="true">↗</b>
              </a>
              <a
                href={mailtoUrl}
                class="cd-btn cd-btn-secondary"
              >
                <span>Email RFQ · cuandongholdings@gmail.com</span>
                <b aria-hidden="true">✉</b>
              </a>
            </div>
          </div>

          <aside class="cd-hero-aside" aria-label="Export Dossier Summary">
            <div class="cd-dossier-card">
              <div class="cd-dossier-media">
                <img
                  src={resolvedHeroImage}
                  alt={`${commodity.title} — ${commodity.brand}`}
                  width="800"
                  height="520"
                  loading="eager"
                  decoding="async"
                  fetchpriority="high"
                  onerror="this.style.display='none'"
                />
                <div class="cd-dossier-overlay">
                  <img
                    src={resolvedLogo}
                    alt="CUAN-DONG Global Holdings"
                    class="cd-dossier-logo"
                    width="120"
                    height="40"
                    loading="eager"
                  />
                  <span class="cd-dossier-tag">INSTITUTIONAL EXPORT DOSSIER</span>
                </div>
              </div>

              <div class="cd-dossier-body">
                <div class="cd-dossier-header">
                  <span class="cd-dossier-kicker">TRADE DESK REFERENCE</span>
                  <strong>CDGH-{commodity.id.toUpperCase()}</strong>
                </div>
                <dl class="cd-dossier-list">
                  <div>
                    <dt>Harmonized System (HS)</dt>
                    <dd class="cd-mono">{commodity.hsCode}</dd>
                  </div>
                  <div>
                    <dt>20ft FCL Loadability</dt>
                    <dd>{primary20ft}</dd>
                  </div>
                  <div>
                    <dt>40ft FCL Loadability</dt>
                    <dd>{primary40ft}</dd>
                  </div>
                  <div>
                    <dt>Port of Loading</dt>
                    <dd>{commodity.loadingPort}</dd>
                  </div>
                  <div>
                    <dt>Payment & Settlement</dt>
                    <dd>T/T Deposit or Irrevocable L/C at Sight</dd>
                  </div>
                </dl>
              </div>
            </div>
          </aside>
        </div>
      </section>

      <!-- Key Export Metrics Strip -->
      <section class="cd-metrics-strip" aria-label="Key Export Commercial Metrics">
        <div class="cd-container">
          <div class="cd-metrics-grid">
            <article class="cd-metric-card">
              <span class="cd-metric-label">HARMONIZED SYSTEM CODE</span>
              <strong class="cd-metric-val cd-mono">HS {commodity.hsCode}</strong>
              <span class="cd-metric-sub">WCO / Indonesian Customs BTKI</span>
            </article>
            <article class="cd-metric-card">
              <span class="cd-metric-label">MINIMUM ORDER QUANTITY (MOQ)</span>
              <strong class="cd-metric-val">{commodity.minOrderQuantity}</strong>
              <span class="cd-metric-sub">Export Contract Baseline</span>
            </article>
            <article class="cd-metric-card">
              <span class="cd-metric-label">MONTHLY SUPPLY CAPACITY</span>
              <strong class="cd-metric-val">{commodity.supplyCapacity}</strong>
              <span class="cd-metric-sub">Scalable Multi-Container Allocation</span>
            </article>
            <article class="cd-metric-card">
              <span class="cd-metric-label">ESTIMATED DISPATCH LEAD TIME</span>
              <strong class="cd-metric-val">{commodity.leadTime}</strong>
              <span class="cd-metric-sub">From L/C Confirmation or Deposit</span>
            </article>
          </div>
        </div>
      </section>

      <!-- Visual Inspection & White-Label Packaging Gallery -->
      <section class="cd-section cd-visual-section" aria-labelledby="visual-gallery-heading">
        <div class="cd-container">
          <div class="cd-section-header">
            <div>
              <p class="cd-eyebrow">01 · UNBRANDED STUDIO & WAREHOUSE VISUAL VERIFICATION</p>
              <h2 id="visual-gallery-heading" class="cd-section-title">Visual Inspection &amp; White-Label Packaging Gallery</h2>
            </div>
            <p class="cd-section-note">
              All export consignments are supplied in clean, unbranded neutral packaging or customized OEM private-label formats with zero third-party manufacturer marks.
            </p>
          </div>

          <div class="cd-visual-grid">
            {visualGalleryItems.map((vis) => (
              <figure class="cd-visual-card">
                <div class="cd-visual-img-wrap">
                  <img
                    src={vis.src}
                    alt={`${commodity.title} — ${vis.title}`}
                    width="720"
                    height="480"
                    loading="lazy"
                    decoding="async"
                    onerror="this.style.display='none'"
                  />
                  <span class="cd-visual-badge">{vis.badge}</span>
                </div>
                <figcaption class="cd-visual-caption">
                  <strong>{vis.title}</strong>
                  <p>{vis.caption}</p>
                </figcaption>
              </figure>
            ))}
          </div>
        </div>
      </section>

      <!-- Main Technical Grid: Grades + Physical/Chemical Matrix -->
      <section class="cd-section" aria-labelledby="specs-heading">
        <div class="cd-container">
          <div class="cd-section-header">
            <div>
              <p class="cd-eyebrow">02 · LABORATORY & COMMERCIAL PARAMETERS</p>
              <h2 id="specs-heading" class="cd-section-title">Technical Specifications &amp; Export Grades</h2>
            </div>
            <p class="cd-section-note">
              All physical, chemical, and microbiological parameters are verified prior to container stuffing and documented via batch-specific Certificate of Analysis (COA).
            </p>
          </div>

          <div class="cd-tech-layout">
            <!-- Available Export Grades -->
            <div class="cd-panel cd-grades-panel">
              <div class="cd-panel-head">
                <h3>Available Export Grades &amp; Formulations</h3>
                <span class="cd-count-pill">{commodity.gradesAvailable.length} Grades</span>
              </div>
              <p class="cd-panel-desc">
                Select your target grade specification when submitting an RFQ to our trade desk for tailored FOB/CIF pricing.
              </p>
              <ul class="cd-grades-list">
                {commodity.gradesAvailable.map((grade, index) => (
                  <li class="cd-grade-item">
                    <span class="cd-grade-index">G-{String(index + 1).padStart(2, '0')}</span>
                    <span class="cd-grade-text">{grade}</span>
                  </li>
                ))}
              </ul>

              <div class="cd-qa-callout">
                <h4>Quality Assurance &amp; Inspection Protocol</h4>
                <p>
                  Every shipment undergoes multi-stage gatekeeping at CUAN-DONG consolidation warehouses: raw batch sampling, moisture/purity assay, metal detection, and container cleanliness verification. Independent third-party pre-shipment inspection (SGS, Sucofindo, Bureau Veritas, or Intertek) is supported at port of loading.
                </p>
              </div>
            </div>

            <!-- Physical & Chemical Specification Matrix -->
            <div class="cd-panel cd-matrix-panel">
              <div class="cd-panel-head">
                <h3>Physical &amp; Chemical Specification Matrix</h3>
                <span class="cd-count-pill cd-mono">COA STANDARD</span>
              </div>
              <div class="cd-table-wrap">
                <table class="cd-spec-table">
                  <thead>
                    <tr>
                      <th scope="col">Analytical Parameter</th>
                      <th scope="col">Export Specification Limit / Standard</th>
                    </tr>
                  </thead>
                  <tbody>
                    {specEntries.map(([key, value]) => (
                      <tr>
