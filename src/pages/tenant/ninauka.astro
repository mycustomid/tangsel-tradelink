---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { resolveTenantFavicon } from '../../lib/tenant-utils.mjs';
import SmartNfcShowcase from '../../components/SmartNfcShowcase.astro';
import config from '../../data/showcases/titik-kurniasih.json';

const baseUrl = import.meta.env.BASE_URL;
const tenant = {
  name: "NINAUKA (Titik Kurniasih)", slug: "ninauka", hall: '8', booth: '8-7C',
  category: "Fashion, Handicraft & Home Decor",
  description: "Artisan Batik Tangerang Selatan, Wastra Nusantara & Ecoprint Kontemporer Berkualitas Kurasi.",
  theme: "editorial",
  researchStatus: "handover-verified", verifiedAt: '2026-10-14'
};
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: tenant.name,
  url: "https://mycustomid.github.io/tangsel-tradelink/"
};
---
<BaseLayout favicon={resolveTenantFavicon(tenant, config)} title={`${tenant.name} — Tangsel TradeLink`} description={tenant.description} theme={tenant.theme}
  canonical={`${baseUrl}tenant/titik-kurniasih`} image={config.heroImage} structuredData={structuredData}>
  <SmartNfcShowcase tenant={tenant} config={config} baseUrl={baseUrl} />
</BaseLayout>
