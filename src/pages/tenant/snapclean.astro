---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SmartNfcShowcase from '../../components/SmartNfcShowcase.astro';
import config from '../../data/showcases/snapclean.json';

const baseUrl = import.meta.env.BASE_URL;
const tenant = {
  name: "Snapclean", slug: "snapclean", hall: '8', booth: '8-7C',
  category: "Household",
  description: "Home, hospitality and industrial cleaning solutions from BSD City.",
  theme: "industrial",
  researchStatus: "public-source-checked", verifiedAt: '2026-10-13'
};
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: tenant.name,
  url: "https://snapclean.co.id/index.html", sameAs: ["https://snapclean.co.id/index.html"], telephone: '+6285864558848'
};
---
<BaseLayout title={`${tenant.name} — Tangsel TradeLink`} description={tenant.description} theme={tenant.theme}
  canonical={`${baseUrl}tenant/${tenant.slug}`} image={config.heroImage} structuredData={structuredData}>
  <SmartNfcShowcase tenant={tenant} config={config} baseUrl={baseUrl} />
</BaseLayout>
