---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EnhancedRichTenantShowcase from '../../components/EnhancedRichTenantShowcase.astro';
import config from '../../data/showcases/raja-freeze-dried.json';

const baseUrl = import.meta.env.BASE_URL;
const tenant = {
  name: 'Raja Freeze Dried Food', slug: 'raja-freeze-dried', hall: '8', booth: '8-7C',
  category: 'Food Technology · Freeze Dried Manufacturing',
  description: 'Raja Freeze Dried Food provides freeze-dried products, product development and B2B freeze-drying services for food and botanical materials.',
  theme: 'food', website: 'https://rajafreezdriedfood.com/', whatsapp: 'https://wa.me/6282124985339',
  email: 'info@rajafreezdriedfood.com', logo: '/brand/raja-freeze-dried-logo.webp',
  researchStatus: 'primary-source-checked', verifiedAt: '2026-10-13'
};
const structuredData = {
  '@context': 'https://schema.org', '@type': 'Organization', name: tenant.name, url: tenant.website,
  email: tenant.email, telephone: '+62 821-2498-5339'
};
---
<BaseLayout title="Raja Freeze Dried Food — Tangsel TradeLink" description={tenant.description} theme="food"
  favicon={tenant.logo} canonical={`${baseUrl}tenant/raja-freeze-dried`}
  image={config.heroImage} structuredData={structuredData}>
  <EnhancedRichTenantShowcase tenant={tenant} config={config} baseUrl={baseUrl} />
</BaseLayout>
