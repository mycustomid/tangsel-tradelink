---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SmartNfcShowcase from '../../components/SmartNfcShowcase.astro';
import config from '../../data/showcases/elleta.json';

const baseUrl = import.meta.env.BASE_URL;
const tenant = {
  name: "ELLETA", slug: "elleta", hall: '8', booth: '8-7C',
  category: "Fashion, Handicraft & Home Decor",
  description: "Modern batik and woven-textile profile for buyer and Google Review discovery.",
  theme: "editorial",
  researchStatus: "handover-verified", verifiedAt: '2026-10-13'
};
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: tenant.name,
  url: "https://www.instagram.com/elleta.official", sameAs: ["https://www.instagram.com/elleta.official", "https://www.instagram.com/elleta.butik"]
};
---
<BaseLayout title={`${tenant.name} — Tangsel TradeLink`} description={tenant.description} theme={tenant.theme}
  canonical={`${baseUrl}tenant/${tenant.slug}`} image={config.heroImage} structuredData={structuredData}>
  <SmartNfcShowcase tenant={tenant} config={config} baseUrl={baseUrl} />
</BaseLayout>
