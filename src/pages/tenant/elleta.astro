---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { resolveTenantFavicon } from '../../lib/tenant-utils.mjs';
import SmartNfcShowcase from '../../components/SmartNfcShowcase.astro';
import config from '../../data/showcases/elleta.json';

const baseUrl = import.meta.env.BASE_URL;
const tenant = {
  name: "Elleta", slug: "elleta", hall: '8', booth: '8-7C',
  category: "Fashion, Handicraft & Home Decor",
  description: "Profil resmi Elleta oleh Joanita Kusumawati di TEI 2026. Menghadirkan 3 kategori utama: Pakaian Pria, Pakaian Wanita, dan Aksesoris wastra nusantara.",
  theme: "editorial",
  researchStatus: "handover-verified", verifiedAt: '2026-10-17'
};
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: tenant.name,
  url: "https://www.instagram.com/elleta.official",
  sameAs: [
    "https://www.instagram.com/elleta.official",
    "https://www.instagram.com/elleta.butik",
    "https://www.facebook.com/share/19fsCSCgHh/",
    "https://share.google/EsjShAAf7wdLIb8f0"
  ]
};
---
<BaseLayout favicon={resolveTenantFavicon(tenant, config)} title={`${tenant.name} — Tangsel TradeLink`} description={tenant.description} theme={tenant.theme}
  canonical={`${baseUrl}tenant/${tenant.slug}`} image={config.heroImage} structuredData={structuredData}>
  <SmartNfcShowcase tenant={tenant} config={config} baseUrl={baseUrl} />
</BaseLayout>
