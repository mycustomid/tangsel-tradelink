---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { resolveTenantFavicon } from '../../lib/tenant-utils.mjs';
import SmartNfcShowcase from '../../components/SmartNfcShowcase.astro';
import config from '../../data/showcases/den-bagus.json';

const baseUrl = import.meta.env.BASE_URL;
const tenant = {
  name: "Den Bagus", slug: "den-bagus", hall: '8', booth: '8-7C',
  category: "Food, Beverage & Agriculture Products",
  description: "Peyek tradisional gurih renyah khas Setu oleh Bu Mimin Casmiaty — tembus ritel modern & Bandara Soekarno-Hatta Terminal 2.",
  theme: "food",
  researchStatus: "verified-authoritative", verifiedAt: '2026-10-15'
};
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: tenant.name,
  url: "https://mycustomid.github.io/tangsel-tradelink/tenant/den-bagus",
  sameAs: [
    "https://shopee.co.id/mimincasmiaty",
    "https://www.instagram.com/peyek_denbagus/",
    "https://tangselpos.id/detail/52672/peyek-den-bagus-dari-setu-rambah-bandara"
  ]
};
---
<BaseLayout favicon={resolveTenantFavicon(tenant, config)} title={`${tenant.name} — Tangsel TradeLink`} description={tenant.description} theme={tenant.theme}
  canonical={`${baseUrl}tenant/${tenant.slug}`} image={config.heroImage} structuredData={structuredData}>
  <SmartNfcShowcase tenant={tenant} config={config} baseUrl={baseUrl} />
</BaseLayout>
