---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { resolveTenantFavicon } from '../../lib/tenant-utils.mjs';
import SmartNfcShowcase from '../../components/SmartNfcShowcase.astro';
import config from '../../data/showcases/sapa-legend-coffee.json';

const baseUrl = import.meta.env.BASE_URL;
const tenant = {
  name: "Sapa Legend Coffee", slug: "sapa-legend-coffee", hall: '8', booth: '8-7C',
  category: "Food, Beverage & Agriculture Products",
  description: "Global Coffee Brand Partner — End-to-end multi-origin green coffee supply, OEM/private label roasting & instant solutions from Vietnamese highlands.",
  theme: "food",
  whatsapp: "https://wa.me/qr/SKWPLFU7THBTC1",
  website: "https://www.sapalegendcoffee.vn",
  researchStatus: "verified-authoritative", verifiedAt: '2026-10-15'
};
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: tenant.name,
  url: "https://mycustomid.github.io/tangsel-tradelink/"
};
---
<BaseLayout favicon={resolveTenantFavicon(tenant, config)} title={`${tenant.name} — Tangsel TradeLink`} description={tenant.description} theme={tenant.theme}
  canonical={`${baseUrl}tenant/${tenant.slug}`} image={config.heroImage} structuredData={structuredData}>
  <SmartNfcShowcase tenant={tenant} config={config} baseUrl={baseUrl} />
</BaseLayout>
