---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TenantHeader from '../../components/TenantHeader.astro';
import LinkButton from '../../components/LinkButton.astro';

const tenant = {
  name: 'LIULI FASHION & CRAFT',
  category: 'Fashion, Handicraft & Home Decor',
  hall: '',
  booth: '',
  description: 'Official digital links for LIULI Fashion & Craft.',
};

const links = [
  { href: 'https://www.instagram.com/liuli_fashion?stkn=MTRiZWUyZXl2cnhkNw==', label: 'Instagram Fashion', icon: 'instagram' },
  { href: 'https://www.instagram.com/liulicraft?stkn=dW40MDl6MzE0cGFo', label: 'Instagram Craft', icon: 'instagram' },
  { href: 'https://www.tiktok.com/@liulicraft1?_r=1&_t=ZS-99pJDrdmjUC', label: 'TikTok', icon: 'tiktok' },
  { href: 'https://www.facebook.com/share/19HGUgaRBb/?mibextid=wwXIfr', label: 'Facebook', icon: 'facebook' },
];
const baseUrl = import.meta.env.BASE_URL;
---

<BaseLayout title="LIULI FASHION & CRAFT — Tangsel TradeLink" description="Official digital links for LIULI Fashion & Craft at Tangsel TradeLink." theme="editorial">
  <main class="tenant-page shell">
    <TenantHeader
      name={tenant.name}
      category={tenant.category}
      hall={tenant.hall}
      booth={tenant.booth}
      description={tenant.description}
      researchStatus="web-verified"
      verifiedAt="2026-09-18"
    />

    <section class="connect-head" aria-labelledby="connect-title">
      <div>
        <p class="kicker">Connect with tenant</p>
        <h2 id="connect-title">Official links</h2>
      </div>
      <span class="count">{links.length} available</span>
    </section>

    <section class="links" aria-label="Official links for LIULI Fashion & Craft">
      {links.map((link) => <LinkButton href={link.href} label={link.label} icon={link.icon} />)}
    </section>

    <aside class="source-note">
      <span aria-hidden="true">✓</span>
      <p>Digital links supplied by Disperindag Tangerang Selatan and published on 18 September 2026.</p>
    </aside>

    <footer>
      <span>Powered by Tangsel TradeLink</span>
      <a href={baseUrl}>Tenant directory</a>
    </footer>
  </main>
</BaseLayout>

<style>
  .tenant-page { padding-top: 14px; padding-bottom: 26px; }
  .connect-head { display: flex; justify-content: space-between; align-items: end; gap: 14px; margin: 22px 4px 10px; }
  .kicker { margin: 0 0 3px; color: var(--muted); font-size: .72rem; font-weight: 900; letter-spacing: .08em; text-transform: uppercase; }
  h2 { margin: 0; font-size: 1.15rem; letter-spacing: -.025em; }
  .count { flex: none; color: var(--muted); font-size: .72rem; font-weight: 800; }
  .links { display: grid; gap: 10px; }
  .source-note { display: flex; gap: 9px; margin: 18px 4px 0; padding: 12px 14px; border-radius: 14px; background: rgba(255,255,255,.42); color: var(--muted); font-size: .72rem; line-height: 1.45; }
  .source-note p { margin: 0; }
  .source-note span { color: var(--accent-strong); font-weight: 900; }
  footer { display: flex; justify-content: space-between; gap: 12px; margin-top: 22px; padding: 0 4px; color: var(--muted); font-size: .72rem; }
  footer a { color: inherit; text-decoration: none; font-weight: 800; }
  footer a:hover, footer a:focus-visible { color: var(--accent-strong); }
  @media (max-width: 430px) { .tenant-page { width: min(100% - 20px, 760px); } footer { flex-direction: column; align-items: center; } }
</style>
