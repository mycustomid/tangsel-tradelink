---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SmartNfcShowcase from '../../components/SmartNfcShowcase.astro';
import config from '../../data/showcases/hhb.json';
const baseUrl = import.meta.env.BASE_URL;
const tenant = {
  name:'PT Harmoni Harapan Bersama', slug:'hhb', hall:'5', booth:'5-14',
  category:'Services & Logistic',
  description:'International freight forwarding, customs brokerage, project cargo and door-to-door logistics — PT Harmoni Harapan Bersama.',
  theme:'industrial', website:'https://www.hhb.co.id/id', whatsapp:'https://wa.me/6281806265777',
  researchStatus:'public-source-checked', verifiedAt:'2026-10-13'
};
const structuredData = {
  '@context':'https://schema.org','@type':'Organization',name:tenant.name,
  url:tenant.website,email:'cs@hhb.co.id',telephone:'+62 21 5316 9909',
  address:{'@type':'PostalAddress',addressLocality:'Tangerang Selatan',addressRegion:'Banten',addressCountry:'ID'}
};
---
<BaseLayout title="PT Harmoni Harapan Bersama — Tangsel TradeLink" description={tenant.description} theme="industrial"
  canonical={`${baseUrl}tenant/hhb`} image={config.heroImage} structuredData={structuredData}>
  <SmartNfcShowcase tenant={tenant} config={config} baseUrl={baseUrl} />
</BaseLayout>
