---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { resolveTenantFavicon } from '../../lib/tenant-utils.mjs';
import SmartNfcShowcase from '../../components/SmartNfcShowcase.astro';
import config from '../../data/showcases/pt-niaga-citra-mandiri.json';

const baseUrl = import.meta.env.BASE_URL;
const tenant = {
  name: "PT Niaga Citra Mandiri", slug: "pt-niaga-citra-mandiri", hall: '8', booth: '8-7C',
  category: "Services & Logistic",
  description: "Trade and commodity profile prepared for TEI 2026 business matching.",
  theme: "industrial",
  researchStatus: "handover-verified", verifiedAt: '2026-10-13'
};
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: tenant.name,
  url: "https://mycustomid.github.io/tangsel-tradelink/"
};
---
<BaseLayout favicon={resolveTenantFavicon(tenant, config)} title={`${tenant.name} — Tangsel TradeLink`} description={tenant.description} theme={tenant.theme}
  canonical={`${baseUrl}tenant/${tenant.slug}`} image={config.heroImage} structuredData={structuredData}>
  <SmartNfcShowcase tenant={tenant} config={config} baseUrl={baseUrl} />
</BaseLayout>
