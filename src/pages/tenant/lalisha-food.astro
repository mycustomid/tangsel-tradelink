---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SmartNfcShowcase from '../../components/SmartNfcShowcase.astro';
import config from '../../data/showcases/lalisha-food.json';

const baseUrl = import.meta.env.BASE_URL;
const tenant = {
  name: "Lalisha Food", slug: "lalisha-food", hall: '8', booth: '8-7C',
  category: "Food, Beverage & Agriculture Products",
  description: "Instant seblak in Original Kencur and Keju Creamy formats.",
  theme: "food",
  researchStatus: "public-source-checked", verifiedAt: '2026-10-13'
};
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: tenant.name,
  url: "https://kurasi.tangerangselatankota.go.id/produk/398", sameAs: ["https://www.instagram.com/lalishafood", "https://www.tiktok.com/@lalishafood", "https://kurasi.tangerangselatankota.go.id/produk/398"], telephone: '+6285779060370'
};
---
<BaseLayout title={`${tenant.name} — Tangsel TradeLink`} description={tenant.description} theme={tenant.theme}
  canonical={`${baseUrl}tenant/${tenant.slug}`} image={config.heroImage} structuredData={structuredData}>
  <SmartNfcShowcase tenant={tenant} config={config} baseUrl={baseUrl} />
</BaseLayout>
