---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SmartNfcShowcase from '../../components/SmartNfcShowcase.astro';
import config from '../../data/showcases/shirudo-lab.json';

const baseUrl = import.meta.env.BASE_URL;
const tenant = {
  name: "Shirudo Lab", slug: "shirudo-lab", hall: '8', booth: '8-7C',
  category: "Health, Beauty & Personal Care",
  description: "Aromatherapy and body-care formats for everyday wellness routines.",
  theme: "beauty",
  researchStatus: "public-source-checked", verifiedAt: '2026-10-13'
};
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: tenant.name,
  url: "https://www.instagram.com/shirudolabindonesia", sameAs: ["https://www.instagram.com/shirudolabindonesia", "https://shopee.co.id/shirudo.lab"]
};
---
<BaseLayout title={`${tenant.name} — Tangsel TradeLink`} description={tenant.description} theme={tenant.theme}
  canonical={`${baseUrl}tenant/${tenant.slug}`} image={config.heroImage} structuredData={structuredData}>
  <SmartNfcShowcase tenant={tenant} config={config} baseUrl={baseUrl} />
</BaseLayout>
