---
import BaseLayout from '../../layouts/BaseLayout.astro';
import RoemahKoffieFlagship from '../../components/RoemahKoffieFlagship.astro';
import EnhancedRichTenantShowcase from '../../components/EnhancedRichTenantShowcase.astro';
import AdaptiveTenantShowcase from '../../components/AdaptiveTenantShowcase.astro';
import '../../styles/premium-tenant-ux.css';
import roemahFlagship from '../../data/flagships/roemah-koffie.json';
import sanfoodShowcase from '../../data/showcases/sanfood-internasional.json';
import tempeAzakiShowcase from '../../data/showcases/tempe-azaki.json';
import tmminShowcase from '../../data/showcases/toyota-motor-manufacturing-indonesia-pt-tmmin.json';
import tatalogamShowcase from '../../data/showcases/tatalogam-lestari-pt.json';
import morrisShowcase from '../../data/showcases/aroma-prima-livindo-pt-morris-perfume.json';
import dragonShowcase from '../../data/showcases/dragon-prima-farma.json';
import cleanMaticShowcase from '../../data/showcases/clean-matic.json';
import sinarMasLandShowcase from '../../data/showcases/sinar-mas-land.json';
import himkiShowcase from '../../data/showcases/himki.json';
import liUliShowcase from '../../data/showcases/li-uli.json';
import agemanShowcase from '../../data/showcases/ageman-ecoprint.json';
import owiRajutShowcase from '../../data/showcases/owi-rajut.json';
import tenants from '../../data/tenants.json';
import foodResearch from '../../data/research-food.json';
import manufacturedResearch from '../../data/research-manufactured.json';
import industrialResearch from '../../data/research-industrial.json';
import furnitureResearch from '../../data/research-furniture.json';
import fashionResearch from '../../data/research-fashion.json';
import { getTenantArtDirection } from '../../data/tenant-art-directions.mjs';
import { getTenantLinks, getTenantLogo, makeMonogramFavicon, resolveTheme, resolveTenantFavicon } from '../../lib/tenant-utils.mjs';
import type { Tenant } from '../../types/tenant';

export function getStaticPaths() {
  const research = { ...foodResearch, ...manufacturedResearch, ...industrialResearch, ...furnitureResearch, ...fashionResearch } as Record<string, Partial<Tenant>>;
  return (tenants as Tenant[]).map((baseTenant) => ({
    params: { slug: baseTenant.slug },
    props: { tenant: { ...baseTenant, ...(research[baseTenant.slug] || {}) } },
  }));
}

interface Props { tenant: Tenant }
const { tenant } = Astro.props;
const theme = resolveTheme(tenant);
const links = getTenantLinks(tenant);
const logo = getTenantLogo(tenant);
const baseUrl = import.meta.env.BASE_URL;
const showcaseConfigs: Record<string, any> = {
  'sanfood-internasional': sanfoodShowcase,
  'tempe-azaki': tempeAzakiShowcase,
  'toyota-motor-manufacturing-indonesia-pt-tmmin': tmminShowcase,
  'tatalogam-lestari-pt': tatalogamShowcase,
  'aroma-prima-livindo-pt-morris-perfume': morrisShowcase,
  'dragon-prima-farma': dragonShowcase,
  'clean-matic': cleanMaticShowcase,
  'sinar-mas-land': sinarMasLandShowcase,
  'himki': himkiShowcase,
  'li-uli': liUliShowcase,
  'ageman-ecoprint': agemanShowcase,
  'owi-rajut': owiRajutShowcase,
};
const showcaseConfig = showcaseConfigs[tenant.slug];
const artDirection = getTenantArtDirection(tenant.slug);
const isPremium = tenant.slug === 'roemah-koffie' || Boolean(showcaseConfig);
const favicon = tenant.slug === 'toyota-motor-manufacturing-indonesia-pt-tmmin'
  ? makeMonogramFavicon('TMMIN', '#eb0a1e', '#ffffff')
  : resolveTenantFavicon(tenant, showcaseConfig);
const pageTitle = isPremium ? tenant.name : `${tenant.name} — Tangsel TradeLink`;
const roemahPrimaryAction = roemahFlagship.primaryActions?.[0];
if (!artDirection) throw new Error(`Missing tenant art direction for ${tenant.slug}`);
---

<BaseLayout title={pageTitle} description={tenant.description || `${tenant.name} at Trade Expo Indonesia 2026.`} theme={theme} favicon={favicon}>
  {tenant.slug === 'roemah-koffie' ? (
    <div class="premium-ux-shell roemah-shell">
      <RoemahKoffieFlagship tenant={tenant} config={roemahFlagship} baseUrl={baseUrl} />
      {roemahPrimaryAction && (
        <div class="premium-mobile-cta roemah-mobile-cta" aria-label="Recommended next step for Roemah Koffie">
          <a href={roemahPrimaryAction.url} target="_blank" rel="noopener noreferrer">
            <span>Recommended next step</span>
            <strong>{roemahPrimaryAction.label}</strong>
            <b aria-hidden="true">↗</b>
          </a>
        </div>
      )}
    </div>
  ) : showcaseConfig ? (
    <EnhancedRichTenantShowcase tenant={tenant} config={showcaseConfig} baseUrl={baseUrl} />
  ) : (
    <AdaptiveTenantShowcase tenant={tenant} links={links} logo={logo} direction={artDirection} baseUrl={baseUrl} />
  )}
</BaseLayout>
