---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TenantHeader from '../../components/TenantHeader.astro';
import LinkButton from '../../components/LinkButton.astro';
import tenants from '../../data/tenants.json';
import { getTenantLinks, resolveTheme } from '../../lib/tenant-utils.mjs';
import type { Tenant } from '../../types/tenant';

export function getStaticPaths() {
  return (tenants as Tenant[]).map((tenant) => ({
    params: { slug: tenant.slug },
    props: { tenant },
  }));
}

interface Props { tenant: Tenant }
const { tenant } = Astro.props;
const theme = resolveTheme(tenant);
const links = getTenantLinks(tenant);
---

<BaseLayout
  title={`${tenant.name} — Tangsel TradeLink`}
  description={tenant.description || `${tenant.name} di Trade Expo Indonesia 2026.`}
  theme={theme}
>
  <main class="tenant-page shell">
    <a class="back" href="/" aria-label="Kembali ke direktori tenant">← Direktori</a>

    <TenantHeader
      name={tenant.name}
      category={tenant.category}
      hall={tenant.hall}
      booth={tenant.booth}
      description={tenant.description}
      logo={tenant.logo}
    />

    {links.length > 0 ? (
      <section class="links" aria-label={`Tautan ${tenant.name}`}>
        {links.map((link) => (
          <LinkButton href={link.href} label={link.label} icon={link.icon} />
        ))}
      </section>
    ) : (
      <section class="links-empty">
        <p>Kontak dan tautan tenant belum tersedia.</p>
      </section>
    )}

    <footer>
      <span>Powered by Tangsel TradeLink</span>
      <span>TEI 2026</span>
    </footer>
  </main>
</BaseLayout>

<style>
  .tenant-page { padding-top: 14px; padding-bottom: 26px; }
  .back { display: inline-flex; margin: 0 0 12px 4px; padding: 8px 0; color: var(--muted); font-size: .82rem; font-weight: 800; text-decoration: none; }
  .back:hover, .back:focus-visible { color: var(--accent-strong); outline: none; }
  .links { display: grid; gap: 10px; margin-top: 16px; }
  .links-empty { margin-top: 16px; padding: 18px; border: 1px dashed var(--line); border-radius: 18px; text-align: center; color: var(--muted); background: rgba(255,255,255,.55); }
  .links-empty p { margin: 0; }
  footer { display: flex; justify-content: space-between; gap: 12px; margin-top: 24px; padding: 0 4px; color: var(--muted); font-size: .72rem; }

  @media (max-width: 430px) {
    .tenant-page { width: min(100% - 20px, 760px); }
    footer { flex-direction: column; align-items: center; }
  }
</style>
