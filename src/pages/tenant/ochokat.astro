---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SmartNfcShowcase from '../../components/SmartNfcShowcase.astro';
import config from '../../data/showcases/ochokat.json';

const baseUrl = import.meta.env.BASE_URL;
const tenant = {
  name: "OChokat", slug: "ochokat", hall: '8', booth: '8-7C',
  category: "Food, Beverage & Agriculture Products",
  description: "Artisan chocolate profile from the BSD area.",
  theme: "food",
  researchStatus: "handover-verified", verifiedAt: '2026-10-13'
};
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: tenant.name,
  url: "https://mycustomid.github.io/tangsel-tradelink/"
};
---
<BaseLayout title={`${tenant.name} — Tangsel TradeLink`} description={tenant.description} theme={tenant.theme}
  canonical={`${baseUrl}tenant/${tenant.slug}`} image={config.heroImage} structuredData={structuredData}>
  <SmartNfcShowcase tenant={tenant} config={config} baseUrl={baseUrl} />
</BaseLayout>
