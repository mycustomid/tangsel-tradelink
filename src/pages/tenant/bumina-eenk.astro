---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EnhancedRichTenantShowcase from '../../components/EnhancedRichTenantShowcase.astro';
import config from '../../data/showcases/bumina-eenk.json';

const baseUrl = import.meta.env.BASE_URL;
const tenant = {
  name: 'Homestay Bumina EENK', slug: 'bumina-eenk', hall: '8', booth: '8-7C',
  category: 'Hospitality · Homestay & Tourism',
  description: 'Homestay Bumina EENK is a Pangalengan highland property near Taman Langit, with direct booking and OTA discovery routes.',
  theme: 'editorial', website: 'https://buminaeenk.com/', instagram: 'https://www.instagram.com/homestay_buminaeenk/',
  whatsapp: 'https://wa.me/6285219460779', maps: 'https://www.google.com/maps/search/?api=1&query=Homestay+Bumina+Eenk+Pangalengan',
  logo: '/brand/bumina-eenk-logo.webp', researchStatus: 'primary-plus-ota', verifiedAt: '2026-10-13'
};
const structuredData = {
  '@context': 'https://schema.org', '@type': 'LodgingBusiness', name: tenant.name, url: tenant.website,
  telephone: '+62 852-1946-0779', address: { '@type': 'PostalAddress', addressLocality: 'Pangalengan', addressRegion: 'Jawa Barat', addressCountry: 'ID' },
  sameAs: [tenant.instagram]
};
---
<BaseLayout title="Homestay Bumina EENK — Tangsel TradeLink" description={tenant.description} theme="editorial" favicon="/brand/bumina-eenk-favicon.png"
  canonical={`${baseUrl}tenant/bumina-eenk`} image={config.heroImage} structuredData={structuredData}>
  <EnhancedRichTenantShowcase tenant={tenant} config={config} baseUrl={baseUrl} />
</BaseLayout>
