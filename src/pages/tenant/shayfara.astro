---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { resolveTenantFavicon } from '../../lib/tenant-utils.mjs';
import SmartNfcShowcase from '../../components/SmartNfcShowcase.astro';
import config from '../../data/showcases/shayfara.json';

const baseUrl = import.meta.env.BASE_URL;
const tenant = {
  name: "ShayFara (PT Rempah Sumber Rezeki)", slug: "shayfara", hall: '8', booth: '8-7C',
  category: "Food, Beverage & Agriculture Products",
  description: "Minuman Rempah Modern Nusantara — Kopi Rempah, Kopi Susu Rempah, Coklat Rempah, Susu Rempah & Wedang Alami.",
  theme: "food",
  whatsapp: "https://wa.me/c/6285778880047", instagram: "https://www.instagram.com/shayfara_rempahsumberrezeki",
  website: "https://s.id/ShayFara-RempahModernPilihanNusantara",
  researchStatus: "verified-authoritative", verifiedAt: '2026-10-15'
};
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: tenant.name,
  url: "https://mycustomid.github.io/tangsel-tradelink/"
};
---
<BaseLayout favicon={resolveTenantFavicon(tenant, config)} title={`${tenant.name} — Tangsel TradeLink`} description={tenant.description} theme={tenant.theme}
  canonical={`${baseUrl}tenant/${tenant.slug}`} image={config.heroImage} structuredData={structuredData}>
  <SmartNfcShowcase tenant={tenant} config={config} baseUrl={baseUrl} />
</BaseLayout>
