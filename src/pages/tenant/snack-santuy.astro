---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { resolveTenantFavicon } from '../../lib/tenant-utils.mjs';
import SmartNfcShowcase from '../../components/SmartNfcShowcase.astro';
import config from '../../data/showcases/snack-santuy.json';

const baseUrl = import.meta.env.BASE_URL;
const tenant = {
  name: "Snack Santuy",
  slug: "snack-santuy",
  hall: '7',
  booth: '7-18',
  category: "Food, Beverage & Agriculture Products",
  description: "Solusi Sehat Keripik Sayur & Buah Crispy — Tanpa Gula Tambahan, Tanpa Pengawet, Halal & PIRT.",
  theme: "food",
  whatsapp: "https://wa.me/62881025252498",
  website: "",
  researchStatus: "verified-authoritative",
  verifiedAt: '2026-10-15'
};
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: tenant.name,
  url: "https://mycustomid.github.io/tangsel-tradelink/tenant/snack-santuy"
};
---
<BaseLayout favicon={resolveTenantFavicon(tenant, config)} title={`${tenant.name} — Tangsel TradeLink`} description={tenant.description} theme={tenant.theme}
  canonical={`${baseUrl}tenant/${tenant.slug}`} image={config.heroImage} structuredData={structuredData}>
  <SmartNfcShowcase tenant={tenant} config={config} baseUrl={baseUrl} />
</BaseLayout>
