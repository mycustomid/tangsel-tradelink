---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SmartNfcShowcase from '../../components/SmartNfcShowcase.astro';
import config from '../../data/showcases/eni-chandra.json';

const baseUrl = import.meta.env.BASE_URL;
const tenant = {
  name: "Eni Chandra Shanti", slug: "eni-chandra", hall: '8', booth: '8-7C',
  category: "Fashion, Handicraft & Home Decor",
  description: "Creative-product profile staged for Smart NFC activation.",
  theme: "editorial",
  researchStatus: "links-pending", verifiedAt: '2026-10-13'
};
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: tenant.name,
  url: "https://mycustomid.github.io/tangsel-tradelink/"
};
---
<BaseLayout title={`${tenant.name} — Tangsel TradeLink`} description={tenant.description} theme={tenant.theme}
  canonical={`${baseUrl}tenant/${tenant.slug}`} image={config.heroImage} structuredData={structuredData}>
  <SmartNfcShowcase tenant={tenant} config={config} baseUrl={baseUrl} />
</BaseLayout>
