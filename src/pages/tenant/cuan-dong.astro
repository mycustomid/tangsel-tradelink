---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { resolveTenantFavicon } from '../../lib/tenant-utils.mjs';
import SmartNfcShowcase from '../../components/SmartNfcShowcase.astro';
import config from '../../data/showcases/cuan-dong.json';
import commodities from '../../data/cuan-dong-commodities.json';

const baseUrl = import.meta.env.BASE_URL;
const normalizedBase = String(baseUrl || '').replace(/\/$/, '');
const tenant = {
  name: "CUAN-DONG Global Holdings",
  slug: "cuan-dong",
  hall: '8',
  booth: '8-7C',
  category: "Export Procurement & Trade Operations",
  description: "Evidence-led Indonesian export procurement and structured B2B supply chain orchestration.",
  theme: "tech",
  researchStatus: "verified",
  verifiedAt: '2026-10-16'
};
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: tenant.name,
  url: "https://cuan-dong.com/",
  sameAs: ["https://www.instagram.com/cuandong_holdings"]
};
---
<BaseLayout
  lang="en"
  favicon={resolveTenantFavicon(tenant, config)}
  title={`${tenant.name} — Tangsel TradeLink`}
  description={tenant.description}
  theme={tenant.theme}
  canonical={`${baseUrl}tenant/${tenant.slug}`}
  image={config.heroImage}
  structuredData={structuredData}
>
  <SmartNfcShowcase tenant={tenant} config={config} baseUrl={baseUrl} />

  <section class="cd-directory-wrap" aria-labelledby="commodity-directory-title" lang="en">
    <div class="cd-directory-inner">
      <div class="cd-directory-header">
        <div>
          <p class="cd-dir-eyebrow">INSTITUTIONAL B2B PRODUCT CATALOG · 10 EXPORT COMMODITIES</p>
          <h2 id="commodity-directory-title">Export Commodity Specifications (Dedicated B2B Pages)</h2>
        </div>
        <p class="cd-dir-sub">
          Access full physical &amp; chemical lab parameters, HS codes, FCL container loadability, unbranded white-label packaging visuals, compliance certifications, and direct WhatsApp RFQ desks for each commodity.
        </p>
      </div>

      <div class="cd-dir-grid">
        {commodities.map((item) => (
          <article class="cd-dir-card">
            <a href={`${normalizedBase}/tenant/cuan-dong/${item.slug}`} class="cd-dir-thumb-link" aria-label={`View specifications for ${item.title}`}>
              <div class="cd-dir-thumb-wrap">
                <img
                  src={`${normalizedBase}${item.heroImage}`}
                  alt={item.title}
                  width="640"
                  height="420"
                  loading="lazy"
                  decoding="async"
                  onerror="this.style.display='none'"
                />
                <span class="cd-dir-whitelabel-badge">Unbranded · White-Label Ready</span>
              </div>
            </a>
            <div class="cd-dir-card-body">
              <div class="cd-dir-card-top">
                <span class="cd-dir-cat">{item.category}</span>
                <span class="cd-dir-hs">HS {item.hsCode}</span>
              </div>
              <h3 class="cd-dir-title">
                <a href={`${normalizedBase}/tenant/cuan-dong/${item.slug}`}>{item.title}</a>
              </h3>
              <p class="cd-dir-origin"><strong>Origin:</strong> {item.origin}</p>
              <p class="cd-dir-desc">{item.shortDescription}</p>
              <dl class="cd-dir-specs">
                <div>
                  <dt>MOQ</dt>
                  <dd>{item.minOrderQuantity}</dd>
                </div>
                <div>
                  <dt>Monthly Supply</dt>
                  <dd>{item.supplyCapacity}</dd>
                </div>
              </dl>
              <div class="cd-dir-actions">
                <a href={`${normalizedBase}/tenant/cuan-dong/${item.slug}`} class="cd-dir-btn-spec">
                  <span>Technical Spec &amp; COA</span>
                  <span aria-hidden="true">→</span>
                </a>
                <a href={item.rfqAction.whatsappUrl} target="_blank" rel="noopener noreferrer" class="cd-dir-btn-wa">
                  <span>RFQ Desk</span>
                  <span aria-hidden="true">↗</span>
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .cd-directory-wrap {
    background: #07162d;
    color: #f8fafc;
    padding: clamp(40px, 6vw, 76px) clamp(18px, 4vw, 54px) clamp(56px, 8vw, 96px);
    border-top: 1px solid rgba(56, 189, 248, 0.22);
  }

  .cd-directory-inner {
    max-width: 1180px;
    margin: 0 auto;
  }

  .cd-directory-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 28px;
    margin-bottom: 32px;
  }

  .cd-dir-eyebrow {
    margin: 0 0 10px;
    font-size: 0.7rem;
    font-weight: 900;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #38bdf8;
  }

  .cd-directory-header h2 {
    margin: 0;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(1.85rem, 3.8vw, 3.2rem);
    font-weight: 400;
    line-height: 1.04;
    letter-spacing: -0.03em;
    color: #ffffff;
  }

  .cd-dir-sub {
    margin: 0;
    max-width: 440px;
    font-size: 0.85rem;
    line-height: 1.6;
    color: #94a3b8;
  }

  .cd-dir-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
  }

  .cd-dir-card {
    border-radius: 20px;
    background: #0f2444;
    border: 1px solid rgba(148, 163, 184, 0.18);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform 0.18s ease, border-color 0.18s ease, box-shadow 0.18s ease;
  }

  .cd-dir-card:hover {
    transform: translateY(-3px);
    border-color: rgba(56, 189, 248, 0.45);
    box-shadow: 0 18px 40px -14px rgba(0, 0, 0, 0.55);
  }

  .cd-dir-thumb-link {
    display: block;
    text-decoration: none;
  }

  .cd-dir-thumb-wrap {
    position: relative;
    aspect-ratio: 16 / 10;
    background: #061226;
    overflow: hidden;
    border-bottom: 1px solid rgba(148, 163, 184, 0.16);
  }

  .cd-dir-thumb-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.35s ease;
  }

  .cd-dir-card:hover .cd-dir-thumb-wrap img {
    transform: scale(1.03);
  }

  .cd-dir-whitelabel-badge {
    position: absolute;
    bottom: 12px;
    left: 12px;
    padding: 5px 10px;
    border-radius: 999px;
    background: rgba(7, 22, 45, 0.88);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid rgba(56, 189, 248, 0.35);
    color: #38bdf8;
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .cd-dir-card-body {
    padding: 22px 24px 24px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .cd-dir-card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
    margin-bottom: 12px;
  }

  .cd-dir-cat {
    font-size: 0.68rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #38bdf8;
  }

  .cd-dir-hs {
    padding: 4px 9px;
    border-radius: 6px;
    background: rgba(245, 158, 11, 0.15);
    border: 1px solid rgba(245, 158, 11, 0.35);
    color: #fbbf24;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.7rem;
    font-weight: 800;
  }

  .cd-dir-title {
    margin: 0 0 8px;
    font-size: 1.2rem;
    font-weight: 800;
    line-height: 1.3;
  }

  .cd-dir-title a {
    color: #ffffff;
    text-decoration: none;
  }

  .cd-dir-title a:hover {
    color: #38bdf8;
  }

  .cd-dir-origin {
    margin: 0 0 10px;
    font-size: 0.76rem;
    color: #cbd5e1;
  }

  .cd-dir-desc {
    margin: 0 0 16px;
    font-size: 0.82rem;
    line-height: 1.55;
    color: #94a3b8;
    flex: 1;
  }

  .cd-dir-specs {
    margin: 0 0 18px;
    padding: 12px 0;
    border-top: 1px solid rgba(148, 163, 184, 0.16);
    border-bottom: 1px solid rgba(148, 163, 184, 0.16);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }

  .cd-dir-specs div {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .cd-dir-specs dt {
    font-size: 0.65rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #64748b;
  }

  .cd-dir-specs dd {
    margin: 0;
    font-size: 0.78rem;
    font-weight: 700;
    color: #f8fafc;
  }

  .cd-dir-actions {
    display: grid;
    grid-template-columns: 1.35fr 0.65fr;
    gap: 10px;
  }

  .cd-dir-btn-spec,
  .cd-dir-btn-wa {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 14px;
    border-radius: 10px;
    font-size: 0.78rem;
    font-weight: 800;
    text-decoration: none;
  }

  .cd-dir-btn-spec {
    background: #38bdf8;
    color: #07162d;
  }

  .cd-dir-btn-wa {
    background: rgba(16, 185, 129, 0.16);
    border: 1px solid rgba(16, 185, 129, 0.4);
    color: #34d399;
  }

  @media (max-width: 820px) {
    .cd-directory-header {
      flex-direction: column;
      align-items: flex-start;
    }

    .cd-dir-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 520px) {
    .cd-dir-actions {
      grid-template-columns: 1fr;
    }
  }
</style>
