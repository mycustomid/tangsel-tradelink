---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { resolveTenantFavicon } from '../../lib/tenant-utils.mjs';
import SmartNfcShowcase from '../../components/SmartNfcShowcase.astro';
import config from '../../data/showcases/the-munching-queen.json';

const baseUrl = import.meta.env.BASE_URL;
const tenant = {
  name: "The Munching Queen",
  slug: "the-munching-queen",
  hall: '6',
  booth: '6-42',
  category: "Food, Beverage & Agriculture Products",
  description: "Healthy Kids & Family Snacks — Inovasi Keripik Bernutrisi Tinggi Tanpa MSG Buatan.",
  theme: "food",
  whatsapp: "https://wa.me/6281289638889",
  website: "https://www.cahaya-kencana.com",
  researchStatus: "verified-authoritative",
  verifiedAt: '2026-10-15'
};
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: tenant.name,
  url: "https://mycustomid.github.io/tangsel-tradelink/tenant/the-munching-queen"
};
---
<BaseLayout favicon={resolveTenantFavicon(tenant, config)} title={`${tenant.name} — Tangsel TradeLink`} description={tenant.description} theme={tenant.theme}
  canonical={`${baseUrl}tenant/${tenant.slug}`} image={config.heroImage} structuredData={structuredData}>
  <SmartNfcShowcase tenant={tenant} config={config} baseUrl={baseUrl} />
</BaseLayout>
