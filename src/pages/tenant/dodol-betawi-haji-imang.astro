---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SmartNfcShowcase from '../../components/SmartNfcShowcase.astro';
import config from '../../data/showcases/dodol-betawi-haji-imang.json';

const baseUrl = import.meta.env.BASE_URL;
const tenant = {
  name: "Dodol Betawi Haji Imang", slug: "dodol-betawi-haji-imang", hall: '8', booth: '8-7C',
  category: "Food, Beverage & Agriculture Products",
  description: "Betawi dodol from Pondok Cabe, Pamulang, South Tangerang.",
  theme: "food",
  researchStatus: "public-source-checked", verifiedAt: '2026-10-13'
};
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: tenant.name,
  url: "https://www.instagram.com/dodolbetawi.hajiimang", sameAs: ["https://www.instagram.com/dodolbetawi.hajiimang"]
};
---
<BaseLayout title={`${tenant.name} — Tangsel TradeLink`} description={tenant.description} theme={tenant.theme}
  canonical={`${baseUrl}tenant/${tenant.slug}`} image={config.heroImage} structuredData={structuredData}>
  <SmartNfcShowcase tenant={tenant} config={config} baseUrl={baseUrl} />
</BaseLayout>
