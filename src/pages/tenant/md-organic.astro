---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { resolveTenantFavicon } from '../../lib/tenant-utils.mjs';
import SmartNfcShowcase from '../../components/SmartNfcShowcase.astro';
import config from '../../data/showcases/md-organic.json';

const baseUrl = import.meta.env.BASE_URL;
const tenant = {
  name: 'MD Organic', slug: 'md-organic', hall: '8', booth: '8-7C',
  category: 'Food, Beverage & Agriculture Products',
  description: 'Produsen & Supplier Beras Organik Bersertifikat Indonesia — MD Organic.',
  theme: 'food', website: 'https://www.organic-md.com',
  instagram: 'https://www.instagram.com/organic_md',
  whatsapp: 'https://wa.me/6285889995454',
  researchStatus: 'primary-source-checked', verifiedAt: '2026-10-13'
};
const structuredData = {
  '@context': 'https://schema.org', '@type': 'Organization', name: tenant.name,
  url: tenant.website, telephone: '+62 858-8999-5454', sameAs: [tenant.instagram]
};
---
<BaseLayout favicon={resolveTenantFavicon(tenant, config)} title="MD Organic — Tangsel TradeLink" description={tenant.description} theme="food"
  canonical={`${baseUrl}tenant/md-organic`} image={config.heroImage} structuredData={structuredData}>
  <SmartNfcShowcase tenant={tenant} config={config} baseUrl={baseUrl} />
</BaseLayout>
