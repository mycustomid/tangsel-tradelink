---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { resolveTenantFavicon } from '../../lib/tenant-utils.mjs';
import SmartNfcShowcase from '../../components/SmartNfcShowcase.astro';
import config from '../../data/showcases/fenda-iriani.json';

const baseUrl = import.meta.env.BASE_URL;
const tenant = {
  name: "Fenda Iriani", slug: "fenda-iriani", hall: '8', booth: '8-7C',
  category: "Food, Beverage & Agriculture Products",
  description: "Curated Tangsel food products, from savoury pantry goods to ready-to-sell snacks.",
  theme: "food",
  researchStatus: "public-source-checked", verifiedAt: '2026-10-13'
};
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: tenant.name,
  url: "https://kurasi.tangerangselatankota.go.id/produk", sameAs: ["https://kurasi.tangerangselatankota.go.id/produk"]
};
---
<BaseLayout favicon={resolveTenantFavicon(tenant, config)} title={`${tenant.name} — Tangsel TradeLink`} description={tenant.description} theme={tenant.theme}
  canonical={`${baseUrl}tenant/${tenant.slug}`} image={config.heroImage} structuredData={structuredData}>
  <SmartNfcShowcase tenant={tenant} config={config} baseUrl={baseUrl} />
</BaseLayout>
