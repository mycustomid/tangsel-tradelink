---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EnhancedRichTenantShowcase from '../../components/EnhancedRichTenantShowcase.astro';
import config from '../../data/showcases/my-aicustom.json';

const baseUrl = import.meta.env.BASE_URL;
const tenant = {
  name: 'MY-AICUSTOM', slug: 'my-aicustom', hall: '8', booth: '8-7C',
  category: 'Technology & Digital Services',
  description: 'MY-AICUSTOM, operating brand PT Azka Digi, builds custom AI agents, automation, RAG, workflow integrations and data systems for business operations.',
  theme: 'editorial', website: 'https://my-aicustom.com/', instagram: 'https://www.instagram.com/myaicustom/',
  whatsapp: 'https://wa.me/6282121292938', email: 'myaicustom@gmail.com', logo: '/brand/my-aicustom-logo.webp',
  researchStatus: 'primary-source-checked', verifiedAt: '2026-10-13'
};
const structuredData = {
  '@context': 'https://schema.org', '@type': 'Organization', name: 'MY-AICUSTOM', legalName: 'PT Azka Digi',
  url: tenant.website, email: tenant.email, telephone: '+62 821-2129-2938', sameAs: [tenant.instagram]
};
---
<BaseLayout title="MY-AICUSTOM — Tangsel TradeLink" description={tenant.description} theme="editorial" favicon="/brand/my-aicustom-favicon.svg"
  canonical={`${baseUrl}tenant/my-aicustom`} image={config.heroImage} structuredData={structuredData}>
  <EnhancedRichTenantShowcase tenant={tenant} config={config} baseUrl={baseUrl} />
</BaseLayout>
