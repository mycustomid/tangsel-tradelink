---
import mobileStyles from '../styles/mobile-nfc.css?url';
import '../styles/tailwind.css';
import tenantStyles from '../styles/tenant-awwwards.css?url';
import '../styles/accessibility-rc.css';
import SeoMeta from '../components/SeoMeta.astro';

interface Props {
  title?: string;
  description?: string;
  theme?: string;
  favicon?: string;
  canonical?: string;
  image?: string;
  robots?: string;
  lang?: string;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title = 'Tangsel TradeLink',
  description = 'Direktori tenant Trade Expo Indonesia 2026 untuk akses cepat setelah tap NFC.',
  theme = 'default',
  favicon = 'data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>↗</text></svg>',
  canonical,
  image,
  robots = 'index,follow,max-image-preview:large',
  lang = 'id',
  structuredData,
} = Astro.props;

const basePath = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const isTenantRoute = Astro.url.pathname.includes('/tenant/');
const defaultFavicon = `${basePath}favicon.svg`;
const faviconPath = favicon
  ? (favicon.startsWith('http://') || favicon.startsWith('https://') || favicon.startsWith('data:')
      ? favicon
      : favicon.startsWith(basePath)
        ? favicon
        : `${basePath}${favicon.replace(/^\//, '')}`)
  : defaultFavicon;
const isSvg = faviconPath.endsWith('.svg');
const isPng = faviconPath.endsWith('.png');
const isIco = faviconPath.endsWith('.ico');
const isWebp = faviconPath.endsWith('.webp');
const pngFallback = faviconPath;

const origin = Astro.site ?? new URL(Astro.url.origin);
const canonicalPath = (canonical || Astro.url.pathname).replace('/tangsel-tradelinktenant/', '/tangsel-tradelink/tenant/');
const canonicalUrl = new URL(canonicalPath.replace(/\/?$/, '/'), origin).href;
const imagePath = image
  ? (image.startsWith('http://') || image.startsWith('https://')
      ? image
      : image.startsWith(basePath)
        ? image
        : `${basePath}${image.replace(/^\//, '')}`)
  : undefined;
const imageUrl = imagePath ? new URL(imagePath, origin).href : undefined;
const normalizedStructuredData = structuredData && (Array.isArray(structuredData) ? structuredData : [structuredData]).map((entry) => (
  ['Organization', 'LocalBusiness'].includes(String(entry['@type'])) ? { ...entry, url: canonicalUrl } : entry
));
const structuredJson = normalizedStructuredData
  ? JSON.stringify(normalizedStructuredData).replace(/</g, '\\u003c')
  : undefined;

---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#0b1727" />
    {isTenantRoute && <link rel="stylesheet" href={mobileStyles} />}
    {isTenantRoute && <link rel="stylesheet" href={tenantStyles} />}
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Tangsel TradeLink" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    {imageUrl && <meta property="og:image" content={imageUrl} />}
    <meta name="twitter:card" content={imageUrl ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {imageUrl && <meta name="twitter:image" content={imageUrl} />}
    {structuredJson && <script type="application/ld+json" set:html={structuredJson} />}
    {isSvg && <link rel="icon" type="image/svg+xml" href={`${faviconPath}?v=3`} />}
    {isPng && <link rel="icon" type="image/png" href={`${faviconPath}?v=3`} />}
    {isIco && <link rel="icon" type="image/x-icon" href={`${faviconPath}?v=3`} />}
    {isWebp && <link rel="icon" type="image/webp" href={`${faviconPath}?v=3`} />}
    {!isSvg && !isPng && !isIco && !isWebp && <link rel="icon" href={`${faviconPath}?v=3`} />}
    {pngFallback !== faviconPath && (
      <link rel="alternate icon" type="image/png" href={`${pngFallback}?v=3`} />
    )}
    <link rel="apple-touch-icon" href={`${pngFallback}?v=3`} />
  </head>
  <body data-theme={theme}>
    <a class="skip-link" href="#main-content">Lewati ke konten utama</a>
    {Astro.url.pathname.includes('/tenant/') && <nav class="tenant-return" aria-label="Kembali ke direktori"><a href={`${basePath}directory/`}>← All businesses</a></nav>}
    <div id="main-content" tabindex="-1"><slot /></div>
  </body>
</html>

<style is:global>
  .skip-link{position:fixed;top:8px;left:8px;z-index:9999;padding:14px 18px;background:#fff;color:#102033;transform:translateY(-180%);font-weight:700}
  .skip-link:focus{transform:none;outline:3px solid #0d766e}
  .tenant-return{background:#f3efe8;color:#172018;padding:0 24px;border-bottom:1px solid #ccc8c0}
  .tenant-return a{display:inline-flex;align-items:center;min-height:48px;font:700 .8rem/1.4 system-ui;text-underline-offset:4px}
  body:has(.smart-nfc)>.tenant-return,body:has(.adaptive-tenant)>.tenant-return{display:none}
  :root {
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    color: #102033;
    background: #edf3f8;
    font-synthesis: none;
    text-rendering: optimizeLegibility;
    -webkit-font-smoothing: antialiased;
    --page: #edf3f8;
    --surface: rgba(255,255,255,.88);
    --surface-strong: #ffffff;
    --ink: #102033;
    --muted: #667587;
    --line: rgba(16,32,51,.10);
    --accent: #0f6f7a;
    --accent-strong: #084f57;
    --accent-soft: #dceff0;
    --hero-a: #d6f0ee;
    --hero-b: #e4eef9;
    --shadow: 0 18px 50px rgba(19, 43, 70, .10);
  }

  body[data-theme='food'] { --accent:#b75b2a;--accent-strong:#7d3517;--accent-soft:#faeadf;--hero-a:#ffe4c8;--hero-b:#fff3d9; }
  body[data-theme='beauty'] { --accent:#8a5678;--accent-strong:#63364f;--accent-soft:#f4e7ef;--hero-a:#f9eaf2;--hero-b:#efeaf8; }
  body[data-theme='industrial'] { --accent:#315f80;--accent-strong:#1b3f59;--accent-soft:#e1ebf2;--hero-a:#dbe8ef;--hero-b:#e8edf0; }
  body[data-theme='editorial'] { --accent:#4b5f47;--accent-strong:#30402d;--accent-soft:#e7ece1;--hero-a:#e8eadc;--hero-b:#f1ebe0; }

  * { box-sizing: border-box; }
  html { min-width: 320px; background: var(--page); }
  body { margin: 0; min-height: 100vh; color: var(--ink); background: var(--page); }
  button, input, select { font: inherit; }
  a { color: inherit; }
  img { display: block; max-width: 100%; }
  .shell { width: min(100% - 28px, 760px); margin-inline: auto; }
  .eyebrow { margin:0 0 8px;font-size:.74rem;font-weight:800;letter-spacing:.12em;text-transform:uppercase;color:var(--accent-strong); }
  .pill { display:inline-flex;align-items:center;min-height:30px;padding:6px 10px;border:1px solid var(--line);border-radius:999px;background:rgba(255,255,255,.7);color:var(--muted);font-size:.82rem;font-weight:700; }
  .sr-only { position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0; }
  :focus-visible { outline-offset: 3px; }
</style>
