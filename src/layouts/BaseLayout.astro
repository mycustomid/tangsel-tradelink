---
import '../styles/mobile-nfc.css';

interface Props {
  title?: string;
  description?: string;
  theme?: string;
  favicon?: string;
  canonical?: string;
  image?: string;
  robots?: string;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title = 'Tangsel TradeLink',
  description = 'Direktori tenant Trade Expo Indonesia 2026 untuk akses cepat setelah tap NFC.',
  theme = 'default',
  favicon = 'data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>↗</text></svg>',
  canonical,
  image,
  robots = 'index,follow,max-image-preview:large',
  structuredData,
} = Astro.props;

const origin = Astro.site ?? new URL(Astro.url.origin);
const basePath = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const canonicalUrl = new URL(canonical || Astro.url.pathname, origin).href;
const imagePath = image
  ? (image.startsWith('http://') || image.startsWith('https://')
      ? image
      : image.startsWith(basePath)
        ? image
        : `${basePath}${image.replace(/^\//, '')}`)
  : undefined;
const imageUrl = imagePath ? new URL(imagePath, origin).href : undefined;
const structuredJson = structuredData
  ? JSON.stringify(structuredData).replace(/</g, '\\u003c')
  : undefined;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#0b1727" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href={favicon} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Tangsel TradeLink" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    {imageUrl && <meta property="og:image" content={imageUrl} />}
    <meta name="twitter:card" content={imageUrl ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {imageUrl && <meta name="twitter:image" content={imageUrl} />}
    {structuredJson && <script type="application/ld+json" set:html={structuredJson} />}
    <title>{title}</title>
  </head>
  <body data-theme={theme}>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    color: #102033;
    background: #edf3f8;
    font-synthesis: none;
    text-rendering: optimizeLegibility;
    -webkit-font-smoothing: antialiased;
    --page: #edf3f8;
    --surface: rgba(255,255,255,.88);
    --surface-strong: #ffffff;
    --ink: #102033;
    --muted: #667587;
    --line: rgba(16,32,51,.10);
    --accent: #0f6f7a;
    --accent-strong: #084f57;
    --accent-soft: #dceff0;
    --hero-a: #d6f0ee;
    --hero-b: #e4eef9;
    --shadow: 0 18px 50px rgba(19, 43, 70, .10);
  }

  body[data-theme='food'] { --accent:#b75b2a;--accent-strong:#7d3517;--accent-soft:#faeadf;--hero-a:#ffe4c8;--hero-b:#fff3d9; }
  body[data-theme='beauty'] { --accent:#8a5678;--accent-strong:#63364f;--accent-soft:#f4e7ef;--hero-a:#f9eaf2;--hero-b:#efeaf8; }
  body[data-theme='industrial'] { --accent:#315f80;--accent-strong:#1b3f59;--accent-soft:#e1ebf2;--hero-a:#dbe8ef;--hero-b:#e8edf0; }
  body[data-theme='editorial'] { --accent:#4b5f47;--accent-strong:#30402d;--accent-soft:#e7ece1;--hero-a:#e8eadc;--hero-b:#f1ebe0; }

  * { box-sizing: border-box; }
  html { min-width: 320px; background: var(--page); }
  body { margin: 0; min-height: 100vh; color: var(--ink); background: var(--page); }
  button, input, select { font: inherit; }
  a { color: inherit; }
  img { display: block; max-width: 100%; }
  .shell { width: min(100% - 28px, 760px); margin-inline: auto; }
  .eyebrow { margin:0 0 8px;font-size:.74rem;font-weight:800;letter-spacing:.12em;text-transform:uppercase;color:var(--accent-strong); }
  .pill { display:inline-flex;align-items:center;min-height:30px;padding:6px 10px;border:1px solid var(--line);border-radius:999px;background:rgba(255,255,255,.7);color:var(--muted);font-size:.82rem;font-weight:700; }
  .sr-only { position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0; }
  :focus-visible { outline-offset: 3px; }
</style>
